Cell[CellGroupData[{

Cell["Una peque\[NTilde]a comparaci\[OAcute]n con un paper.", "Subsubsection",
 CellChangeTimes->{{3.995625381012097*^9, 
  3.9956253938815823`*^9}},ExpressionUUID->"8b8ca949-e387-4844-aa1b-\
56517f09e575"],

Cell["\<\
El paper de Inui et al. da un valor te\[OAcute]rico para una red infinita, \
veamos que tanto se acerca a ese valor.\
\>", "Text",
 CellChangeTimes->{{3.994526290584606*^9, 
  3.994526330226779*^9}},ExpressionUUID->"35a1d31a-764f-4027-9c4c-\
62948b42a490"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"refVal", "=", 
   RowBox[{
    RowBox[{"1", "/", "2"}], "+", 
    RowBox[{"3", "/", 
     RowBox[{"Pi", "^", "2"}]}], "-", 
    RowBox[{"2", "/", "Pi"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"distVal", "=", 
   RowBox[{"Max", "[", "LimitCaseDat", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<El valor te\[OAcute]rico: \>\"", ",", "refVal", 
   ",", "\"\< = \>\"", ",", 
   RowBox[{"refVal", "//", "N"}], ",", "\"\<\\n Valor calculado: \>\"", ",", 
   "distVal", ",", "\"\<\\n Diferencia porcentual: \>\"", ",", 
   RowBox[{"100", "*", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"refVal", "-", "distVal"}], "]"}], "/", "refVal"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.994526331284934*^9, 3.994526363132728*^9}, {
  3.994526464162046*^9, 3.994526581287676*^9}, {3.9945266828680973`*^9, 
  3.994526726216579*^9}},
 CellLabel->
  "In[383]:=",ExpressionUUID->"b6639b81-5cc3-4ccd-a934-72310223cba2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Tmax", "=", "7000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
