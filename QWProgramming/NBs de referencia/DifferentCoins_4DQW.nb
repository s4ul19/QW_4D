Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"===", 
    RowBox[{"1.", " ", 
     RowBox[{"Geometr\[IAcute]a", ":", 
      RowBox[{"Cardioide", "==="}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"R", "=", "7"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"GridData", "=", 
     RowBox[{"GenerateCardioidBasis", "[", "R", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dim", "=", 
     RowBox[{"GridData", "[", "\"\<Dimension\>\"", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"S", "=", 
     RowBox[{"BuildShiftOperators", "[", 
      RowBox[{"GridData", ",", 
       RowBox[{"CoinDimension", "->", "4"}]}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "ajusta", " ", "el", " ", "nombre", " ", "si", " ", "en", " ", "tu", " ", 
     "librer\[IAcute]a", " ", "es", " ", 
     RowBox[{"BuildShiftOperators", "[", 
      RowBox[{"...", ",", 
       RowBox[{"CoinDimension", "->", "4"}]}], "]"}]}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"===", 
     RowBox[{"2.", " ", 
      RowBox[{"Moneda", ":", 
       RowBox[{
        RowBox[{"COE", " ", "como", " ", "l\[IAcute]nea", " ", "base"}], 
        "==="}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"c", "=", 
     RowBox[{
      RowBox[{"GeneralizedGroverCoin", "[", 
       RowBox[{"Pi", "/", "4."}], "]"}], "//", "N"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"CoinOp", "=", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"dim", ",", "SparseArray"}], "]"}], ",", 
       RowBox[{"c", "//", "SparseArray"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"EvolOp", "=", 
     RowBox[{"Chop", "[", 
      RowBox[{"S", ".", "CoinOp"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"===", 
     RowBox[{
     "3.", " ", "Proyecci\[OAcute]n", " ", "al", " ", "sector", " ", "Cs"}], 
     "==="}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"sector", "=", "\"\<Even\>\""}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"prueba", " ", "tambi\[EAcute]n", " ", "\"\<Odd\>\""}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"V1", "=", 
     RowBox[{"BuildSymmetryIsometry", "[", 
      RowBox[{"GridData", ",", "sector"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EvolOpSector", "=", 
     RowBox[{"Chop", "[", 
      RowBox[{
       RowBox[{"ConjugateTranspose", "[", 
        RowBox[{"Normal", "[", "V1", "]"}], "]"}], ".", 
       RowBox[{"Normal", "[", "EvolOp", "]"}], ".", 
       RowBox[{"Normal", "[", "V1", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Dimension total: \>\"", ",", 
     RowBox[{"EvolOp", "//", "Length"}], 
     ",", "\"\<\\n Dimension tomando el sector par: \>\"", ",", 
     RowBox[{"EvolOpSector", "//", "Length"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"UnitaryMatrixQ", "[", "EvolOpSector", "]"}]}]}]], "Input",
