      RowBox[{"HaarRandomState", "[", "4", "]"}], "//", "Normalize"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"States", "=", 
   RowBox[{"NestList", "[", 
