      RowBox[{"Normal", "[", "EvolOp", "]"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Histogram", "[", 
  RowBox[{"eigenphases", ",", "Automatic", ",", "\"\<PDF\>\"", ",", 
   RowBox[{"PlotTheme", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Detailed\>\"", ",", "\"\<Frame\>\"", 
      ",", "\"\<SansLabels\>\""}], "}"}]}], ",", 
   RowBox[{"LabelStyle", "->", "18"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[\"\[Phi]\", \
TraditionalForm], \"errors\" -> {}, \"input\" -> \"\\\\phi\", \"state\" -> \
\"Boxes\"|>,\"TeXAssistantTemplate\"]\)\>\"", ",", " ", "\"\<DOS\>\""}], 
     "}"}]}], ",", 
   RowBox[{"ImageSize", "->", "400"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PhasesWithoutFlatBands", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"eigenphases", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"10", "^", 
        RowBox[{"-", "5"}]}], "<", 
       RowBox[{"Abs", "[", "#", "]"}], "<", 
       RowBox[{"Pi", "-", 
        RowBox[{"10", "^", 
         RowBox[{"-", "5"}]}]}]}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"FilteredPhases", "=", 
