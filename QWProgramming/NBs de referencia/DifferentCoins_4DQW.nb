Cell[BoxData[{
 RowBox[{
  RowBox[{"steps", "=", "7000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FinalStates", "=", 
   RowBox[{"NestList", "[", 
