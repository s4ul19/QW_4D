Cell[CellGroupData[{

Cell["Spectral Statistic", "Subsection",
 CellChangeTimes->{{3.994505872875144*^9, 
  3.9945058767361107`*^9}},ExpressionUUID->"92c47df7-ce1c-41cb-95bb-\
78125bf87d93"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eigenphases", " ", "=", " ", 
   RowBox[{"Sort", "[", 
    RowBox[{"Arg", "[", 
     RowBox[{"Eigenvalues", "[", 
      RowBox[{"Normal", "[", "EvolOp", "]"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Histogram", "[", 
  RowBox[{"eigenphases", ",", "Automatic", ",", "\"\<PDF\>\"", ",", 
   RowBox[{"PlotTheme", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Detailed\>\"", ",", "\"\<Frame\>\"", 
      ",", "\"\<SansLabels\>\""}], "}"}]}], ",", 
   RowBox[{"LabelStyle", "->", "18"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[\"\[Phi]\", \
TraditionalForm], \"errors\" -> {}, \"input\" -> \"\\\\phi\", \"state\" -> \
\"Boxes\"|>,\"TeXAssistantTemplate\"]\)\>\"", ",", " ", "\"\<DOS\>\""}], 
     "}"}]}], ",", 
   RowBox[{"ImageSize", "->", "400"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.995706069262959*^9, 3.995706069718766*^9}},
 CellLabel->
  "In[213]:=",ExpressionUUID->"635e3bb4-060b-4eed-84b9-369cd015d99c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"UnfoldedDat", "=", 
   RowBox[{
    RowBox[{"Unfold", "[", 
     RowBox[{"eigenphases", "//", "Sort"}], "]"}], 
    "[", "\"\<UnfoldedLevels\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"spacings", "=", 
   RowBox[{"Differences", "[", 
    RowBox[{
     RowBox[{"UnfoldedDat", "//", "Sort"}], ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EnsemblesList", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Poisson\>\"", ",", "\"\<GOE/COE\>\"", 
     ",", "\"\<GUE/CUE\>\""}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"BetaValues", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 

 RowBox[{
  RowBox[{
   RowBox[{"PlotColors", "=", 
    RowBox[{"{", 
     RowBox[{"Black", ",", "Red", ",", "Blue"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"TheoreticalCurves", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"Evaluate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"LevelSpacingDistribution", "[", 
          RowBox[{"SVar", ",", "#"}], "]"}], "&"}], "/@", "BetaValues"}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"SVar", ",", "0", ",", "4"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"Thickness", "[", "0.006", "]"}], ",", "#"}], "]"}], 
          "&"}], "/@", "PlotColors"}], ")"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"LineLegend", "[", 
          RowBox[{"PlotColors", ",", "EnsemblesList", ",", 
           RowBox[{"LegendFunction", "->", "\"\<Frame\>\""}], ",", 
           RowBox[{"LabelStyle", "->", "16"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"0.8", ",", "0.75"}], "}"}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"  ", 
  RowBox[{
   RowBox[{"EmpiricalHistogram", "=", 
    RowBox[{"Histogram", "[", 
     RowBox[{
     "spacings", ",", " ", "\"\<FreedmanDiaconis\>\"", ",", " ", "\"\<PDF\>\"",
       ",", "  ", "\n", "        ", 
      RowBox[{"PlotRange", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "4"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}], ",", " ", "\n", 
      "        ", 
      RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", "\n", "        ", 
      RowBox[{"FrameLabel", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<s\>\"", ",", " ", "\"\<P(s)\>\""}], "}"}]}], ",", "\n", 
      "        ", 
      RowBox[{"ImageSize", "->", "500"}], ",", "\n", "        ", 
      RowBox[{"LabelStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", " ", "24"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"6.", " ", "Combine", " ", "and", " ", "display"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"EmpiricalHistogram", ",", "TheoreticalCurves"}], "]"}]}], "Input",
 CellChangeTimes->{{3.995675143571279*^9, 3.9956751447111883`*^9}, {
  3.995705245332163*^9, 3.9957052481171017`*^9}},
