  RowBox[{"Lx", "=", "100"}], ";", 
  RowBox[{"Ly", "=", "70"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GrvAngle", "=", 
   RowBox[{"Pi", "/", "4."}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GridData", "=", 
   RowBox[{"GenerateRectangleBasis", "[", 
    RowBox[{"Lx", ",", "Ly"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
