Cell[BoxData[{
 RowBox[{
  RowBox[{"Tmax", "=", "400"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"InitState", "=", 
   RowBox[{"LocalizedState", "[", 
    RowBox[{"GridData", ",", 
     RowBox[{"{", 
      RowBox[{"17", ",", "10"}], "}"}], ",", 
