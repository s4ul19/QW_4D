     " ", "caminata", " ", "con", " ", "la", " ", "imagen", " ", "fija"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Usamos", " ", "GraphicsColumn", " ", "para", " ", "apilarlos", " ", 
     "verticalmente"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"framesFinales", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"GraphicsColumn", "[", 
        RowBox[{
