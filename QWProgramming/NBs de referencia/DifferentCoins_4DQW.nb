Cell[CellGroupData[{

Cell["Una peque\[NTilde]a comparaci\[OAcute]n con un paper.", "Subsubsection",
 CellChangeTimes->{{3.995625381012097*^9, 
  3.9956253938815823`*^9}},ExpressionUUID->"701a3682-2e3b-46f0-b4dc-\
28f99b5393c2"],

Cell["\<\
El paper de Inui et al. da un valor te\[OAcute]rico para una red infinita, \
veamos que tanto se acerca a ese valor.\
\>", "Text",
 CellChangeTimes->{{3.994526290584606*^9, 
  3.994526330226779*^9}},ExpressionUUID->"2de214eb-0c78-4f09-a3a2-\
bb7e9c8a0471"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"refVal", "=", 
   RowBox[{
    RowBox[{"1", "/", "2"}], "+", 
    RowBox[{"3", "/", 
     RowBox[{"Pi", "^", "2"}]}], "-", 
    RowBox[{"2", "/", "Pi"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"distVal", "=", 
   RowBox[{"Max", "[", "LimitCaseDat", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<El valor te\[OAcute]rico: \>\"", ",", "refVal", 
   ",", "\"\< = \>\"", ",", 
   RowBox[{"refVal", "//", "N"}], ",", "\"\<\\n Valor calculado: \>\"", ",", 
   "distVal", ",", "\"\<\\n Diferencia porcentual: \>\"", ",", 
   RowBox[{"100", "*", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"refVal", "-", "distVal"}], "]"}], "/", "refVal"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.994526331284934*^9, 3.994526363132728*^9}, {
  3.994526464162046*^9, 3.994526581287676*^9}, {3.9945266828680973`*^9, 
  3.994526726216579*^9}},
 CellLabel->
  "In[383]:=",ExpressionUUID->"f7326249-16b1-4eaf-afa6-a9576dbe6992"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Tmax", "=", "7000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"steps", "=", "200"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Frames", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"DiscreteProbabilityPlot", "[", 
      RowBox[{"GridData", ",", 
       RowBox[{"LimitDistribution", "[", 
        RowBox[{
         RowBox[{"NestList", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"EvolOp", ".", "#"}], "&"}], ",", "InitState", ",", "#"}],
           "]"}], ",", "4"}], "]"}], ",", 
       RowBox[{"\"\<ProbabilityScale\>\"", "->", "\"\<Linear\>\""}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<Quantum Walk Limit Distribution\>\""}],
        ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}], "&"}], "/@", 
    RowBox[{"Range", "[", 
     RowBox[{"1", ",", "Tmax", ",", "steps"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListAnimate", "[", 
  RowBox[{"Frames", ",", 
   RowBox[{"AnimationRunning", "->", "True"}], ",", 
   RowBox[{"AnimationRate", "->", "1.5"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9945238843291483`*^9, 3.994523967002358*^9}, {
  3.994524010247048*^9, 3.994524083310792*^9}, {3.994524129262998*^9, 
