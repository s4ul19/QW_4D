Cell[BoxData[{
 RowBox[{
  RowBox[{"Lx", "=", "70"}], ";", 
  RowBox[{"Ly", "=", "50"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GrvAngle", "=", 
   RowBox[{"Pi", "/", "4."}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GridData", "=", 
   RowBox[{"GenerateEllipseBasis", "[", 
    RowBox[{"Lx", ",", "Ly"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dim", "=", 
   RowBox[{"GridData", "[", "\"\<Dimension\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{"BuildShiftOperators", "[", 
    RowBox[{"GridData", ",", 
     RowBox[{"CoinDimension", "->", "4"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "=", 
   RowBox[{"GeneralizedGroverCoin", "[", "GrvAngle", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CoinOp", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", 
      RowBox[{"dim", ",", "SparseArray"}], "]"}], ",", 
     RowBox[{"c", "//", "SparseArray"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EvolOp", "=", 
   RowBox[{"S", ".", "CoinOp"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Dimension del operador evoluci\[OAcute]n: \>\"", ",", 
   RowBox[{"EvolOp", "//", "Length"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Img", "=", 
