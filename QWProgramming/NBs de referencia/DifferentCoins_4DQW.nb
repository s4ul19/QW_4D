   RowBox[{"(*", 
    RowBox[{"3.", " ", "Exportaci\[OAcute]n", " ", "final"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Export", "[", 
    RowBox[{"\"\</Users/saul/Desktop/QWPics/4D/LimitDistributionvsEvol_Sinai_\
Haar.mp4\>\"", ",", "framesFinales", ",", 
