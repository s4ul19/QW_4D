Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Aseguramos", " ", "que", " ", "la", " ", "imagen", " ", "fija",
     " ", "tenga", " ", "el", " ", "mismo", " ", "formato", " ", "de", " ", 
    "renderizado"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"imgFijaRaster", "=", 
     RowBox[{"Rasterize", "[", 
      RowBox[{"ImgD", ",", 
       RowBox[{"RasterSize", "->", "600"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Combinamos", " ", "cada", " ", "frame", " ", "de", " ", "la", 
     " ", "caminata", " ", "con", " ", "la", " ", "imagen", " ", "fija"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Usamos", " ", "GraphicsColumn", " ", "para", " ", "apilarlos", " ", 
     "verticalmente"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"framesFinales", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"GraphicsColumn", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Frames", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", "imgFijaRaster"}], "}"}], ",", 
         RowBox[{"Alignment", "->", "Center"}], ",", 
         RowBox[{"Spacings", "->", "10"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "Frames", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Exportaci\[OAcute]n", " ", "final"}], "*)"}], "\n", 
   RowBox[{"Export", "[", 
    RowBox[{"\"\</Users/saul/Desktop/QWPics/4D/LimitDistributionvsEvol_Rect_\
RndCoin.mp4\>\"", ",", "framesFinales", ",", 
     RowBox[{"\"\<FrameRate\>\"", "->", "30"}]}], "]"}]}]}]], "Input",
