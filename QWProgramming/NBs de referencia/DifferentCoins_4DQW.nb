Cell[BoxData[{
 RowBox[{
  RowBox[{"tmax", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DimSpace", "=", 
   RowBox[{"Length", "[", "eigenphases", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"TimeList", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"1", ",", 
     RowBox[{"tmax", "*", "DimSpace"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"TauList", "=", 
    RowBox[{"TimeList", "/", "DimSpace"}]}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{
   "2.", " ", "C\[AAcute]lculo", " ", "del", " ", "SFF", " ", "Crudo", " ", 
    RowBox[{"(", "Normalizado", ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SffRaw", "=", 
    RowBox[{
     RowBox[{"SpectralFormFactor", "[", 
      RowBox[{"eigenphases", ",", "TimeList"}], "]"}], "/", "DimSpace"}]}], 
   ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "3.", " ", "Suavizado", " ", "\[OAcute]ptimo", " ", "para", " ", "DTQWs", " ", 
    RowBox[{"(", 
     RowBox[{"Ventana", " ", "Par"}], ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"windowSize", "=", "150"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SffSmoothedScaled", "=", 
    RowBox[{"TimeAveragedSFF", "[", 
     RowBox[{"TauList", ",", "SffRaw", ",", "windowSize"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "4.", " ", "Visualizaci\[OAcute]n", " ", "de", " ", "alta", " ", "calidad",
     " ", "con", " ", "MaTeX"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Img", "=", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"ListPlot", "[", 
     RowBox[{"SffSmoothedScaled", ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{"All", ",", "Automatic"}], "}"}]}], ",", 
      RowBox[{"Joined", "->", "True"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Thick", ",", "DarkBlue"}], "]"}]}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"MaTeX", "/@", 
        RowBox[{"{", 
         RowBox[{"\"\<\\\\tau = t/N\>\"", ",", "\"\<K(\\\\tau)\>\""}], 
         "}"}]}]}], ",", 
      RowBox[{"PlotLabel", "->", 
       RowBox[{"MaTeX", "[", "\"\<\\\\text{Discrete SFF }\>\"", "]"}]}], ",", 
      
      RowBox[{"BaseStyle", "->", 
       RowBox[{"{", 
        RowBox[{"FontFamily", "->", "\"\<Latin Modern Roman\>\""}], "}"}]}]}],
      "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"SpectralFormFactorRMT", "[", 
       RowBox[{"\[Tau]", ",", "1"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Tau]", ",", "0", ",", "tmax"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "Dashed", ",", "Thick"}], "]"}]}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{"All", ",", "Automatic"}], "}"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"MaTeX", "[", "\"\<\\\\text{GOE}\>\"", "]"}], "}"}], ",", 
