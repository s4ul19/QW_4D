Cell[BoxData[{
 RowBox[{
  RowBox[{"Lx", "=", "150"}], ";", 
  RowBox[{"Ly", "=", "130"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GrvAngle", "=", 
   RowBox[{"Pi", "/", "4."}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GridData", "=", 
   RowBox[{"GenerateSinaiBasis", "[", 
    RowBox[{"Lx", ",", "Ly"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dim", "=", 
   RowBox[{"GridData", "[", "\"\<Dimension\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{"BuildShiftOperators", "[", 
    RowBox[{"GridData", ",", 
     RowBox[{"CoinDimension", "->", "4"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "=", 
   RowBox[{"GeneralizedHadamardCoin", "[", "GrvAngle", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CoinOp", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", 
