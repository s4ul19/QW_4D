Cell[CellGroupData[{

Cell["Funciones", "Chapter",
 CellChangeTimes->{{3.994240074903152*^9, 
  3.994240076102264*^9}},ExpressionUUID->"c411ec9d-75b9-4051-b21d-\
ea24f9b3c7e2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"LimitDistribution", "[", 
     RowBox[{"TimeStatesList_List", ",", "CoinDim_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "MeanProbabilities", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"MeanProbabilities", "=", 
        RowBox[{"Mean", "[", 
         RowBox[{
          RowBox[{"Abs", "[", "TimeStatesList", "]"}], "^", "2"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"Partition", "[", 
          RowBox[{"MeanProbabilities", ",", "CoinDim"}], "]"}], ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "DiscreteProbabilityPlot", "]"}], "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Options", "[", "ArrayPlot", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<ProbabilityScale\>\"", "->", "\"\<Linear\>\""}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DiscreteProbabilityPlot", "[", 
    RowBox[{"GridData_Association", ",", "Probabilities_List", ",", 
     RowBox[{"Opts", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "Coords", ",", "MinX", ",", "MaxX", ",", "MinY", ",", "MaxY", ",", 
       "NumRows", ",", "NumCols", ",", "SparseRules", ",", 
       "BoundingBoxMatrix", ",", "ScaleOption", ",", 
       "ProcessedProbabilities"}], "}"}], ",", 
     RowBox[{
      RowBox[{"Coords", "=", 
       RowBox[{"GridData", "[", "\"\<Coords\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ScaleOption", "=", 
       RowBox[{"OptionValue", "[", "\"\<ProbabilityScale\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Transform", " ", "probabilities", " ", "based", " ", "on", " ", "the",
         " ", "selected", " ", "scale", " ", "option"}], "*)"}], 
      RowBox[{"ProcessedProbabilities", "=", 
       RowBox[{"Switch", "[", 
        RowBox[{
        "ScaleOption", ",", "\"\<Linear\>\"", ",", "Probabilities", 
         ",", "\"\<Squared\>\"", ",", 
         RowBox[{"Probabilities", "^", "2"}], ",", "\"\<Log\>\"", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Log10", "[", 
            RowBox[{"Max", "[", 
             RowBox[{"#", ",", 
              RowBox[{"10", "^", 
               RowBox[{"-", "12"}]}]}], "]"}], "]"}], "&"}], "/@", 
          "Probabilities"}], ",", "_", ",", "Probabilities"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"MinX", ",", "MaxX"}], "}"}], "=", 
       RowBox[{"MinMax", "[", 
        RowBox[{"Coords", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"MinY", ",", "MaxY"}], "}"}], "=", 
       RowBox[{"MinMax", "[", 
        RowBox[{"Coords", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"NumCols", "=", 
       RowBox[{"MaxX", "-", "MinX", "+", "1"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"NumRows", "=", 
       RowBox[{"MaxY", "-", "MinY", "+", "1"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"(*", 
       RowBox[{
       "Map", " ", "coordinates", " ", "to", " ", "matrix", " ", "indices"}], 
       "*)"}], 
      RowBox[{"SparseRules", "=", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"#1", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "-", "MinY", "+", "1"}], ",", 
             RowBox[{
              RowBox[{"#1", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "-", "MinX", "+", "1"}]}], 
            "}"}], "->", "#2"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{"Coords", ",", "ProcessedProbabilities"}], "}"}]}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"BoundingBoxMatrix", "=", 
       RowBox[{"Normal", "[", 
        RowBox[{"SparseArray", "[", 
         RowBox[{"SparseRules", ",", 
          RowBox[{"{", 
           RowBox[{"NumRows", ",", "NumCols"}], "}"}], ",", 
          RowBox[{"Missing", "[", "]"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ArrayPlot", "[", 
       RowBox[{"BoundingBoxMatrix", ",", 
        RowBox[{"DataReversed", "->", "True"}], ",", 
        RowBox[{"ColorFunction", "->", "\"\<SunsetColors\>\""}], ",", 
        RowBox[{"ColorFunctionScaling", "->", "True"}], ",", 
        RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"FrameTicks", "->", "Automatic"}], ",", 
        RowBox[{"Mesh", "->", "All"}], ",", 
        RowBox[{"MeshStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{"Opacity", "[", "0.15", "]"}], ",", "Gray"}], "]"}]}], ",", 
        RowBox[{"Sequence", "@@", 
         RowBox[{"FilterRules", "[", 
          RowBox[{
           RowBox[{"{", "Opts", "}"}], ",", 
           RowBox[{"Options", "[", "ArrayPlot", "]"}]}], "]"}]}]}], "]"}]}]}],
     "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.994209277883322*^9, 3.9942092787984*^9}, {
  3.994209558168812*^9, 3.994209572726741*^9}, {3.994209691968336*^9, 
  3.994209702709043*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"f973d73a-1cfc-401f-bc93-41fdf4701972"],

Cell["\<\
Se estudiaran distintos operadores de moneda aplicadas al shift condicional \
que contempla condiciones de frontera. 
Las condiciones de frontera se establecen seg\[UAcute]n el tipo de estadio a \
trabajar.
El 1/8 de Sinai resulta un buen caso para estudiar un caso integrable, R = 0, \
asi como un caso ca\[OAcute]tico, R  >> 0\
\>", "Text",
 CellChangeTimes->{{3.994504157737597*^9, 3.994504206259413*^9}, {
  3.994504239576498*^9, 
  3.994504299110256*^9}},ExpressionUUID->"fb18c03e-db1d-48b8-a775-\
d8fcffab2086"]
}, Open  ]],

