Cell[BoxData[{
 RowBox[{
  RowBox[{"Tmax", "=", "400"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"InitState", "=", 
   RowBox[{"LocalizedState", "[", 
    RowBox[{"GridData", ",", 
     RowBox[{"{", 
      RowBox[{"17", ",", "10"}], "}"}], ",", 
     RowBox[{
      RowBox[{"HaarRandomState", "[", "4", "]"}], "//", "Normalize"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"States", "=", 
   RowBox[{"NestList", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"EvolOp", ".", "#"}], "&"}], ",", "InitState", ",", "Tmax"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TimeList", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"1", ",", "Tmax", ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"IPRDataRect", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"#", "-", "1"}], ",", 
       RowBox[{"ComputeSpatialIPR", "[", 
        RowBox[{
         RowBox[{"States", "[", 
          RowBox[{"[", "#", "]"}], "]"}], ",", "4"}], "]"}]}], "}"}], "&"}], "/@",
     "TimeList"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"EvenRect", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"IPRDataRect", ",", 
     RowBox[{
      RowBox[{"EvenQ", "[", 
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}], "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"OddRect", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"IPRDataRect", ",", 
     RowBox[{
      RowBox[{"OddQ", "[", 
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}], "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Img", "=", 
  RowBox[{"ListPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"EvenRect", ",", "OddRect"}], "}"}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "All"}], "}"}], ",", "Automatic"}], "}"}]}], ",", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Tiempos pares\>\"", ",", "\"\<Tiempos impares\>\""}], 
      "}"}]}], ",", 
    RowBox[{"LabelStyle", "->", 
     RowBox[{"Directive", "[", 
      RowBox[{"Bold", ",", " ", "15"}], "]"}]}], ",", 
    RowBox[{"Joined", "->", 
     RowBox[{"{", 
      RowBox[{"True", ",", "True"}], "}"}]}], ",", 
    RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.99581737701488*^9, 
  3.995817378547089*^9}},ExpressionUUID->"eddadb4f-82f7-4a79-9089-\
68ff7b40988b"]
