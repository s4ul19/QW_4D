       RowBox[{"UnitStep", "[", 
        RowBox[{
         RowBox[{"Differences", "[", "PhasesWithoutFlatBands", "]"}], "-", 
         RowBox[{"10", "^", 
          RowBox[{"-", "8"}]}]}], "]"}], ",", "1"}], "]"}], ",", "1"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Img", "=", 
