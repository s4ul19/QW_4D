Cell[CellGroupData[{

Cell["Visualizaci\[OAcute]n", "Subsection",
 CellChangeTimes->{{3.994504459925007*^9, 
  3.994504462276413*^9}},ExpressionUUID->"d1401648-e63a-458c-a95c-\
daf80ae15877"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"InitState", "=", 
   RowBox[{"LocalizedState", "[", 
    RowBox[{"GridData", ",", 
     RowBox[{"{", 
      RowBox[{"31", ",", "30"}], "}"}], ",", 
     RowBox[{
      RowBox[{"HaarRandomState", "[", "4", "]"}], "//", "Normalize"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Steps", "=", "80"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"States", "=", 
    RowBox[{"NestList", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"EvolOp", ".", "#"}], "&"}], ",", "InitState", ",", "Steps"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Frames", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Rasterize", "[", 
      RowBox[{
       RowBox[{"VisualizeWalkerState", "[", 
        RowBox[{
        "GridData", ",", "#", ",", "\"\<Linear\>\"", ",", "Automatic"}], 
        "]"}], ",", 
       RowBox[{"RasterSize", "->", "600"}]}], "]"}], "&"}], "/@", 
    "States"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Frames", "[", 
    RowBox[{"[", "x", "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "1", ",", 
     RowBox[{"States", "//", "Length"}], ",", "1"}], "}"}], ",", 
   RowBox[{"AutoAction", "->", "True"}]}], "]"}]}], "Input",
 CellChangeTimes->CompressedData["
