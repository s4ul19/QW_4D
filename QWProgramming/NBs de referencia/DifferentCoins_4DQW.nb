Cell[BoxData[{
 RowBox[{
  RowBox[{"UnfoldedDat", "=", 
   RowBox[{
    RowBox[{"Unfold", "[", 
     RowBox[{"FilteredPhases", "//", "Sort"}], "]"}], 
    "[", "\"\<UnfoldedLevels\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"spacings", "=", 
   RowBox[{"Differences", "[", 
    RowBox[{
     RowBox[{"UnfoldedDat", "//", "Sort"}], ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EnsemblesList", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Poisson\>\"", ",", "\"\<GOE/COE\>\"", 
     ",", "\"\<GUE/CUE\>\""}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"BetaValues", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "2"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PlotColors", "=", 
   RowBox[{"{", 
    RowBox[{"Black", ",", "Red", ",", "Blue"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"TheoreticalCurves", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"LevelSpacingDistribution", "[", 
         RowBox[{"SVar", ",", "#"}], "]"}], "&"}], "/@", "BetaValues"}], 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"SVar", ",", "0", ",", "4"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"(", 
