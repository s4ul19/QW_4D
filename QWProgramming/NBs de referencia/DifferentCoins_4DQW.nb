Cell["GENERAR LA MONEDA", "Text",
 CellChangeTimes->{{3.995705487440097*^9, 
  3.9957054942245617`*^9}},ExpressionUUID->"c370cdd8-9e88-41e1-9872-\
2de34f456441"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"c", "=", 
   RowBox[{"RandomVariate", "[", 
    RowBox[{"CircularOrthogonalMatrixDistribution", "[", "4", "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Chop", "[", 
   RowBox[{
    RowBox[{"ConjugateTranspose", "[", "c", "]"}], ".", "c"}], "]"}], "//", 
  "MatrixForm"}]}], "Input",
 CellChangeTimes->{{3.995705263445531*^9, 3.995705289405514*^9}, {
  3.995705481718947*^9, 3.995705483049708*^9}},
