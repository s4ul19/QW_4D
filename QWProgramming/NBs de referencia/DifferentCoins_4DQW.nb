Cell[CellGroupData[{

Cell["\<\
Promediando sobre varios estados iniciales de moneda aleatorios\
\>", "Subsubsection",
 CellChangeTimes->{{3.996844822656304*^9, 
  3.99684484839931*^9}},ExpressionUUID->"cbe7e389-93d7-46bc-8975-\
aa21211d9787"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IPRTotal", "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InitState", "=", 
        RowBox[{"LocalizedState", "[", 
         RowBox[{"GridData", ",", 
          RowBox[{"{", 
           RowBox[{"20", ",", "20"}], "}"}], ",", 
          RowBox[{
           RowBox[{"HaarRandomState", "[", "4", "]"}], "//", "Normalize"}]}], 
         "]"}]}], ",", 
       RowBox[{"Steps", "=", "100"}], ",", "States", ",", "Ipr"}], "}"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"States", "=", 
       RowBox[{"NestList", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"EvolOp", ".", "#"}], "&"}], ",", "InitState", ",", 
         "Steps"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"IprDat", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"ComputeSpatialIPR", "[", 
          RowBox[{"#", ",", "4"}], "]"}], "&"}], "/@", "States"}]}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996844866235161*^9, 3.996844873502667*^9}, {
  3.9968449390028*^9, 3.996845084191057*^9}, {3.99684511660709*^9, 
  3.996845123428236*^9}},ExpressionUUID->"d05cffbf-584b-4eba-87c9-\
b2e46bfca8d8"],

