Cell["Grover Coin", "Chapter",
 CellChangeTimes->{{3.994504132556793*^9, 
  3.994504143993808*^9}},ExpressionUUID->"9170a6e2-c010-44fd-b6a9-\
4374f8f68896"],

Cell[CellGroupData[{

Cell["Rectangle", "Section",
 CellChangeTimes->{{3.994506460289093*^9, 3.994506462367581*^9}, {
  3.994527605736979*^9, 3.9945276068190947`*^9}, {3.995624502227499*^9, 
  3.995624506133314*^9}},ExpressionUUID->"16071d24-1332-47d4-a670-\
105f9b23996b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Lx", "=", "50"}], ";", 
  RowBox[{"Ly", "=", "50"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GrvAngle", "=", 
   RowBox[{"Pi", "/", "4."}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GridData", "=", 
   RowBox[{"GenerateRectangleBasis", "[", 
    RowBox[{"Lx", ",", "Ly"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dim", "=", 
   RowBox[{"GridData", "[", "\"\<Dimension\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{"BuildShiftOperators", "[", 
    RowBox[{"GridData", ",", 
     RowBox[{"CoinDimension", "->", "4"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "=", 
   RowBox[{"GeneralizedGroverCoin", "[", "GrvAngle", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CoinOp", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", 
      RowBox[{"dim", ",", "SparseArray"}], "]"}], ",", 
     RowBox[{"c", "//", "SparseArray"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EvolOp", "=", 
   RowBox[{"S", ".", "CoinOp"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Dimension del operador evoluci\[OAcute]n: \>\"", ",", 
   RowBox[{"EvolOp", "//", "Length"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Img", "=", 
  RowBox[{"ListPlot", "[", 
   RowBox[{"GridData", "[", "\"\<Coords\>\"", "]"}], 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
