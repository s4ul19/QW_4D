Cell[CellGroupData[{

Cell["Spectral Statistic", "Subsection",
 CellChangeTimes->{{3.994505872875144*^9, 
  3.9945058767361107`*^9}},ExpressionUUID->"12a2ef62-5d4d-46f3-b0ed-\
7b3593a479fe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eigenphases", " ", "=", " ", 
   RowBox[{"Sort", "[", 
    RowBox[{"Arg", "[", 
     RowBox[{"Eigenvalues", "[", 
      RowBox[{"Normal", "[", "EvolOp", "]"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Img", "=", 
  RowBox[{"Histogram", "[", 
   RowBox[{"eigenphases", ",", "Automatic", ",", "\"\<PDF\>\"", ",", 
    RowBox[{"PlotTheme", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Detailed\>\"", ",", "\"\<Frame\>\"", 
       ",", "\"\<SansLabels\>\""}], "}"}]}], ",", 
    RowBox[{"LabelStyle", "->", "18"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[\"\[Phi]\", \
TraditionalForm], \"errors\" -> {}, \"input\" -> \"\\\\phi\", \"state\" -> \
\"Boxes\"|>,\"TeXAssistantTemplate\"]\)\>\"", ",", " ", "\"\<DOS\>\""}], 
      "}"}]}], ",", 
    RowBox[{"ImageSize", "->", "400"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PhasesWithoutFlatBands", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"eigenphases", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"10", "^", 
        RowBox[{"-", "5"}]}], "<", 
       RowBox[{"Abs", "[", "#", "]"}], "<", 
       RowBox[{"Pi", "-", 
        RowBox[{"10", "^", 
         RowBox[{"-", "5"}]}]}]}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"FilteredPhases", "=", 
   RowBox[{"Pick", "[", 
    RowBox[{"PhasesWithoutFlatBands", ",", 
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"UnitStep", "[", 
        RowBox[{
         RowBox[{"Differences", "[", "PhasesWithoutFlatBands", "]"}], "-", 
         RowBox[{"10", "^", 
          RowBox[{"-", "8"}]}]}], "]"}], ",", "1"}], "]"}], ",", "1"}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.99597660607158*^9, 3.99597661639043*^9}},
 CellLabel->
  "In[218]:=",ExpressionUUID->"0f9b68e3-40a4-4ee2-9187-875f7d458b0e"],

