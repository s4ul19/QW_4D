      RowBox[{"HaarRandomState", "[", "4", "]"}], "//", "Normalize"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"States", "=", 
   RowBox[{"NestList", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"EvolOp", ".", "#"}], "&"}], ",", "InitState", ",", "Tmax"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TimeList", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"1", ",", "Tmax", ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
