      "        ", 
      RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", "\n", "        ", 
      RowBox[{"FrameLabel", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<s\>\"", ",", " ", "\"\<P(s)\>\""}], "}"}]}], ",", "\n", 
      "        ", 
      RowBox[{"ImageSize", "->", "500"}], ",", "\n", "        ", 
      RowBox[{"LabelStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", " ", "24"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", 
