         "}"}]}]}], ",", 
      RowBox[{"PlotLabel", "->", 
       RowBox[{"MaTeX", "[", "\"\<\\\\text{Discrete SFF }\>\"", "]"}]}], ",", 
      
      RowBox[{"BaseStyle", "->", 
       RowBox[{"{", 
        RowBox[{"FontFamily", "->", "\"\<Latin Modern Roman\>\""}], "}"}]}]}],
      "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"SpectralFormFactorRMT", "[", 
       RowBox[{"\[Tau]", ",", "1"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Tau]", ",", "0", ",", "tmax"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
