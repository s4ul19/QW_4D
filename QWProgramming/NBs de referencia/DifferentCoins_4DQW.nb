Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eigenphasesSector", "=", 
   RowBox[{"Sort", "[", 
    RowBox[{"Arg", "[", 
     RowBox[{"Eigenvalues", "[", "EvolOpSector", "]"}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"UnfoldedSector", "=", 
   RowBox[{
    RowBox[{"Unfold", "[", "eigenphasesSector", "]"}], 
    "[", "\"\<UnfoldedLevels\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"spacingsSector", "=", 
    RowBox[{"Differences", "[", 
     RowBox[{
      RowBox[{"UnfoldedSector", "//", "Sort"}], ",", "1"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EnsemblesList", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Poisson\>\"", ",", "\"\<GOE/COE\>\"", 
     ",", "\"\<GUE/CUE\>\""}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"BetaValues", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "2"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"PlotColors", "=", 
   RowBox[{"{", 
    RowBox[{"Black", ",", "Red", ",", "Blue"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"TheoreticalCurves", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"LevelSpacingDistribution", "[", 
         RowBox[{"SVar", ",", "#"}], "]"}], "&"}], "/@", "BetaValues"}], 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"SVar", ",", "0", ",", "4"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{"Thickness", "[", "0.006", "]"}], ",", "#"}], "]"}], "&"}],
         "/@", "PlotColors"}], ")"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"Placed", "[", 
       RowBox[{
        RowBox[{"LineLegend", "[", 
         RowBox[{"PlotColors", ",", "EnsemblesList", ",", 
          RowBox[{"LegendFunction", "->", "\"\<Frame\>\""}], ",", 
          RowBox[{"LabelStyle", "->", "16"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"0.8", ",", "0.75"}], "}"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"EmpiricalHistogramSector", "=", 
   RowBox[{"Histogram", "[", 
    RowBox[{
    "spacingsSector", ",", "\"\<FreedmanDiaconis\>\"", ",", "\"\<PDF\>\"", ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<s\>\"", ",", "\"\<P(s)\>\""}], "}"}]}], ",", 
     RowBox[{"ImageSize", "->", "500"}], ",", 
     RowBox[{"LabelStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", "24"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{"EmpiricalHistogramSector", ",", "TheoreticalCurves"}], 
  "]"}]}], "Input",
