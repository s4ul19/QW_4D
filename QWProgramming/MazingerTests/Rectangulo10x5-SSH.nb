Notebook[
 {Cell[CellGroupData[{Cell["Autovalores de U en un rectangulo de 10 x 5", 
      "Title", ExpressionUUID -> "a2bf4646-834a-4b81-8c99-4711c4dee126"], 
     Cell["Caminata cuantica en tiempo continuo. El kernel principal esta en \
el Mac; el calculo se ejecuta en nodo1 mediante Mazinger. Este ejemplo carga \
solo Rectangle.wl y CTQW.wl, sin instalar paclets ni guardar archivos en el \
cluster.", "Text", ExpressionUUID -> "eab26643-6f09-49ca-a6e8-b9634cc82416"], 
     Cell[CellGroupData[{Cell["Modelo", "Section", ExpressionUUID -> 
          "0f0b5302-fdac-4341-b727-4ea9d75b5a1a"], Cell["GenerateRectangleBas\
is[9, 4] incluye las coordenadas 0..9 y 0..4: 10 x 5 = 50 sitios. Con gamma = \
1, el paquete define H = A - D, donde A es la matriz de adyacencia y D la \
matriz diagonal de grados. Para tiempo t = 1 usamos U = Exp[-I H].", "Text", 
         ExpressionUUID -> "ace1b8d1-1d52-4f3b-8e91-bb0f6398120d"]}, Open]], 
     Cell[CellGroupData[{Cell["Calculo en nodo1", "Section", 
         ExpressionUUID -> "7e8b3250-f0b5-40cc-82d0-0de9fa437981"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{"resultadoRectangulo", " ", 
               "=", " ", RowBox[{"RemoteEvaluate", "[", RowBox[
                  {"\"ssh://robot\"", ",", " ", RowBox[{"RemoteEvaluate", 
                     "[", RowBox[{"\"ssh://nodo1\"", ",", " ", RowBox[
                        {"Module", "[", RowBox[{RowBox[{"{", RowBox[{"ruta", 
                          ",", " ", "base", ",", " ", "h", ",", " ", "u", 
                          ",", " ", "vals"}], "}"}], ",", " ", RowBox[
                          {RowBox[{"ruta", " ", "=", " ", RowBox[
                          {"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[
                          {"Replace", "[", RowBox[{RowBox[{"Environment", 
                          "[", "\"QW_PROJECT_ROOT\"", "]"}], ",", RowBox[
                          {RowBox[{"Except", "[", "_String", "]"}], 
                          "\[RuleDelayed]", RowBox[{"FileNameJoin", "[", 
                          RowBox[{"{", RowBox[{"$HomeDirectory", ",", 
                          "\"QW\""}], "}"}], "]"}]}]}], "]"}], ",", 
                          "\"JA_libs\"", ",", "\"QuantumWalks\""}], "}"}], 
                          "]"}]}], ";", " ", RowBox[{"BeginPackage", "[", 
                          "\"QuantumWalks`\"", "]"}], ";", " ", RowBox[
                          {"EndPackage", "[", "]"}], ";", " ", RowBox[{"Get", 
                          "[", RowBox[{"FileNameJoin", "[", RowBox[{"{", 
                          RowBox[{"ruta", ",", " ", "\"Billiards\"", ",", 
                          " ", "\"Rectangle.wl\""}], "}"}], "]"}], "]"}], 
                          ";", " ", RowBox[{"Get", "[", RowBox[
                          {"FileNameJoin", "[", RowBox[{"{", RowBox[{"ruta", 
                          ",", " ", "\"CTQW.wl\""}], "}"}], "]"}], "]"}], 
                          ";", " ", RowBox[{"base", " ", "=", " ", RowBox[
                          {"QuantumWalks`Billiards`GenerateRectangleBasis", 
                          "[", RowBox[{"9", ",", " ", "4"}], "]"}]}], ";", 
                          " ", RowBox[{"h", " ", "=", " ", RowBox[
                          {"QuantumWalks`CTQW`CTQWHamiltonian", "[", RowBox[
                          {"base", ",", " ", "1.0"}], "]"}]}], ";", " ", 
                          RowBox[{"u", " ", "=", " ", RowBox[{"MatrixExp", 
                          "[", RowBox[{RowBox[{"-", "I"}], " ", "h"}], 
                          "]"}]}], ";", " ", RowBox[{"vals", " ", "=", " ", 
                          RowBox[{"Eigenvalues", "[", "u", "]"}]}], ";", " ", 
                          RowBox[{"<|", RowBox[{RowBox[{"\"Nodo\"", " ", 
                          "->", " ", "$MachineName"}], ",", " ", RowBox[
                          {"\"Dimension\"", " ", "->", " ", RowBox[
                          {"Dimensions", "[", "u", "]"}]}], ",", " ", RowBox[
                          {"\"Autovalores\"", " ", "->", " ", "vals"}], ",", 
                          " ", RowBox[{"\"ErrorMaximoModulo\"", " ", "->", 
                          " ", RowBox[{"Max", "[", RowBox[{"Abs", "[", RowBox[
                          {RowBox[{"Abs", "[", "vals", "]"}], " ", "-", " ", 
                          "1"}], "]"}], "]"}]}]}], "|>"}]}]}], "]"}]}], 
                     "]"}]}], "]"}]}]], "Input", ExpressionUUID -> 
             "f30353b5-7aa7-4000-a772-0e522953d501"]}, Open]], 
        Cell["El resultado contiene los autovalores y una comprobacion de que \
U es unitario: cada autovalor debe tener modulo cercano a 1.", "Text", 
         ExpressionUUID -> "b50173a7-3305-4c74-9482-735a7fb4090a"]}, Open]], 
     Cell[CellGroupData[{Cell["Resumen", "Section", ExpressionUUID -> 
          "3dda5458-05be-4455-b548-12fe34e7ed0e"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{"{", RowBox[
                {RowBox[{"resultadoRectangulo", "[", "\"Nodo\"", "]"}], ",", 
                 " ", RowBox[{"resultadoRectangulo", "[", "\"Dimension\"", 
                   "]"}], ",", " ", RowBox[{"Length", "[", RowBox[
                    {"resultadoRectangulo", "[", "\"Autovalores\"", "]"}], 
                   "]"}], ",", " ", RowBox[{"resultadoRectangulo", "[", 
                   "\"ErrorMaximoModulo\"", "]"}]}], "}"}]], "Input", 
            ExpressionUUID -> "d4f6cf4e-6061-4e54-80ba-e96c7fdd1510"]}, 
          Open]], Cell["Resultado esperado: {\"nodo1\", {50, 50}, 50, un \
numero cercano a 10^-15}.", "Text", ExpressionUUID -> 
          "229882cb-4036-443e-84c0-8ae16c521ed2"]}, Open]], 
     Cell[CellGroupData[{Cell["Autovalores", "Section", 
         ExpressionUUID -> "befa0c35-ce54-4f73-8c1c-fed2991e097f"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{"resultadoRectangulo", "[", 
               "\"Autovalores\"", "]"}]], "Input", ExpressionUUID -> 
             "111b28e9-c32d-4c24-be38-9134e48da1cf"]}, Open]]}, Open]], 
     Cell[CellGroupData[{Cell["Grafica en el plano complejo", "Section", 
         ExpressionUUID -> "33648d82-46c3-4faa-883c-675b7657564d"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{"ComplexListPlot", "[", 
               RowBox[{RowBox[{"resultadoRectangulo", "[", "\"Autovalores\"", 
                   "]"}], ",", " ", RowBox[{"PlotRange", " ", "->", " ", 
                   "All"}], ",", " ", RowBox[{"AspectRatio", " ", "->", " ", 
                   "1"}]}], "]"}]], "Input", ExpressionUUID -> 
             "dc783961-1b46-4bf1-9f2f-ef4fc1b83762"]}, Open]], 
        Cell["Los puntos deben quedar sobre el circulo unitario. La grafica \
se dibuja en tu Mac con los 50 autovalores recibidos desde nodo1.", "Text", 
         ExpressionUUID -> "98d493a3-d8ee-496e-9294-45b346a0328c"]}, Open]]}, 
    Open]]}, Evaluator -> "Local", WindowSize -> {1470, 817}, 
 WindowMargins -> {{0, Automatic}, {Automatic, 0}}, 
 FrontEndVersion -> "15.0 for Mac OS X ARM (64-bit) (July 2, 2026)", 
 StyleDefinitions -> "Default.nb", ExpressionUUID -> 
  "614e5be0-1c34-4161-b52e-2a4c29d47d9d"]
