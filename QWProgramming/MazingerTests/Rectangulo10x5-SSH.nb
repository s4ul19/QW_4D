Notebook[{

Cell[CellGroupData[{
Cell["Autovalores de U en un rectangulo de 10 x 5", "Title",ExpressionUUID->"a2bf4646-834a-4b81-8c99-4711c4dee126"],

Cell["\<\
Caminata cuantica en tiempo continuo. El kernel principal esta en el Mac; el \
calculo se ejecuta en nodo1 mediante Mazinger. Este ejemplo carga solo \
Rectangle.wl y CTQW.wl, sin instalar paclets ni guardar archivos en el \
cluster.\
\>", "Text",ExpressionUUID->"eab26643-6f09-49ca-a6e8-b9634cc82416"],

Cell[CellGroupData[{

Cell["Modelo", "Section",ExpressionUUID->"0f0b5302-fdac-4341-b727-4ea9d75b5a1a"],

Cell["\<\
GenerateRectangleBasis[9, 4] incluye las coordenadas 0..9 y 0..4: 10 x 5 = 50 \
sitios. Con gamma = 1, el paquete define H = A - D, donde A es la matriz de \
adyacencia y D la matriz diagonal de grados. Para tiempo t = 1 usamos U = \
Exp[-I H].\
\>", "Text",ExpressionUUID->"ace1b8d1-1d52-4f3b-8e91-bb0f6398120d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Calculo en nodo1", "Section",ExpressionUUID->"7e8b3250-f0b5-40cc-82d0-0de9fa437981"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"resultadoRectangulo", " ", "=", " ", 
  RowBox[{"RemoteEvaluate", "[", 
   RowBox[{"\"\<ssh://robot\>\"", ",", " ", 
    RowBox[{"RemoteEvaluate", "[", 
     RowBox[{"\"\<ssh://nodo1\>\"", ",", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "ruta", ",", " ", "base", ",", " ", "h", ",", " ", "u", ",", " ", 
          "vals"}], "}"}], ",", " ", 
        RowBox[{
         RowBox[{
         "ruta", " ", "=", 
          " ", "\"\</home/saul/QW/JA_libs/QuantumWalks\>\""}], ";", " ", 
         RowBox[{"BeginPackage", "[", "\"\<QuantumWalks`\>\"", "]"}], ";", 
         " ", 
         RowBox[{"EndPackage", "[", "]"}], ";", " ", 
         RowBox[{"Get", "[", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
            "ruta", ",", " ", "\"\<Billiards\>\"", ",", 
             " ", "\"\<Rectangle.wl\>\""}], "}"}], "]"}], "]"}], ";", " ", 
         RowBox[{"Get", "[", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"ruta", ",", " ", "\"\<CTQW.wl\>\""}], "}"}], "]"}], 
          "]"}], ";", " ", 
         RowBox[{"base", " ", "=", " ", 
          RowBox[{"QuantumWalks`Billiards`GenerateRectangleBasis", "[", 
           RowBox[{"9", ",", " ", "4"}], "]"}]}], ";", " ", 
         RowBox[{"h", " ", "=", " ", 
          RowBox[{"QuantumWalks`CTQW`CTQWHamiltonian", "[", 
           RowBox[{"base", ",", " ", "1.0"}], "]"}]}], ";", " ", 
         RowBox[{"u", " ", "=", " ", 
          RowBox[{"MatrixExp", "[", 
           RowBox[{
            RowBox[{"-", "I"}], " ", "h"}], "]"}]}], ";", " ", 
         RowBox[{"vals", " ", "=", " ", 
          RowBox[{"Eigenvalues", "[", "u", "]"}]}], ";", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Nodo\>\"", " ", "->", " ", "$MachineName"}], ",", " ", 
           RowBox[{"\"\<Dimension\>\"", " ", "->", " ", 
            RowBox[{"Dimensions", "[", "u", "]"}]}], ",", " ", 
           RowBox[{"\"\<Autovalores\>\"", " ", "->", " ", "vals"}], ",", " ", 
           
           RowBox[{"\"\<ErrorMaximoModulo\>\"", " ", "->", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"Abs", "[", "vals", "]"}], " ", "-", " ", "1"}], "]"}],
              "]"}]}]}], "|>"}]}]}], "]"}]}], "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"f30353b5-7aa7-4000-a772-0e522953d501"],

