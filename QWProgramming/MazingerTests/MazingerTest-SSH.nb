Notebook[{Cell[CellGroupData[{Cell["Pruebas de Mazinger por SSH", "Title", 
      ExpressionUUID -> "73da62a9-63dd-4bb4-9b25-ba473c6a3594"], 
     Cell["Ejecutar las celdas en orden.", "Text", CellChangeTimes -> 
       {{3.999731666989441*^9, 3.999731670236801*^9}}, 
      ExpressionUUID -> "63bc60c9-8f17-4cb8-82ee-95f85983296f"], 
     Cell[CellGroupData[{Cell["1. Identifica el kernel principal", "Section", 
         ExpressionUUID -> "3c4ba661-a90f-4d33-9ad9-9315ffb44f8f"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{"{", RowBox[{"$MachineName", 
                 ",", " ", "$Version"}], "}"}]], "Input", ExpressionUUID -> 
             "033acac7-e083-4272-a424-b254c19eab59"]}, Open]]}, Open]], 
     Cell[CellGroupData[{Cell["2. Comprueba la conexion SSH con Mazinger", 
         "Section", ExpressionUUID -> 
          "c661da27-fb1c-4aee-8420-7e2c21838e70"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{"RemoteEvaluate", "[", 
               RowBox[{"\"ssh://robot\"", ",", " ", RowBox[{"{", RowBox[
                    {"$MachineName", ",", " ", "$Version"}], "}"}]}], "]"}]], 
            "Input", ExpressionUUID -> 
             "7af73d09-8c67-4183-a09c-a119fbc9b81d"]}, Open]]}, Open]], 
     Cell[CellGroupData[{Cell["3. Envia un calculo a nodo1", "Section", 
         ExpressionUUID -> "c30555aa-edc3-4ec9-9910-a5dcede48273"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{"RemoteEvaluate", "[", 
               RowBox[{"\"ssh://robot\"", ",", " ", RowBox[{"RemoteEvaluate", 
                   "[", RowBox[{"\"ssh://nodo1\"", ",", " ", RowBox[
                      {"{", RowBox[{"$MachineName", ",", " ", RowBox[{"2", 
                          " ", "+", " ", "2"}]}], "}"}]}], "]"}]}], "]"}]], 
            "Input", ExpressionUUID -> 
             "cfd8aa82-b366-4f01-9108-903cd25dd8b7"]}, Open]]}, Open]], 
     Cell[CellGroupData[{Cell["4. Envia otro calculo a nodo2", "Section", 
         ExpressionUUID -> "17d23a99-c4c2-4c54-990c-3edc8a2cb86b"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{"RemoteEvaluate", "[", 
               RowBox[{"\"ssh://robot\"", ",", " ", RowBox[{"RemoteEvaluate", 
                   "[", RowBox[{"\"ssh://nodo2\"", ",", " ", RowBox[
                      {"{", RowBox[{"$MachineName", ",", " ", RowBox[{"3", 
                          " ", "+", " ", "3"}]}], "}"}]}], "]"}]}], "]"}]], 
            "Input", ExpressionUUID -> 
             "777f2ca2-014c-4e36-9473-93db1594a6ce"]}, Open]]}, Open]], 
     Cell[CellGroupData[
       {Cell["5. Usa los dos nodos dentro de una misma celda", "Section", 
         ExpressionUUID -> "eac6f997-2597-4c35-9c53-aea6b2bd104b"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{"RemoteEvaluate", "[", 
               RowBox[{"\"ssh://robot\"", ",", " ", RowBox[{"Module", "[", 
                   RowBox[{RowBox[{"{", RowBox[{"ks", ",", " ", "r"}], "}"}], 
                     ",", " ", RowBox[{RowBox[{"ks", " ", "=", " ", RowBox[
                          {"Join", "[", RowBox[{RowBox[{"LaunchKernels", "[", 
                          "\"ssh://nodo1\"", "]"}], ",", " ", RowBox[
                          {"LaunchKernels", "[", "\"ssh://nodo2\"", "]"}]}], 
                          "]"}]}], ";", " ", RowBox[{"r", " ", "=", " ", 
                         RowBox[{"ParallelEvaluate", "[", RowBox[{RowBox[
                          {"{", RowBox[{"$MachineName", ",", " ", RowBox[
                          {"If", "[", RowBox[{RowBox[{"$MachineName", " ", 
                          "==", " ", "\"nodo1\""}], ",", " ", RowBox[{"2", 
                          " ", "+", " ", "2"}], ",", " ", RowBox[{"3", " ", 
                          "+", " ", "3"}]}], "]"}]}], "}"}], ",", " ", 
                          "ks"}], "]"}]}], ";", " ", RowBox[{"CloseKernels", 
                         "[", "ks", "]"}], ";", " ", "r"}]}], "]"}]}], 
               "]"}]], "Input", ExpressionUUID -> 
             "5c69cb19-eabd-4b24-9c4c-27e3ef4fdce0"]}, Open]]}, Open]]}, 
    Open]]}, Evaluator -> "Local", WindowSize -> {1470, 817}, 
 WindowMargins -> {{0, Automatic}, {Automatic, 0}}, 
 FrontEndVersion -> "15.0 for Mac OS X ARM (64-bit) (July 2, 2026)", 
 StyleDefinitions -> "Default.nb", ExpressionUUID -> 
  "eb783e61-210c-43e1-9b09-fea7a9faa117"]
