Notebook[
 {Cell[CellGroupData[
    {Cell["Autovalores de una caminata discreta en un rectangulo de 10 x 5", 
      "Title", ExpressionUUID -> "7f47829f-5405-4a7f-a6c0-60672d992d2e"], 
     Cell["Ejecuta las celdas de arriba hacia abajo. El kernel principal esta \
en tu Mac; el calculo se envia por SSH a Mazinger y luego a nodo1. No se \
guardan archivos en el cluster.", "Text", ExpressionUUID -> 
       "4dbf11df-b47e-4c32-b33a-352cadd646a7"], 
     Cell[CellGroupData[{Cell["Modelo de un paso", "Section", 
         ExpressionUUID -> "546e2e7d-fff3-4015-a378-8b21167dad7d"], 
        Cell["GenerateRectangleBasis[9, 4] produce 10 x 5 = 50 posiciones. \
Cada posicion tiene cuatro estados de moneda: arriba, abajo, derecha e \
izquierda. BuildShiftOperators[base, CoinDimension -> 4] construye S con \
reflexion en la frontera. La moneda de Grover C = GeneralizedGroverCoin[Pi/4] \
se aplica en cada posicion. El operador de un paso es U = S . (I_50 \
KroneckerProduct C) y mide 200 x 200.", "Text", ExpressionUUID -> 
          "db74fa6c-42b8-4b12-a2f4-1ff6b4e3134e"]}, Open]], 
     Cell[CellGroupData[{Cell["Construccion y diagonalizacion en nodo1", 
         "Section", ExpressionUUID -> 
          "55093ff3-fda8-49a3-bcf1-3eb1827b15fd"], Cell["PacletDirectoryLoad \
hace visible QuantumWalks solo durante esta sesion temporal del nodo. Needs \
carga todo el paquete. ForScience ya esta instalado en tu cuenta; Block usa \
texto simple para las ayudas durante la carga porque este kernel no tiene \
interfaz grafica. No cambia los calculos.", "Text", ExpressionUUID -> 
          "7f74d8a9-9132-47ec-a6eb-15c8eb3f50a2"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{"resultadoDiscreto", " ", 
               "=", " ", RowBox[{"RemoteEvaluate", "[", RowBox[
                  {"\"ssh://robot\"", ",", " ", RowBox[{"RemoteEvaluate", 
                     "[", RowBox[{"\"ssh://nodo1\"", ",", " ", RowBox[
                        {"Module", "[", RowBox[{RowBox[{"{", RowBox[{"ruta", 
                          ",", " ", "base", ",", " ", "s", ",", " ", 
                          "moneda", ",", " ", "monedaGlobal", ",", " ", "u", 
                          ",", " ", "vals", ",", " ", "dim"}], "}"}], ",", 
                          " ", RowBox[{RowBox[{"ruta", " ", "=", " ", RowBox[
                          {"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[
                          {"Replace", "[", RowBox[{RowBox[{"Environment", 
                          "[", "\"QW_PROJECT_ROOT\"", "]"}], ",", RowBox[
                          {RowBox[{"Except", "[", "_String", "]"}], 
                          "\[RuleDelayed]", RowBox[{"FileNameJoin", "[", 
                          RowBox[{"{", RowBox[{"$HomeDirectory", ",", 
                          "\"QW\""}], "}"}], "]"}]}]}], "]"}], ",", 
                          "\"JA_libs\"", ",", "\"QuantumWalks\""}], "}"}], 
                          "]"}]}], ";", " ", RowBox[{"PacletDirectoryLoad", 
                          "[", "ruta", "]"}], ";", " ", RowBox[{"Needs", "[", 
                          "\"ForScience`\"", "]"}], ";", " ", RowBox[
                          {"Block", "[", RowBox[{RowBox[{"{", RowBox[
                          {"ForScience`PacletUtils`FormatUsage", " ", "=", 
                          " ", "Identity"}], "}"}], ",", " ", RowBox[
                          {"Needs", "[", "\"QuantumWalks`\"", "]"}]}], "]"}], 
                          ";", " ", RowBox[{"base", " ", "=", " ", RowBox[
                          {"QuantumWalks`Billiards`GenerateRectangleBasis", 
                          "[", RowBox[{"9", ",", " ", "4"}], "]"}]}], ";", 
                          " ", RowBox[{"dim", " ", "=", " ", RowBox[{"base", 
                          "[", "\"Dimension\"", "]"}]}], ";", " ", RowBox[
                          {"s", " ", "=", " ", RowBox[{
                          "QuantumWalks`Billiards`BuildShiftOperators", "[", 
                          RowBox[{"base", ",", " ", RowBox[{
                          "QuantumWalks`Billiards`CoinDimension", " ", "->", 
                          " ", "4"}]}], "]"}]}], ";", " ", RowBox[{"moneda", 
                          " ", "=", " ", RowBox[{
                          "QuantumWalks`Billiards`GeneralizedGroverCoin", 
                          "[", RowBox[{"Pi", "/", "4."}], "]"}]}], ";", " ", 
                          RowBox[{"monedaGlobal", " ", "=", " ", RowBox[
                          {"KroneckerProduct", "[", RowBox[{RowBox[
                          {"IdentityMatrix", "[", RowBox[{"dim", ",", " ", 
                          "SparseArray"}], "]"}], ",", " ", RowBox[
                          {"SparseArray", "[", "moneda", "]"}]}], "]"}]}], 
                          ";", " ", RowBox[{"u", " ", "=", " ", RowBox[{"s", 
                          " ", ".", " ", "monedaGlobal"}]}], ";", " ", 
                          RowBox[{"vals", " ", "=", " ", RowBox[
                          {"Eigenvalues", "[", RowBox[{"Normal", "[", "u", 
                          "]"}], "]"}]}], ";", " ", RowBox[{"<|", RowBox[
                          {RowBox[{"\"Nodo\"", " ", "->", " ", 
                          "$MachineName"}], ",", " ", RowBox[{"\"Sitios\"", 
                          " ", "->", " ", "dim"}], ",", " ", RowBox[
                          {"\"DimensionU\"", " ", "->", " ", RowBox[
                          {"Dimensions", "[", "u", "]"}]}], ",", " ", RowBox[
                          {"\"Autovalores\"", " ", "->", " ", "vals"}], ",", 
                          " ", RowBox[{"\"ErrorUnitariedad\"", " ", "->", 
                          " ", RowBox[{"Max", "[", RowBox[{"Abs", "[", RowBox[
                          {"Flatten", "[", RowBox[{RowBox[{RowBox[{
                          "ConjugateTranspose", "[", "u", "]"}], " ", ".", 
                          " ", "u"}], " ", "-", " ", RowBox[{
                          "IdentityMatrix", "[", RowBox[{"4", " ", "dim"}], 
                          "]"}]}], "]"}], "]"}], "]"}]}], ",", " ", RowBox[
                          {"\"ErrorModulo\"", " ", "->", " ", RowBox[{"Max", 
                          "[", RowBox[{"Abs", "[", RowBox[{RowBox[{"Abs", 
                          "[", "vals", "]"}], " ", "-", " ", "1"}], "]"}], 
                          "]"}]}]}], "|>"}]}]}], "]"}]}], "]"}]}], "]"}]}]], 
            "Input", ExpressionUUID -> 
             "7971db28-d038-4808-906e-ff5429bb2c9f"]}, Open]]}, Open]], 
     Cell[CellGroupData[{Cell["Comprobaciones", "Section", 
         ExpressionUUID -> "f160e7d8-b147-4887-a079-18edbc689996"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{"{", RowBox[
                {RowBox[{"resultadoDiscreto", "[", "\"Nodo\"", "]"}], ",", 
                 " ", RowBox[{"resultadoDiscreto", "[", "\"Sitios\"", "]"}], 
                 ",", " ", RowBox[{"resultadoDiscreto", "[", 
                   "\"DimensionU\"", "]"}], ",", " ", RowBox[{"Length", "[", 
                   RowBox[{"resultadoDiscreto", "[", "\"Autovalores\"", 
                     "]"}], "]"}], ",", " ", RowBox[{"resultadoDiscreto", 
                   "[", "\"ErrorUnitariedad\"", "]"}], ",", " ", 
                 RowBox[{"resultadoDiscreto", "[", "\"ErrorModulo\"", 
                   "]"}]}], "}"}]], "Input", ExpressionUUID -> 
             "64126732-64c2-4e23-b4a6-6b67c6ea95cb"]}, Open]], 
        Cell["Resultado esperado: {\"nodo1\", 50, {200, 200}, 200, errores \
cercanos a 10^-15}. Los errores pequenos reflejan el redondeo numerico.", 
         "Text", ExpressionUUID -> "6e1ba21e-7ac9-43d8-86b0-d9151ee81716"]}, 
       Open]], Cell[CellGroupData[{Cell["Autovalores complejos", "Section", 
         ExpressionUUID -> "0657ed92-4e63-47bd-8a58-6130f80aec21"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{"resultadoDiscreto", "[", 
               "\"Autovalores\"", "]"}]], "Input", ExpressionUUID -> 
             "61212673-8b66-4d1a-bdad-070ef9baacb5"]}, Open]], 
        Cell["Los autovalores de un operador unitario deben estar sobre el \
circulo unitario. Algunos pueden coincidir y verse como un solo punto.", 
         "Text", ExpressionUUID -> "23fa4c92-e250-4e93-b47b-2d68119878fc"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{"ComplexListPlot", "[", 
               RowBox[{RowBox[{"resultadoDiscreto", "[", "\"Autovalores\"", 
                   "]"}], ",", " ", RowBox[{"PlotRange", " ", "->", " ", 
                   "All"}], ",", " ", RowBox[{"AspectRatio", " ", "->", " ", 
                   "1"}]}], "]"}]], "Input", ExpressionUUID -> 
             "7f9ddaaa-cf5b-497a-bcdb-78e757890ad0"]}, Open]]}, Open]], 
     Cell[CellGroupData[{Cell["Fases y cuasienergias", "Section", 
         ExpressionUUID -> "af171ea9-bdf3-4fc3-b848-47887765a49a"], 
        Cell["Si lambda_j = Exp[-I epsilon_j], entonces epsilon_j = \
-Arg[lambda_j] modulo 2 Pi. Elegimos la rama entre 0 y 2 Pi.", "Text", 
         ExpressionUUID -> "48d87d75-1609-4bc4-ae4f-e3710d251ef2"], 
        Cell[BoxData[RowBox[{"cuasienergias", " ", "=", " ", 
            RowBox[{"Sort", "[", RowBox[{"Mod", "[", RowBox[
                 {RowBox[{"-", RowBox[{"Arg", "[", RowBox[
                       {"resultadoDiscreto", "[", "\"Autovalores\"", "]"}], 
                      "]"}]}], ",", " ", RowBox[{"2", " ", "Pi"}]}], "]"}], 
              "]"}]}]], "Input", ExpressionUUID -> 
          "3c98138b-f853-4ec2-91cb-c60720e3f544"], 
        Cell[BoxData[RowBox[{"ListPlot", "[", RowBox[{"cuasienergias", ",", 
              " ", RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
              RowBox[{"FrameLabel", " ", "->", " ", RowBox[{"{", 
                  RowBox[{"\"indice ordenado\"", ",", " ", 
                    "\"cuasienergia\""}], "}"}]}], ",", " ", 
              RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}]], 
         "Input", ExpressionUUID -> "1c9cbe7a-4963-49d5-b943-46312af9c109"]}, 
       Open]]}, Open]]}, Evaluator -> "Local", WindowSize -> {1249, 817}, 
 WindowMargins -> {{Automatic, 0}, {Automatic, 0}}, 
 FrontEndVersion -> "15.0 for Mac OS X ARM (64-bit) (July 2, 2026)", 
 StyleDefinitions -> "Default.nb", ExpressionUUID -> 
  "494e4ad5-8495-43f5-950b-a808e74ccdef"]
