Cell[CellGroupData[{

Cell["Fases y cuasienergias", "Section",ExpressionUUID->"af171ea9-bdf3-4fc3-b848-47887765a49a"],

Cell["\<\
Si lambda_j = Exp[-I epsilon_j], entonces epsilon_j = -Arg[lambda_j] modulo 2 \
Pi. Elegimos la rama entre 0 y 2 Pi.\
\>", "Text",ExpressionUUID->"48d87d75-1609-4bc4-ae4f-e3710d251ef2"],

Cell[BoxData[
 RowBox[{"cuasienergias", " ", "=", " ", 
  RowBox[{"Sort", "[", 
   RowBox[{"Mod", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Arg", "[", 
       RowBox[{"resultadoDiscreto", "[", "\"\<Autovalores\>\"", "]"}], 
       "]"}]}], ",", " ", 
     RowBox[{"2", " ", "Pi"}]}], "]"}], "]"}]}]], "Input",ExpressionUUID->\
"3c98138b-f853-4ec2-91cb-c60720e3f544"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{"cuasienergias", ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<indice ordenado\>\"", ",", " ", "\"\<cuasienergia\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}]], "Input",ExpressionU\
UID->"1c9cbe7a-4963-49d5-b943-46312af9c109"]
}, Open  ]]
}, Open  ]]
},
