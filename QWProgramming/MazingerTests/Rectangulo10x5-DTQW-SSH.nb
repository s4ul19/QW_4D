Notebook[{

Cell[CellGroupData[{
Cell["\<\
Autovalores de una caminata discreta en un rectangulo de 10 x 5\
\>", "Title",ExpressionUUID->"7f47829f-5405-4a7f-a6c0-60672d992d2e"],

Cell["\<\
Ejecuta las celdas de arriba hacia abajo. El kernel principal esta en tu Mac; \
el calculo se envia por SSH a Mazinger y luego a nodo1. No se guardan \
archivos en el cluster.\
\>", "Text",ExpressionUUID->"4dbf11df-b47e-4c32-b33a-352cadd646a7"],

Cell[CellGroupData[{

Cell["Modelo de un paso", "Section",ExpressionUUID->"546e2e7d-fff3-4015-a378-8b21167dad7d"],

Cell["\<\
GenerateRectangleBasis[9, 4] produce 10 x 5 = 50 posiciones. Cada posicion \
tiene cuatro estados de moneda: arriba, abajo, derecha e izquierda. \
BuildShiftOperators[base, CoinDimension -> 4] construye S con reflexion en la \
frontera. La moneda de Grover C = GeneralizedGroverCoin[Pi/4] se aplica en \
cada posicion. El operador de un paso es U = S . (I_50 KroneckerProduct C) y \
mide 200 x 200.\
\>", "Text",ExpressionUUID->"db74fa6c-42b8-4b12-a2f4-1ff6b4e3134e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Construccion y diagonalizacion en nodo1", "Section",ExpressionUUID->"55093ff3-fda8-49a3-bcf1-3eb1827b15fd"],

Cell["\<\
PacletDirectoryLoad hace visible QuantumWalks solo durante esta sesion \
temporal del nodo. Needs carga todo el paquete. ForScience ya esta instalado \
en tu cuenta; Block usa texto simple para las ayudas durante la carga porque \
este kernel no tiene interfaz grafica. No cambia los calculos.\
\>", "Text",ExpressionUUID->"7f74d8a9-9132-47ec-a6eb-15c8eb3f50a2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"resultadoDiscreto", " ", "=", " ", 
  RowBox[{"RemoteEvaluate", "[", 
   RowBox[{"\"\<ssh://robot\>\"", ",", " ", 
    RowBox[{"RemoteEvaluate", "[", 
     RowBox[{"\"\<ssh://nodo1\>\"", ",", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "ruta", ",", " ", "base", ",", " ", "s", ",", " ", "moneda", ",", 
          " ", "monedaGlobal", ",", " ", "u", ",", " ", "vals", ",", " ", 
          "dim"}], "}"}], ",", " ", 
        RowBox[{
         RowBox[{
         "ruta", " ", "=", 
          " ", "\"\</home/saul/QW/JA_libs/QuantumWalks\>\""}], ";", " ", 
         RowBox[{"PacletDirectoryLoad", "[", "ruta", "]"}], ";", " ", 
         RowBox[{"Needs", "[", "\"\<ForScience`\>\"", "]"}], ";", " ", 
         RowBox[{"Block", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "ForScience`PacletUtils`FormatUsage", " ", "=", " ", "Identity"}],
             "}"}], ",", " ", 
           RowBox[{"Needs", "[", "\"\<QuantumWalks`\>\"", "]"}]}], "]"}], ";",
          " ", 
         RowBox[{"base", " ", "=", " ", 
          RowBox[{"QuantumWalks`Billiards`GenerateRectangleBasis", "[", 
           RowBox[{"9", ",", " ", "4"}], "]"}]}], ";", " ", 
         RowBox[{"dim", " ", "=", " ", 
          RowBox[{"base", "[", "\"\<Dimension\>\"", "]"}]}], ";", " ", 
         RowBox[{"s", " ", "=", " ", 
          RowBox[{"QuantumWalks`Billiards`BuildShiftOperators", "[", 
           RowBox[{"base", ",", " ", 
            RowBox[{
            "QuantumWalks`Billiards`CoinDimension", " ", "->", " ", "4"}]}], 
           "]"}]}], ";", " ", 
         RowBox[{"moneda", " ", "=", " ", 
          RowBox[{"QuantumWalks`Billiards`GeneralizedGroverCoin", "[", 
           RowBox[{"Pi", "/", "4."}], "]"}]}], ";", " ", 
         RowBox[{"monedaGlobal", " ", "=", " ", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{"IdentityMatrix", "[", 
             RowBox[{"dim", ",", " ", "SparseArray"}], "]"}], ",", " ", 
            RowBox[{"SparseArray", "[", "moneda", "]"}]}], "]"}]}], ";", " ", 
         
         RowBox[{"u", " ", "=", " ", 
          RowBox[{"s", " ", ".", " ", "monedaGlobal"}]}], ";", " ", 
         RowBox[{"vals", " ", "=", " ", 
          RowBox[{"Eigenvalues", "[", 
           RowBox[{"Normal", "[", "u", "]"}], "]"}]}], ";", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Nodo\>\"", " ", "->", " ", "$MachineName"}], ",", " ", 
           RowBox[{"\"\<Sitios\>\"", " ", "->", " ", "dim"}], ",", " ", 
           RowBox[{"\"\<DimensionU\>\"", " ", "->", " ", 
            RowBox[{"Dimensions", "[", "u", "]"}]}], ",", " ", 
           RowBox[{"\"\<Autovalores\>\"", " ", "->", " ", "vals"}], ",", " ", 
           
           RowBox[{"\"\<ErrorUnitariedad\>\"", " ", "->", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"Flatten", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"ConjugateTranspose", "[", "u", "]"}], " ", ".", " ",
                  "u"}], " ", "-", " ", 
                RowBox[{"IdentityMatrix", "[", 
                 RowBox[{"4", " ", "dim"}], "]"}]}], "]"}], "]"}], "]"}]}], ",",
            " ", 
           RowBox[{"\"\<ErrorModulo\>\"", " ", "->", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"Abs", "[", "vals", "]"}], " ", "-", " ", "1"}], "]"}],
              "]"}]}]}], "|>"}]}]}], "]"}]}], "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"7971db28-d038-4808-906e-ff5429bb2c9f"],

