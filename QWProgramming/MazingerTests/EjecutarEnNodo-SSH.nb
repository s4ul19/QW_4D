Notebook[
 {Cell[CellGroupData[
    {Cell["Ejecutar tareas independientes en un nodo de Mazinger", "Title", 
      ExpressionUUID -> "f31db215-55c9-4041-8157-9ffb1b9f4567"], 
     Cell["Evalua las celdas en orden con el kernel local de tu Mac. La \
conexion usa el alias SSH robot: Mac -> Mazinger -> nodo elegido. Cada \
llamada abre kernels temporales, recoge los resultados en el Mac y cierra \
esos kernels. El notebook no guarda archivos en el cluster.", "Text", 
      ExpressionUUID -> "a42571b7-2ff6-4f6b-9f59-46e47c2b38c1"], 
     Cell[CellGroupData[{Cell["Funcion de prueba", "Section", 
         ExpressionUUID -> "5276992d-a02f-4047-aaff-21f610a5b273"], 
        Cell["Argumentos: nombre del nodo, numero de kernels, funcion pura y \
lista de entradas. La funcion pura se aplica por separado a cada entrada. La \
salida mantiene el orden de la lista. La cantidad solicitada debe ser \
compatible con los recursos y las normas de uso del cluster.", "Text", 
         ExpressionUUID -> "4bd5bfed-4a10-47ae-8855-c4675d508ebf"], 
        Cell[BoxData[RowBox[{RowBox[{"root", "=", RowBox[{"DirectoryName", 
                "[", RowBox[{"NotebookDirectory", "[", "]"}], "]"}]}], ";", 
            RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", RowBox[
                 {"{", RowBox[{"root", ",", "\"scripts\"", ",", 
                    "\"load_project.wl\""}], "}"}], "]"}], "]"}], ";"}]], 
         "Input"]}, Open]], Cell[CellGroupData[
       {Cell["Comprobar el reparto", "Section", ExpressionUUID -> 
          "e37e423d-e70e-4f0d-a2f8-1844a616e1bd"], Cell["Este ejemplo pide \
dos kernels en nodo1. Cada fila contiene la entrada, el nodo, el \
identificador del proceso que hizo la cuenta y el cuadrado. Los \
identificadores deben mostrar que participaron dos procesos distintos.", 
         "Text", ExpressionUUID -> "7a2be4f6-d657-435a-b99f-1cccecb39faf"], 
        Cell[CellGroupData[{Cell[BoxData[{RowBox[{RowBox[{"prueba", " ", "=", 
                  " ", RowBox[{"QuantumWalks`QWMisc`EjecutarEnNodo", "[", 
                    RowBox[{"\"nodo1\"", ",", " ", "2", ",", " ", RowBox[
                       {"Function", "[", RowBox[{"x", ",", " ", RowBox[
                          {"{", RowBox[{"x", ",", " ", "$MachineName", ",", 
                          " ", "$ProcessID", ",", " ", RowBox[{"x", "^", 
                          "2"}]}], "}"}]}], "]"}], ",", " ", RowBox[{"Range", 
                        "[", "6", "]"}]}], "]"}]}], ";"}], "\n", "prueba"}], 
            "Input", ExpressionUUID -> 
             "aac7f449-6db6-4a7e-baef-4adf3308dde5"]}, Open]], 
        Cell[BoxData[RowBox[{"DeleteDuplicates", "[", 
            RowBox[{"prueba", "[", RowBox[{"[", RowBox[{"All", ",", " ", 
                  "3"}], "]"}], "]"}], "]"}]], "Input", 
         ExpressionUUID -> "7baa4e6f-e427-4047-9b94-a28f053a9d85"]}, Open]], 
     Cell[CellGroupData[{Cell["Ejemplo de autovalores", "Section", 
         ExpressionUUID -> "ca0a14fb-593c-451e-a270-1f11c09ac26d"], 
        Cell["Cada valor de n define una matriz distinta. Sus autovalores se \
calculan como trabajos independientes en el nodo. Sustituye esta funcion pura \
por una que construya tus operadores cuando hayas comprobado el mecanismo. \
Una sola diagonalizacion no se divide automaticamente entre los kernels \
solicitados.", "Text", ExpressionUUID -> 
          "53a30a1e-2102-4924-a0f8-1431fe77978f"], 
        Cell[CellGroupData[{Cell[BoxData[{RowBox[{RowBox[{"resultados", " ", 
                  "=", " ", RowBox[{"QuantumWalks`QWMisc`EjecutarEnNodo", 
                    "[", RowBox[{"\"nodo1\"", ",", " ", "2", ",", "\n", "  ", 
                      RowBox[{"Function", "[", RowBox[{"n", ",", " ", 
                          RowBox[{"<|", RowBox[{RowBox[{"\"Dimension\"", " ", 
                          "->", " ", "n"}], ",", "\n", "    ", RowBox[
                          {"\"Autovalores\"", " ", "->", " ", RowBox[
                          {"Eigenvalues", "[", RowBox[{"N", "[", RowBox[
                          {"Table", "[", RowBox[{RowBox[{"If", "[", RowBox[
                          {RowBox[{RowBox[{"Abs", "[", RowBox[{"i", " ", "-", 
                          " ", "j"}], "]"}], " ", "==", " ", "1"}], ",", " ", 
                          "1", ",", " ", "0"}], "]"}], ",", " ", RowBox[{"{", 
                          RowBox[{"i", ",", " ", "n"}], "}"}], ",", " ", 
                          RowBox[{"{", RowBox[{"j", ",", " ", "n"}], "}"}]}], 
                          "]"}], "]"}], "]"}]}]}], "|>"}]}], "]"}], ",", 
                      "\n", "  ", RowBox[{"{", RowBox[{"10", ",", " ", "12", 
                          ",", " ", "14", ",", " ", "16"}], "}"}]}], "]"}]}], 
                ";"}], "\n", RowBox[{"{", RowBox[{RowBox[{"Length", "[", 
                    "resultados", "]"}], ",", " ", RowBox[{"resultados", "[", 
                    RowBox[{"[", RowBox[{"All", ",", " ", "\"Dimension\""}], 
                      "]"}], "]"}], ",", " ", RowBox[{"Length", " ", "/@", 
                    " ", RowBox[{"resultados", "[", RowBox[{"[", RowBox[
                         {"All", ",", " ", "\"Autovalores\""}], "]"}], 
                      "]"}]}]}], "}"}]}], "Input", ExpressionUUID -> 
             "12f019f9-d23d-4be4-9e5e-d12980c00bd2"]}, Open]]}, Open]], 
     Cell[CellGroupData[{Cell["Guardar en el Mac (opcional)", "Section", 
         ExpressionUUID -> "162f45d4-e621-47f1-8a11-95b1fd09ec2c"], 
        Cell["La variable resultados queda en la memoria del kernel local. \
Evalua la celda siguiente si deseas conservarla como archivo WDX junto a este \
notebook. La importacion posterior se hace con Import[ruta].", "Text", 
         ExpressionUUID -> "43e1f82e-b5bc-4380-b4a3-07188fdc4dfa"], 
        Cell[BoxData[{RowBox[{RowBox[{"ruta", " ", "=", " ", RowBox[
                {"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[
                      {"NotebookDirectory", "[", "]"}], ",", " ", 
                     "\"resultados-ejemplo.wdx\""}], "}"}], "]"}]}], ";"}], 
           "\n", RowBox[{"Export", "[", RowBox[{"ruta", ",", " ", 
               "resultados"}], "]"}]}], "Input", ExpressionUUID -> 
          "e70a19ba-f12b-48b2-8597-f915e66fd339"]}, Open]], 
     Cell[CellGroupData[{Cell["Alcance de esta version", "Section", 
         ExpressionUUID -> "72ade3d2-47be-48f2-8786-c705ffab2b14"], 
        Cell["La funcion espera una funcion pura autocontenida. Si el calculo \
usa QuantumWalks u otros paquetes, habra que cargar el paquete en cada kernel \
del nodo antes de ParallelMap. Si la prueba te resulta util, adaptaremos esa \
inicializacion y despues la incorporaremos a QWMisc.wl.", "Text", 
         ExpressionUUID -> "ed76799a-ee91-4135-8058-cee085f7827c"]}, Open]]}, 
    Open]]}, Evaluator -> "Local", WindowSize -> {1470, 817}, 
 WindowMargins -> {{0, Automatic}, {Automatic, 0}}, 
 FrontEndVersion -> "15.0 for Mac OS X ARM (64-bit) (July 2, 2026)", 
 StyleDefinitions -> "Default.nb", ExpressionUUID -> 
  "2ad4e6e4-cf9a-41a7-97e2-a065579fb514"]
