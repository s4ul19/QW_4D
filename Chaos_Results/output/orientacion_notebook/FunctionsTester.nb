                          "=", RowBox[{"1.001", " ", RowBox[{"Exp", "[", 
                          RowBox[{RowBox[{"-", "I"}], " ", RowBox[{"targets", 
                          "[", RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}]}], 
