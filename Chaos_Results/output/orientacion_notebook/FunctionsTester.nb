Cell[CellGroupData[{

Cell["Tratando de hallar estados de borde mediante a IPR", 
               "Subsection", CellChangeTimes -> {{3.999788711746876*^9, 
                  3.9997887201585493*^9}}, ExpressionUUID -> 
                "d3954e0d-cca2-42ac-801e-02220f15f227"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "23", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lx", "=", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Ly", "=", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grid", "=", 
   RowBox[{"GenerateRectangleBasis", "[", 
    RowBox[{"Lx", ",", "Ly"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{"BuildShiftOperators", "[", 
    RowBox[{"grid", ",", 
     RowBox[{"CoinDimension", "->", "4"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nSites", "=", 
   RowBox[{"grid", "[", "\"\<Dimension\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"c", "=", 
   RowBox[{"N", "[", 
    RowBox[{"RandomMatrix", "[", "\"\<oo\>\"", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"evolutionOp", "=", 
    RowBox[{"QWEvolutionOperator", "[", 
     RowBox[{"grid", ",", 
      RowBox[{"SparseArray", "[", "c", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Eigenvalores", " ", "y", " ", "eigenvectores"}], ",", 
    RowBox[{"en", " ", "el", " ", "mismo", " ", "orden"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"eigenvals", ",", "eigenvecs"}], "}"}], "=", 
   RowBox[{"Eigensystem", "[", 
    RowBox[{"Normal", "[", "evolutionOp", "]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.9997904779842443`*^9, {3.999790593655616*^9, 3.999790599733635*^9}, {
   3.9997971072743597`*^9, 3.999797109612872*^9}, {3.999797814241081*^9, 
   3.999797815284713*^9}, {3.999798789136468*^9, 3.999798790027136*^9}, {
   3.999799365499995*^9, 3.999799370694117*^9}, {3.9997994599935827`*^9, 
   3.99979946621488*^9}, {3.9999489657080593`*^9, 3.999948968538022*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"8b1474e4-0902-4544-9d8f-6c3a8533d180"],

Cell[CellGroupData[{

Cell[
                  "Chequeando IPR vs cuasiEnerg\[IAcute]a", "Subsubsection", 
                  CellChangeTimes -> {{3.9998027321979218*^9, 
                     3.999802744452363*^9}}, ExpressionUUID -> 
                   "fa41cdf2-b710-4bd2-9f8c-9448b50980bf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eigenenergies", "=", 
   RowBox[{"-", 
    RowBox[{"Arg", "[", "eigenvals", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"borde", "=", 
   RowBox[{"AnalyzeBoundaryEigenstates", "[", 
    RowBox[{"grid", ",", "eigenvals", ",", "eigenvecs", ",", 
     RowBox[{"BoundaryWidth", "->", "2"}], ",", 
     RowBox[{"BoundaryThreshold", "->", "0.6"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "[", 
  RowBox[{"borde", "[", "\"\<Candidates\>\"", "]"}], "]"}], "\n", 
 RowBox[{"borde", "[", "\"\<CandidateEnergies\>\"", "]"}], "\n", 
 RowBox[{"PlotBoundarySpectrum", "[", "borde", "]"}]}], "Input",
 CellChangeTimes->{
  3.9997904779842443`*^9, {3.999790593655616*^9, 3.999790599733635*^9}, {
   3.9997971072743597`*^9, 3.999797109612872*^9}, {3.999797814241081*^9, 
   3.999797815284713*^9}, {3.999798789136468*^9, 3.999798790027136*^9}, {
   3.999799365499995*^9, 3.999799370694117*^9}, {3.9997994599935827`*^9, 
   3.999799490068397*^9}, {3.999799672482085*^9, 3.999799672712195*^9}, {
   3.999801811548164*^9, 3.9998018160768347`*^9}, {3.999801896330586*^9, 
   3.999801896656684*^9}, 3.999802301477491*^9},
 CellLabel->"In[11]:=",ExpressionUUID->"15cdfb0f-d680-44ec-a8a3-3f7335a9889c"],

