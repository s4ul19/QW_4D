                          {RowBox[{"Directive", "[", RowBox[{RowBox[
                          {"Thickness", "[", "0.006", "]"}], ",", "#"}], 
                          "]"}], "&"}], "/@", "PlotColors"}], ")"}]}], ",", 
                          RowBox[{"PlotLegends", "->", RowBox[{"Placed", "[", 
                          RowBox[{RowBox[{"LineLegend", "[", RowBox[
                          {"PlotColors", ",", "EnsemblesList", ",", RowBox[
