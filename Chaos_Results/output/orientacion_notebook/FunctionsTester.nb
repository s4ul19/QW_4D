Cell[CellGroupData[{

Cell["Revisando si quitando las energ\[IAcute]as de estado de \
borde se mejora la estad\[IAcute]stica espectral\n(No hay cambio \
significativo)", "Section", CellChangeTimes -> {{3.9998024639726343*^9, 
               3.999802466886001*^9}, {3.999802657568345*^9, 
