Cell["Visualizando un caso \
particular.\nGraficando la densidad de ipr y checando un valor particular de \
la densidad seg\[UAcute]n un nodo dado.", "Subsection", CellChangeTimes -> 
                {{3.999518881363885*^9, 3.9995189367636747*^9}}, 
               ExpressionUUID -> "08ad7066-9ff2-4812-8d5b-672ed90140da"],

Cell[BoxData[{RowBox[{RowBox[{"Lx", "=", 
                        "105"}], ";", RowBox[{"Ly", "=", "65"}], ";"}], 
                    "\[IndentingNewLine]", RowBox[{RowBox[{"grid", "=", 
                        RowBox[{"GenerateSinaiBasis", "[", RowBox[{"Lx", ",", 
                          "Ly"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
                    RowBox[{RowBox[{"pos", "=", RowBox[{"{", RowBox[{"70", 
                          ",", "30"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
                    RowBox[{RowBox[{"coin", "=", RowBox[{"HaarRandomState", 
                          "[", "4", "]"}]}], ";"}], "\[IndentingNewLine]", 
                    RowBox[{RowBox[{RowBox[{"initState", "=", RowBox[
                          {"Normalize", "[", RowBox[{RowBox[
                          {"LocalizedState", "[", RowBox[{"grid", ",", "pos", 
                          ",", "coin"}], "]"}], "+", RowBox[
                          {"LocalizedState", "[", RowBox[{"grid", ",", RowBox[
                          {"pos", "+", RowBox[{"{", RowBox[{"1", ",", "1"}], 
                          "}"}]}], ",", "coin"}], "]"}]}], "]"}]}], ";"}], 
                      "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
                    RowBox[{RowBox[{RowBox[{"iprdensity", "=", RowBox[
                          {"ComputeSpatialIPRDensity", "[", RowBox[
                          {"initState", ",", "4"}], "]"}]}], ";"}], "\n"}], 
                    "\[IndentingNewLine]", RowBox[{RowBox[{"indexList", "=", 
                        RowBox[{"grid", "[", "\"Mapping\"", "]"}]}], ";"}], 
                    "\[IndentingNewLine]", RowBox[{RowBox[{"index", "=", 
                        RowBox[{"indexList", "[", "pos", "]"}]}], ";"}], 
                    "\[IndentingNewLine]", RowBox[{"iprlocal", "=", 
                      RowBox[{"iprdensity", "[", RowBox[{"[", "index", "]"}], 
                        "]"}]}], "\[IndentingNewLine]", RowBox[
                     {"DiscreteProbabilityPlot", "[", RowBox[{"grid", ",", 
                        "iprdensity"}], "]"}]}], "Input", CellChangeTimes -> 
