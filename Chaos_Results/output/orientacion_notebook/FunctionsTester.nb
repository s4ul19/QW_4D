                          "objetivo"}], ",", RowBox[{"eigenfase", " ", 
                          "encontrada"}], ",", RowBox[{"residuo", " ", "e", 
                          " ", "IPR"}]}], "*)"}], "\n", RowBox[{RowBox[
                          {"summary", "=", RowBox[{"Grid", "[", RowBox[
                          {RowBox[{"Prepend", "[", RowBox[{RowBox[{"Table", 
                          "[", RowBox[{RowBox[{"{", RowBox[{"j", ",", RowBox[
                          {"NumberForm", "[", RowBox[{RowBox[{"N", "[", 
