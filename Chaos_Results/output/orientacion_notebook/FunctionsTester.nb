Cell[CellGroupData[{

Cell["Evoluci\[OAcute]n de la IPR espacial", 
            "Section", ExpressionUUID -> 
             "e7731bda-9f8b-4c36-9925-325d2130541b"],

Cell["SpatialIPREvoluti\
onPlot[operador, estadoInicial, pasos] grafica la IPR desde t = 0 hasta el \
paso indicado. CoinDimension -> 4 es el valor predeterminado. Se conserva \
solo el estado actual durante la evoluci\[OAcute]n. La escala vertical es \
logar\[IAcute]tmica y la l\[IAcute]nea discontinua indica 1/N, el \
m\[IAcute]nimo de la IPR para N nodos; no es una predicci\[OAcute]n del valor \
final.", "Text", ExpressionUUID -> "386df38c-049a-4c41-afbf-0a74ec02417e"],

Cell[BoxData[RowBox[{RowBox[{"iprPlotGrid", 
                    "=", RowBox[{"GenerateRectangleBasis", "[", RowBox[
                       {"12", ",", "8"}], "]"}]}], ";", RowBox[
                   {"iprPlotCoin", "=", RowBox[{"N", "[", RowBox[
                       {"FourierMatrix", "[", "4", "]"}], "]"}]}], ";", 
                  RowBox[{"iprPlotEvolution", "=", RowBox[
                     {"QWEvolutionOperator", "[", RowBox[{"iprPlotGrid", ",", 
                        RowBox[{"SparseArray", "[", "iprPlotCoin", "]"}]}], 
                      "]"}]}], ";", RowBox[{"iprPlotInitial", "=", 
                    RowBox[{"LocalizedState", "[", RowBox[{"iprPlotGrid", 
                        ",", RowBox[{"{", RowBox[{"6", ",", "4"}], "}"}], 
                        ",", RowBox[{"Normalize", "[", RowBox[{"{", RowBox[
                          {"1", ",", "\[ImaginaryI]", ",", RowBox[{"-", 
                          "1"}], ",", "0"}], "}"}], "]"}]}], "]"}]}], ";", 
                  RowBox[{"SpatialIPREvolutionPlot", "[", RowBox[
                     {"iprPlotEvolution", ",", "iprPlotInitial", ",", 
                      "240"}], "]"}]}]], "Input", ExpressionUUID -> 
                "e5da80ef-9da0-46d2-a7ae-ba0672bc2035"],

Cell["Para el operador evolutionSep y el estado initialState de tu \
rutina, basta llamar SpatialIPREvolutionPlot[evolutionSep, initialState, \
steps]. No necesitas finalstates ni iprDat. Las opciones de ListLinePlot \
permiten cambiar etiquetas, tama\[NTilde]o, estilos y rango.", "Text", 
            ExpressionUUID -> "07302860-66ee-4b9c-9053-746f90f60420"],

Cell[BoxData[RowBox[
                 {"SpatialIPREvolutionPlot", "[", RowBox[{"iprPlotEvolution", 
                    ",", "iprPlotInitial", ",", "120", ",", RowBox[
                     {"ScalingFunctions", "\[Rule]", "None"}], ",", 
                    RowBox[{"ShowUniformReference", "\[Rule]", "False"}], 
                    ",", RowBox[{"PlotLabel", "\[Rule]", 
                      "\"IPR espacial: escala lineal\""}], ",", RowBox[
                     {"ImageSize", "\[Rule]", "650"}]}], "]"}]], "Input", 
               ExpressionUUID -> "e890a3e5-18f4-4ce1-8860-c63144c397fd"],

Cell["ComputeSpatialIPREvolution devuelve los pares {t, \
IPR(t)} si necesitas guardar o analizar los datos. Para cambiar la \
dimensi\[OAcute]n de moneda, usa CoinDimension -> 2 (o la dimensi\[OAcute]n \
correspondiente) en cualquiera de las dos funciones.", "Text", 
            ExpressionUUID -> "9783feec-3168-4492-95a0-bfba3e1c28d4"],

Cell[BoxData[RowBox[{RowBox[
                   {"iprEvolutionData", "=", RowBox[
                     {"ComputeSpatialIPREvolution", "[", RowBox[
                       {"iprPlotEvolution", ",", "iprPlotInitial", ",", 
                        "120"}], "]"}]}], ";", RowBox[{"{", RowBox[
                     {RowBox[{"\"N\[UAcute]mero de muestras\"", "\[Rule]", 
                        RowBox[{"Length", "[", "iprEvolutionData", "]"}]}], 
                      ",", RowBox[{"\"Primera muestra\"", "\[Rule]", 
                        RowBox[{"First", "[", "iprEvolutionData", "]"}]}], 
                      ",", RowBox[{"\"\[CapitalUAcute]ltima muestra\"", 
                        "\[Rule]", RowBox[{"Last", "[", "iprEvolutionData", 
                          "]"}]}]}], "}"}]}]], "Input", ExpressionUUID -> 
                "e047872b-6d41-4aec-a9e7-a19e226793d6"],

