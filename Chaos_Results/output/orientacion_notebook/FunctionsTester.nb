Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"totalPr", "=", 
    RowBox[{"Flatten", "[", "prDat", "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"corteR", "=", 
    RowBox[{
     RowBox[{"HistogramList", "[", 
      RowBox[{
      "totalPr", ",", "\"\<FreedmanDiaconis\>\"", ",", "\"\<PDF\>\""}], "]"}],
      "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rFiltrado", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"totalPr", ",", 
     RowBox[{
      RowBox[{"#", ">=", "corteR"}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fraccionExcluidaR", "=", 
    RowBox[{"N", "[", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"Length", "[", "rFiltrado", "]"}], "/", 
       RowBox[{"Length", "[", "totalPr", "]"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"ImgPrFiltrado", "=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "dataStyle", ",", "styles", ",", "histograma", ",", "curvas", ",", "r"}],
      "}"}], ",", 
    RowBox[{
     RowBox[{"dataStyle", "=", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"GrayLevel", "[", "0.7", "]"}], ",", 
        RowBox[{"Opacity", "[", "0.6", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"styles", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", "Dashed", ",", "Thick"}], "]"}], ",", 
        RowBox[{"Directive", "[", 
         RowBox[{"Blue", ",", "Thick"}], "]"}], ",", 
        RowBox[{"Directive", "[", 
         RowBox[{"Red", ",", "Thick"}], "]"}], ",", 
        RowBox[{"Directive", "[", 
         RowBox[{"Purple", ",", "Thick"}], "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"histograma", "=", 
      RowBox[{"Histogram", "[", 
       RowBox[{
       "rFiltrado", ",", "\"\<FreedmanDiaconis\>\"", ",", "\"\<PDF\>\"", ",", 
        
        RowBox[{"ChartStyle", "->", "dataStyle"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"curvas", "=", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "/", 
