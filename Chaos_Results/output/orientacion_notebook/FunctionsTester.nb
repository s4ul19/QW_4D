Cell["\<\
Conserva estos identificadores peque\[NTilde]os para recuperar los trabajos \
despu\[EAcute]s de limpiar el kernel. Este archivo local contiene \
identificadores y rutas, no los espectros.\
\>", "Text",ExpressionUUID->"952fab37-570e-4288-81bd-b624ba50632d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"AllTrue", "[", 
    RowBox[{"jobs", ",", "AssociationQ"}], "]"}], ",", 
   RowBox[{"Export", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], 
        ",", "\"\<NodeJobs-current-handles.wxf\>\""}], "}"}], "]"}], ",", 
     "jobs", ",", "\"\<WXF\>\""}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[50]:=",ExpressionUUID->"6910d0e0-5c8a-496e-be16-ed71bd7bfadb"],

Cell[BoxData["\<\"/Users/saul/Desktop/ChatGPT/QWProgramming/NodeJobs-current-\
handles.wxf\"\>"], "Output",
