Cell[CellGroupData[{

Cell["5. Descargar y analizar", "Section",ExpressionUUID->"45a48817-5f36-4f4b-9b82-71155d529141"],

Cell["\<\
Ejecuta cuando todos los ResultReady sean True. Los resultados vuelven por \
SCP; si falla la descarga, puedes repetirla sin recalcular. Los originales \
permanecen en el disco de Mazinger.\
\>", "Text",ExpressionUUID->"f1877bf1-bf62-4c7a-81bb-1d7f0e553945"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"estados", "=", 
    RowBox[{"NodeJobStatus", "/@", "jobs"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"AllTrue", "[", 
     RowBox[{"estados", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"AssociationQ", "[", "#", "]"}], "&&", 
        RowBox[{"TrueQ", "[", 
         RowBox[{"#", "[", "\"\<ResultReady\>\"", "]"}], "]"}]}], "&"}]}], 
     "]"}], ",", 
    RowBox[{
     RowBox[{"resultadosPorNodo", "=", 
      RowBox[{"FetchNodeJobResults", "/@", "jobs"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{"resultadosPorNodo", ",", "ListQ"}], "]"}], ",", 
       RowBox[{
        RowBox[{"curvaR", "=", 
         RowBox[{"SortBy", "[", 
          RowBox[{
           RowBox[{"Join", "@@", "resultadosPorNodo"}], ",", "First"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Puntos recuperados: \>\"", ",", 
          RowBox[{"Length", "[", "curvaR", "]"}]}], "]"}]}], ",", 
       RowBox[{
       "Print", 
        "[", "\"\<Una descarga fall\[OAcute]. Revisa resultadosPorNodo.\>\"", 
        "]"}]}], "]"}]}], ",", 
    RowBox[{
    "Print", "[", "\"\<A\[UAcute]n no est\[AAcute]n listos todos los \
trabajos.\>\"", "]"}]}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{4.00013560535078*^9, 4.000135622963455*^9}},
 CellLabel->"In[61]:=",ExpressionUUID->"8f85b978-d98d-45b1-aca4-2075d1d902f4"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Puntos recuperados: \"\>", "\[InvisibleSpace]", "235"}],
  SequenceForm["Puntos recuperados: ", 235],
  Editable->False]], "Print",
 CellChangeTimes->{4.0000541186374474`*^9, 4.000056073679145*^9, 
  4.000061084668599*^9, 4.000136466142294*^9},
 CellLabel->
