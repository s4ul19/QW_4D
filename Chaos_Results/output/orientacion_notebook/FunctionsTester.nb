                         "\n"}], "\[IndentingNewLine]", RowBox[{RowBox[
                          {"coinMatrix", "=", RowBox[{"N", "[", RowBox[
                          {"RandomMatrix", "[", "\"b\"", "]"}], "]"}]}], 
                         ";"}], "\n", RowBox[{RowBox[{RowBox[{"S", "=", 
                          RowBox[{"BuildShiftOperators", "[", RowBox[{"grid", 
                          ",", RowBox[{"CoinDimension", "->", "4"}]}], 
