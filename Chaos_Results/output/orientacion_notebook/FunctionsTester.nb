  RowBox[{"Lx", "=", "140"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Ly", "=", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grid", "=", 
   RowBox[{"GenerateSinaiBasis", "[", 
    RowBox[{"Lx", ",", "Ly"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pos", "=", 
    RowBox[{"{", 
     RowBox[{"115", ",", "45"}], "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"coin", "=", 
   RowBox[{"N", "[", 
    RowBox[{"Normalize", "[", 
     RowBox[{"HaarRandomState", "[", "4", "]"}], "]"}], "]"}]}], ";"}], "\n", 

 RowBox[{
  RowBox[{
   RowBox[{"initialState", "=", 
    RowBox[{"LocalizedState", "[", 
     RowBox[{"grid", ",", "pos", ",", "coin"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Tmax", "=", "2000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"names", "=", 
    RowBox[{"RandomMatrixNames", "[", "]"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Evoluci\[OAcute]n", " ", "de", " ", "la", " ", "IPR", " ", "para", " ", 
    "cada", " ", "tipo", " ", "de", " ", "moneda"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"iprTotDat", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"c", "=", 
          RowBox[{"N", "[", 
           RowBox[{"RandomMatrix", "[", "name", "]"}], "]"}]}], ",", 
         "evolutionOp", ",", 
         RowBox[{"state", "=", 
          RowBox[{"N", "[", 
           RowBox[{"Normal", "[", "initialState", "]"}], "]"}]}], ",", 
         "ipr"}], "}"}], ",", 
       RowBox[{
        RowBox[{"evolutionOp", "=", 
         RowBox[{"QWEvolutionOperator", "[", 
          RowBox[{"grid", ",", "c"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ipr", "=", 
            RowBox[{"ComputeTotalIPR", "[", "state", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"t", "<", "Tmax"}], ",", 
             RowBox[{"state", "=", 
              RowBox[{"evolutionOp", ".", "state"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", "ipr"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "Tmax"}], "}"}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"name", ",", "names"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
