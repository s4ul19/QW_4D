Cell[BoxData[{
 RowBox[{
  RowBox[{"jobs", "=", 
   RowBox[{"Import", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], 
        ",", "\"\<NodeJobs-current-handles.wxf\>\""}], "}"}], "]"}], 
     ",", "\"\<WXF\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"estados", "=", 
   RowBox[{"NodeJobStatus", "/@", "jobs"}]}], ";", 
  RowBox[{"Dataset", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"KeyTake", "[", 
       RowBox[{"#1", ",", 
        RowBox[{"{", 
