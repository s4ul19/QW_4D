Cell[CellGroupData[{

Cell["5. Descargar y analizar", "Section",ExpressionUUID->"2fa62b4b-cccc-4f05-ae89-f482eae3ed86"],

Cell["\<\
Ejecuta cuando todos los ResultReady sean True. Los resultados vuelven por \
SCP; si falla la descarga, puedes repetirla sin recalcular. Los originales \
permanecen en el disco de Mazinger.\
\>", "Text",ExpressionUUID->"45277ff0-fb8f-428f-8236-a73802239fbe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"estados", "=", 
    RowBox[{"NodeJobStatus", "/@", "jobs"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"AllTrue", "[", 
     RowBox[{"estados", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"AssociationQ", "[", "#", "]"}], "&&", 
        RowBox[{"TrueQ", "[", 
         RowBox[{"#", "[", "\"\<ResultReady\>\"", "]"}], "]"}]}], "&"}]}], 
     "]"}], ",", 
    RowBox[{
     RowBox[{"resultadosPorNodo", "=", 
      RowBox[{"FetchNodeJobResults", "/@", "jobs"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{"resultadosPorNodo", ",", "ListQ"}], "]"}], ",", 
       RowBox[{
        RowBox[{"curvaR", "=", 
         RowBox[{"SortBy", "[", 
          RowBox[{
           RowBox[{"Join", "@@", "resultadosPorNodo"}], ",", "First"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Puntos recuperados: \>\"", ",", 
          RowBox[{"Length", "[", "curvaR", "]"}]}], "]"}]}], ",", 
       RowBox[{
       "Print", 
        "[", "\"\<Una descarga fall\[OAcute]. Revisa resultadosPorNodo.\>\"", 
        "]"}]}], "]"}]}], ",", 
    RowBox[{
    "Print", "[", "\"\<A\[UAcute]n no est\[AAcute]n listos todos los \
trabajos.\>\"", "]"}]}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{4.00013560535078*^9, 4.000135622963455*^9}},
 CellLabel->"In[88]:=",ExpressionUUID->"9a4bdeaa-43e3-4727-972b-a6df98e9cf55"],

