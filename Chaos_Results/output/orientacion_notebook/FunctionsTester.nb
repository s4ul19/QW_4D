                         ";"}], "\n", RowBox[{RowBox[{"Ly", "=", "80"}], 
                         ";"}], "\n", RowBox[{RowBox[{"grid", "=", RowBox[
                          {"GenerateRectangleBasis", "[", RowBox[{"Lx", ",", 
                          "Ly"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
                       "\n", RowBox[{RowBox[{"coinMatrix", "=", RowBox[
                          {"N", "[", RowBox[{"RandomMatrix", "[", "\"upu\"", 
                          "]"}], "]"}]}], ";"}], "\n", RowBox[{RowBox[
                          {"S", "=", RowBox[{"BuildShiftOperators", "[", 
                          RowBox[{"grid", ",", RowBox[{"CoinDimension", "->", 
                          "4"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
                       "\n", RowBox[{RowBox[{"U", "=", RowBox[{"N", "[", 
                          RowBox[{"QWEvolutionOperator", "[", RowBox[{"grid", 
                          ",", RowBox[{"SparseArray", "[", "coinMatrix", 
                          "]"}]}], "]"}], "]"}]}], ";"}], 
                       "\[IndentingNewLine]", "\[IndentingNewLine]", 
                       RowBox[{"(*", RowBox[{"Seis", " ", "intervalos", " ", 
                          "y", " ", "sus", " ", "centros"}], "*)"}], "\n", 
