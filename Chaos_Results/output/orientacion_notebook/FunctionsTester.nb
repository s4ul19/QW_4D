Cell[CellGroupData[{

Cell["5. Descargar y analizar", "Section",ExpressionUUID->"1856c998-feb1-49c9-ad6d-df0b6497841e"],

Cell["\<\
Ejecuta cuando todos los ResultReady sean True. Los resultados vuelven por \
SCP; si falla la descarga, puedes repetirla sin recalcular. Los originales \
permanecen en el disco de Mazinger.\
\>", "Text",ExpressionUUID->"fccc3c21-97ee-4b4b-9420-9af33236a84e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"resultadosPorNodo", "=", 
    RowBox[{"FetchNodeJobResults", "/@", "jobs"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"AllTrue", "[", 
    RowBox[{"resultadosPorNodo", ",", "ListQ"}], "]"}], ",", 
   RowBox[{
    RowBox[{"datos", "=", 
     RowBox[{"Join", "@@", "resultadosPorNodo"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"tamanosCalculados", "=", 
     RowBox[{"Lookup", "[", 
      RowBox[{"datos", ",", "\"\<Tamano\>\""}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"espectros", "=", 
     RowBox[{"Lookup", "[", 
      RowBox[{"datos", ",", "\"\<ValoresPropios\>\""}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"phasesDat", "=", 
     RowBox[{"Arg", "/@", "espectros"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"energiasDat", "=", 
     RowBox[{"-", "phasesDat"}]}], ";"}], ",", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Una descarga fall\[OAcute] o alg\[UAcute]n trabajo \
a\[UAcute]n no est\[AAcute] listo. \>\"", 
     ",", "\"\<Revisa resultadosPorNodo.\>\""}], "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.000062148368062*^9, 4.00006217196469*^9}, {
   4.000062227484922*^9, 4.00006222776015*^9}, 4.0000626721451397`*^9},
 CellLabel->"In[86]:=",ExpressionUUID->"f3e4b1cc-0646-4f4d-9c1a-d29a7fd9b319"],

