                          ";", "\[IndentingNewLine]", RowBox[{"Abort", "[", 
                          "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
                          RowBox[{"{", RowBox[{RowBox[{"First", "[", "vals", 
                          "]"}], ",", "psi", ",", "phase", ",", "residual"}], 
                          "}"}]}]}], "]"}], ",", RowBox[{"{", RowBox[{"j", 
                          ",", "k"}], "}"}]}], "]"}]}], ";"}], "\n", 
                       "\[IndentingNewLine]", RowBox[{RowBox[{"eigenvalues", 
