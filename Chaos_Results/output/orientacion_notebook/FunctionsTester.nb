                          "[", RowBox[{"[", RowBox[{"All", ",", "3"}], "]"}], 
                          "]"}]}], ";"}], "\n", RowBox[{RowBox[{"residuals", 
                          "=", RowBox[{"eigenData", "[", RowBox[{"[", RowBox[
                          {"All", ",", "4"}], "]"}], "]"}]}], ";"}], "\n", 
                       "\[IndentingNewLine]", RowBox[{RowBox[{"densities", 
                          "=", RowBox[{RowBox[{RowBox[{
                          "ComputeSpatialIPRDensity", "[", RowBox[{"#", ",", 
                          "4"}], "]"}], "&"}], "/@", "eigenvectors"}]}], 
                         ";"}], "\n", RowBox[{RowBox[{"iprValues", "=", 
                          RowBox[{"Total", "/@", "densities"}]}], ";"}], 
                       "\[IndentingNewLine]", "\[IndentingNewLine]", 
