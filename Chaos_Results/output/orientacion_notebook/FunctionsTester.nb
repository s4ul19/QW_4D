                          {RowBox[{"Max", "[", RowBox[{"0", ",", RowBox[
                          {"yMin", "-", "margin"}]}], "]"}], ",", RowBox[
                          {"Min", "[", RowBox[{RowBox[{"1.05", " ", "sMax"}], 
                          ",", RowBox[{"yMax", "+", "margin"}]}], "]"}]}], 
                          "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
                          RowBox[{RowBox[{"fullPlot", "=", RowBox[
                          {"ListLinePlot", "[", RowBox[{"entropyDat", ",", 
                          RowBox[{"PlotStyle", "->", "styles"}], ",", RowBox[
