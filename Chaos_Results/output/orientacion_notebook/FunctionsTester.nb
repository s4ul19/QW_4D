Cell[CellGroupData[{

Cell["1. Estado o probabilidades: misma imagen", 
            "Section", CellChangeTimes -> {{3.9994747917995367*^9, 
               3.9994748115531263*^9}}, ExpressionUUID -> 
             "0d496d95-e973-4f2d-8608-5144c560d68e"],

Cell[BoxData[{RowBox[{RowBox[{"grid", "=", 
                     RowBox[{"GenerateRectangleBasis", "[", RowBox[{"8", ",", 
                         "5"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
                 RowBox[{RowBox[{"coin", "=", RowBox[{"Normalize", "[", 
                       RowBox[{"{", RowBox[{"1", ",", "\[ImaginaryI]", ",", 
                          RowBox[{"-", "1"}], ",", "0"}], "}"}], "]"}]}], 
                   ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{"psi", "=", 
                     RowBox[{"GaussianState", "[", RowBox[{"grid", ",", 
                         RowBox[{"{", RowBox[{"2", ",", "3"}], "}"}], ",", 
                         "coin", ",", "1.2`"}], "]"}]}], ";"}], 
                 "\[IndentingNewLine]", RowBox[{RowBox[{"probabilities", "=", 
                     RowBox[{"Total", "[", RowBox[{RowBox[{"Partition", "[", 
                          RowBox[{SuperscriptBox[RowBox[{"Abs", "[", RowBox[
                          {"Normal", "[", "psi", "]"}], "]"}], "2"], ",", 
                          "4"}], "]"}], ",", RowBox[{"{", "2", "}"}]}], 
                       "]"}]}], ";"}], "\[IndentingNewLine]", RowBox[
                  {RowBox[{"statePlot", "=", RowBox[
                      {"DiscreteProbabilityPlot", "[", RowBox[{"grid", ",", 
                         "psi", ",", RowBox[{"InputType", "\[Rule]", 
                          "\"State\""}], ",", RowBox[{"PlotLegends", 
                          "\[Rule]", "None"}]}], "]"}]}], ";"}], 
                 "\[IndentingNewLine]", RowBox[{RowBox[{"probabilityPlot", 
                     "=", RowBox[{"DiscreteProbabilityPlot", "[", RowBox[
                        {"grid", ",", "probabilities", ",", RowBox[
                          {"PlotLegends", "\[Rule]", "None"}]}], "]"}]}], 
                   ";"}], "\[IndentingNewLine]", RowBox[{"{", RowBox[
                    {RowBox[{"statePlot", "===", "probabilityPlot"}], ",", 
                     RowBox[{"Total", "[", "probabilities", "]"}]}], "}"}]}], 
               "Input", CellChangeTimes -> {3.999474839674062*^9}, 
               ExpressionUUID -> "4ac9b485-7fc1-4e99-aa0e-985ed58cbecd"],

Cell[BoxData[RowBox[{"GraphicsRow", 
                  "[", RowBox[{RowBox[{"{", RowBox[{RowBox[
                         {"DiscreteProbabilityPlot", "[", RowBox[{"grid", 
                          ",", "psi", ",", RowBox[{"InputType", "\[Rule]", 
                          "\"State\""}], ",", RowBox[{"PlotLabel", "\[Rule]", 
                          "\"Desde amplitudes\""}], ",", RowBox[{"ImageSize", 
                          "\[Rule]", "360"}]}], "]"}], ",", RowBox[
                         {"DiscreteProbabilityPlot", "[", RowBox[{"grid", 
                          ",", "probabilities", ",", RowBox[{"PlotLabel", 
                          "\[Rule]", "\"Desde probabilidades\""}], ",", 
                          RowBox[{"ColorFunction", "->", "\"DarkRainbow\""}], 
                          ",", RowBox[{"ImageSize", "\[Rule]", "360"}]}], 
                          "]"}]}], "}"}], ",", RowBox[{"ImageSize", 
                      "\[Rule]", "900"}]}], "]"}]], "Input", 
               CellChangeTimes -> {{3.9994745833775454*^9, 
