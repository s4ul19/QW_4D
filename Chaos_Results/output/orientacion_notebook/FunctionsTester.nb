Cell["\<\
Env\[IAcute]a un lote a cada nodo, consulta el estado y descarga los \
resultados cuando est\[EAcute]n listos. La Mac no mantiene una \
conexi\[OAcute]n durante el c\[AAcute]lculo. Ejecuta las secciones por \
separado.\
\>", "Text",ExpressionUUID->"d54a8864-6418-458d-b8bc-14e01ef373ad"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Cancelar un trabajo, si lo necesitas", "Section",ExpressionUUID->"5417f714-6b26-4593-ba05-377f8d7dd1fb"],

Cell["\<\
Abortar una celda de la Mac no detiene un trabajo independiente. Para \
solicitar cancelar \[UAcute]nicamente el cuarto trabajo, eval\[UAcute]a \
CancelNodeJob[jobs[[4]]] en una celda nueva y consulta despu\[EAcute]s su \
estado. Los archivos que ya se guardaron se conservan.\
\>", "Text",ExpressionUUID->"c210861a-bf88-4c03-bf6b-639c3a374e6c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
C\[AAcute]lculos independientes  quitando estados de borde en Mazinger\
\>", "Chapter",
 CellChangeTimes->{{4.000056490171199*^9, 
  4.000056494913505*^9}},ExpressionUUID->"870cbf90-3587-4610-ac53-\
c91eea33fca3"],

Cell[CellGroupData[{

Cell[" Preparar los datos y la funci\[OAcute]n", "Section",
 CellChangeTimes->{{4.0000524848677397`*^9, 
  4.000052485791286*^9}},ExpressionUUID->"4bfec94c-ed55-4eab-bfca-\
7a2e30219f8e"],

Cell["\<\
Estos tama\[NTilde]os y cantidades son un ejemplo para 235 monedas. Puedes \
conservar los valores y funciones que ya definiste en FunctionsTester.nb. \
PrepararQuantumWalks carga las dependencias en cada trabajador remoto.\
\>", "Text",ExpressionUUID->"db07a340-cb29-42ed-b5bf-3aa80433add5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"n1", "=", "50"}], ";", 
  RowBox[{"n2", "=", "50"}], ";", 
  RowBox[{"n3", "=", "75"}], ";", 
  RowBox[{"n4", "=", "60"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "115", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"monedas", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"N", "[", 
       RowBox[{"RandomMatrix", "[", "\"\<o\>\"", "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"n1", "+", "n2", "+", "n3", "+", "n4"}], "}"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"calcularEspectro", "=", 
    RowBox[{"Function", "[", 
     RowBox[{"moneda", ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "grid", ",", "dim", ",", "s", ",", "u", ",", "valores", ",", 
          "vectores", ",", "coords", ",", "xmin", ",", "xmax", ",", "ymin", ",",
           "ymax", ",", "distancias", ",", "sitiosBorde", ",", "pesosBorde", ",", 
          RowBox[{"anchoBorde", "=", "2"}], ",", 
          RowBox[{"umbralBorde", "=", "0.6"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"grid", "=", 
          RowBox[{"GenerateRectangleBasis", "[", 
           RowBox[{"35", ",", "25"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"dim", "=", 
          RowBox[{"grid", "[", "\"\<Dimension\>\"", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"s", "=", 
          RowBox[{"BuildShiftOperators", "[", 
           RowBox[{"grid", ",", 
            RowBox[{"CoinDimension", "->", "4"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"u", "=", 
          RowBox[{"s", ".", 
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{
             RowBox[{"IdentityMatrix", "[", 
              RowBox[{"dim", ",", "SparseArray"}], "]"}], ",", 
             RowBox[{"SparseArray", "[", "moneda", "]"}]}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"valores", ",", "vectores"}], "}"}], "=", 
          RowBox[{"Eigensystem", "[", 
           RowBox[{"Normal", "[", "u", "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Sitios", " ", "pertenecientes", " ", "a", " ", "las", " ", "capas",
            " ", "exteriores"}], "*)"}], 
         RowBox[{"coords", "=", 
          RowBox[{"grid", "[", "\"\<Coords\>\"", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"xmin", ",", "xmax"}], "}"}], "=", 
          RowBox[{"MinMax", "[", 
           RowBox[{"coords", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ymin", ",", "ymax"}], "}"}], "=", 
          RowBox[{"MinMax", "[", 
           RowBox[{"coords", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"distancias", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Min", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "-", "xmin"}], ",", 
               RowBox[{"xmax", "-", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ",", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "-", "ymin"}], ",", 
               RowBox[{"ymax", "-", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], "&"}], ")"}], "/@",
            "coords"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"sitiosBorde", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Position", "[", 
            RowBox[{"distancias", ",", 
             RowBox[{"d_Integer", "/;", 
              RowBox[{"d", "<", "anchoBorde"}]}]}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Probabilidad", " ", "en", " ", "el", " ", "borde", " ", "para", " ",
            "cada", " ", "eigenvector"}], "*)"}], 
         RowBox[{"pesosBorde", "=", 
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{"v", ",", 
             RowBox[{"Module", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"p", "=", 
                 RowBox[{"Total", "[", 
                  RowBox[{
                   RowBox[{"Partition", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "v", "]"}], "^", "2"}], ",", "4"}], 
                    "]"}], ",", 
                   RowBox[{"{", "2", "}"}]}], "]"}]}], "}"}], ",", 
               RowBox[{
                RowBox[{"Total", "[", 
                 RowBox[{"p", "[", 
                  RowBox[{"[", "sitiosBorde", "]"}], "]"}], "]"}], "/", 
                RowBox[{"Total", "[", "p", "]"}]}]}], "]"}]}], "]"}], "/@", 
           "vectores"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Conservar", " ", "eigenvalores", " ", "de", " ", "estados", " ", 
           "bajo", " ", "el", " ", "umbral"}], "*)"}], 
         RowBox[{"Pick", "[", 
          RowBox[{"valores", ",", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "<", "umbralBorde"}], "&"}], "/@", "pesosBorde"}], 
            ")"}], ",", "True"}], "]"}]}]}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"prepararQuantumWalks", "=", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"path", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Replace", "[", 
            RowBox[{
             RowBox[{"Environment", "[", "\"\<QW_PROJECT_ROOT\>\"", "]"}], ",", 
             RowBox[{
              RowBox[{"Except", "[", "_String", "]"}], "\[RuleDelayed]", 
              RowBox[{"FileNameJoin", "[", 
               RowBox[{"{", 
                RowBox[{"$HomeDirectory", ",", "\"\<QW\>\""}], "}"}], 
               "]"}]}]}], "]"}], ",", "\"\<JA_libs\>\"", 
           ",", "\"\<QuantumWalks\>\""}], "}"}], "]"}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"PacletDirectoryLoad", "[", "path", "]"}], ";", 
       RowBox[{"Needs", "[", "\"\<ForScience`\>\"", "]"}], ";", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"FormatUsage", "=", "Identity"}], "}"}], ",", 
         RowBox[{"Needs", "[", "\"\<QuantumWalks`\>\"", "]"}]}], "]"}], ";", 
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"DownValues", "[", "GenerateRectangleBasis", "]"}], "]"}], ">",
         "0"}]}]}], "]"}], "&"}]}], ";", 
  RowBox[{"trabajos", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<nodo1\>\"", ",", "15", ",", 
       RowBox[{"monedas", "\[LeftDoubleBracket]", 
        RowBox[{"1", ";;", "n1"}], "\[RightDoubleBracket]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<nodo2\>\"", ",", "10", ",", 
       RowBox[{"monedas", "\[LeftDoubleBracket]", 
        RowBox[{
         RowBox[{"n1", "+", "1"}], ";;", 
         RowBox[{"n1", "+", "n2"}]}], "\[RightDoubleBracket]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<nodo3\>\"", ",", "12", ",", 
       RowBox[{"monedas", "\[LeftDoubleBracket]", 
        RowBox[{
         RowBox[{"n1", "+", "n2", "+", "1"}], ";;", 
         RowBox[{"n1", "+", "n2", "+", "n3"}]}], "\[RightDoubleBracket]"}]}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<nodo4\>\"", ",", "6", ",", 
       RowBox[{"monedas", "\[LeftDoubleBracket]", 
        RowBox[{
         RowBox[{"n1", "+", "n2", "+", "n3", "+", "1"}], ";;", 
         RowBox[{"n1", "+", "n2", "+", "n3", "+", "n4"}]}], 
        "\[RightDoubleBracket]"}]}], "}"}]}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.0000547151829453`*^9, 4.000054716375059*^9}, {
   4.000056513636574*^9, 4.000056521544887*^9}, {4.000056567452814*^9, 
   4.0000565806347647`*^9}, 4.0000566212986193`*^9},
 CellLabel->"In[2]:=",ExpressionUUID->"ae422d1c-46f9-4782-9987-64d91e42c3c4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Enviar los cuatro trabajos", "Section",ExpressionUUID->"b89e7d7b-ef4a-40d7-ad66-1b1b5e0a8457"],

Cell["\<\
La celda termina cuando los nodos aceptan los trabajos. Despu\[EAcute]s \
puedes usar o cerrar la Mac. No vuelvas a ejecutar esta celda para consultar \
el avance: cada env\[IAcute]o crea un trabajo nuevo.\
\>", "Text",ExpressionUUID->"08e2193c-9467-40ba-a888-941896e8c73a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"jobs", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"SubmitNodeJob", "[", 
      RowBox[{
       RowBox[{"#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
       RowBox[{"#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",",
        "calcularEspectro", ",", 
       RowBox[{"#1", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], ",",
        "prepararQuantumWalks"}], "]"}], "&"}], ")"}], "/@", 
   "trabajos"}]}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"148fc015-7507-4b23-8247-4dd10dca733d"],

