                          ",", RowBox[{"Line", "[", RowBox[{"{", RowBox[
                          {RowBox[{"{", RowBox[{"0", ",", "sMax"}], "}"}], 
                          ",", RowBox[{"{", RowBox[{"Tmax", ",", "sMax"}], 
                          "}"}]}], "}"}], "]"}], ",", RowBox[{"Inset", "[", 
                          RowBox[{RowBox[{"Style", "[", RowBox[{
