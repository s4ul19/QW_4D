           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"ComputeTotalIPR[StateVector] returns the IPR in the \
full computational (position-coin) basis, Sum[Abs[psi_b]^4, b], for the \
internally normalized state. Each coin amplitude contributes separately. \
Dense and sparse numeric vectors are accepted; no coin dimension is needed.\"\
\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
