                          ",", RowBox[{"PlotLabel", "->", "\"Entrop\[IAcute]a \
de entrelazamiento moneda\[Dash]posici\[OAcute]n\""}], ",", RowBox[
                          {"PlotRange", "->", RowBox[{"{", RowBox[{RowBox[
                          {"{", RowBox[{"0", ",", "Tmax"}], "}"}], ",", 
                          RowBox[{"{", RowBox[{"0.5", ",", RowBox[{"1.05", 
                          " ", "sMax"}]}], "}"}]}], "}"}]}], ",", RowBox[
                          {"GridLines", "->", RowBox[{"{", RowBox[
                          {"Automatic", ",", RowBox[{"{", RowBox[{"Log", "[", 
                          "2", "]"}], "}"}]}], "}"}]}], ",", RowBox[
