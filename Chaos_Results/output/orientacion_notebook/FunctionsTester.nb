Cell["\<\
Conserva estos identificadores peque\[NTilde]os para recuperar los trabajos \
despu\[EAcute]s de limpiar el kernel. Este archivo local contiene \
identificadores y rutas, no los espectros.\
\>", "Text",ExpressionUUID->"eeb09047-6537-4477-92f4-b91fdc743e20"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"AllTrue", "[", 
    RowBox[{"jobs", ",", "AssociationQ"}], "]"}], ",", 
   RowBox[{"Export", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], 
        ",", "\"\<NodeJobs-current-handles.wxf\>\""}], "}"}], "]"}], ",", 
     "jobs", ",", "\"\<WXF\>\""}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[63]:=",ExpressionUUID->"57b5068b-056b-45e0-a37e-f4bb626b9f78"],

