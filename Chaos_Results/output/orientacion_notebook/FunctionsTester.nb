Cell["\<\
Env\[IAcute]a un lote a cada nodo, consulta el estado y descarga los \
resultados cuando est\[EAcute]n listos. La Mac no mantiene una \
conexi\[OAcute]n durante el c\[AAcute]lculo. Ejecuta las secciones por \
separado.\
\>", "Text",ExpressionUUID->"a9e49b60-1b69-4201-9311-6d0663c9ae8b"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Cancelar un trabajo, si lo necesitas", "Section",ExpressionUUID->"db01b0c1-e6df-4799-85b3-79bd447c5128"],

Cell["\<\
Abortar una celda de la Mac no detiene un trabajo independiente. Para \
solicitar cancelar \[UAcute]nicamente el cuarto trabajo, eval\[UAcute]a \
CancelNodeJob[jobs[[4]]] en una celda nueva y consulta despu\[EAcute]s su \
estado. Los archivos que ya se guardaron se conservan.\
\>", "Text",ExpressionUUID->"1355cdc8-00c0-4ca6-bfdf-65ca2f1476b2"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Sinai", "Chapter",
 CellChangeTimes->{{4.0001300051486683`*^9, 
  4.000130017829286*^9}},ExpressionUUID->"020c8c8a-7134-4d7e-aeb7-\
f0c218afc0c8"],

Cell[CellGroupData[{

Cell[" Preparar los datos y la funci\[OAcute]n", "Section",
 CellChangeTimes->{{4.0000524848677397`*^9, 
  4.000052485791286*^9}},ExpressionUUID->"ba348db3-e0f9-410f-a78a-\
0a8383939d47"],

Cell["\<\
Estos tama\[NTilde]os y cantidades son un ejemplo para 235 monedas. Puedes \
conservar los valores y funciones que ya definiste en FunctionsTester.nb. \
PrepararQuantumWalks carga las dependencias en cada trabajador remoto.\
\>", "Text",ExpressionUUID->"8ac28cff-9571-484d-bd38-a1d8ce68ba64"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Una", " ", "\[UAcute]nica", " ", "moneda", " ", "para", " ", "todos", " ",
     "los", " ", "tama\[NTilde]os"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "115", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"monedaFija", "=", 
     RowBox[{"N", "[", 
      RowBox[{"RandomMatrix", "[", "\"\<b\>\"", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"tamanos", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"49", ",", "37"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"48", ",", "37"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"48", ",", "36"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"50", ",", "37"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"50", ",", "38"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"49", ",", "36"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"49", ",", "38"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"crearGeometria", "=", 
     RowBox[{"Function", "[", 
      RowBox[{"tamano", ",", 
       RowBox[{"GenerateSinaiBasis", "@@", "tamano"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"prepararQuantumWalks", "=", 
     RowBox[{"Function", "[", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "path", "}"}], ",", 
        RowBox[{
         RowBox[{"path", "=", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Replace", "[", 
              RowBox[{
               RowBox[{"Environment", "[", "\"\<QW_PROJECT_ROOT\>\"", "]"}], ",", 
               RowBox[{
                RowBox[{"Except", "[", "_String", "]"}], ":>", 
                RowBox[{"FileNameJoin", "[", 
                 RowBox[{"{", 
                  RowBox[{"$HomeDirectory", ",", "\"\<QW\>\""}], "}"}], 
                 "]"}]}]}], "]"}], ",", "\"\<JA_libs\>\"", 
             ",", "\"\<QuantumWalks\>\""}], "}"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"PacletDirectoryLoad", "[", "path", "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Needs", "[", "\"\<ForScience`\>\"", "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Block", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ForScience`PacletUtils`FormatUsage", "=", "Identity"}], 
            "}"}], ",", 
           RowBox[{"Needs", "[", "\"\<QuantumWalks`\>\"", "]"}]}], "]"}], ";",
          "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{
           "DownValues", "[", "QuantumWalks`Billiards`GenerateSinaiBasis", 
            "]"}], "]"}], ">", "0"}]}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Incorporar", " ", "la", " ", "moneda", " ", "y", " ", "el", " ", 
     "constructor", " ", "a", " ", "la", " ", "funci\[OAcute]n", " ", 
     "remota"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"calcularPorTamano", "=", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"moneda", "=", "monedaFija"}], ",", 
         RowBox[{"construir", "=", "crearGeometria"}]}], "}"}], ",", 
       RowBox[{"Function", "[", 
        RowBox[{"tamano", ",", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"grid", ",", "dim", ",", "s", ",", "u", ",", "valores"}], 
            "}"}], ",", 
           RowBox[{
            RowBox[{"grid", "=", 
             RowBox[{"construir", "[", "tamano", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"dim", "=", 
             RowBox[{"grid", "[", "\"\<Dimension\>\"", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"s", "=", 
             RowBox[{"BuildShiftOperators", "[", 
              RowBox[{"grid", ",", 
               RowBox[{"CoinDimension", "->", "4"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"u", "=", 
             RowBox[{"s", ".", 
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{
                RowBox[{"IdentityMatrix", "[", 
                 RowBox[{"dim", ",", "SparseArray"}], "]"}], ",", 
                RowBox[{"SparseArray", "[", "moneda", "]"}]}], "]"}]}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"valores", "=", 
             RowBox[{"Eigenvalues", "[", 
              RowBox[{"Normal", "[", "u", "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Tamano\>\"", "->", "tamano"}], ",", 
              RowBox[{"\"\<DimensionMatriz\>\"", "->", 
               RowBox[{"4", " ", "dim"}]}], ",", 
              RowBox[{"\"\<ValoresPropios\>\"", "->", "valores"}]}], 
             "|>"}]}]}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trabajos", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<nodo1\>\"", ",", "1", ",", 
         RowBox[{"tamanos", "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", "2"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<nodo2\>\"", ",", "1", ",", 
         RowBox[{"tamanos", "[", 
          RowBox[{"[", 
           RowBox[{"3", ";;", "4"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<nodo3\>\"", ",", "1", ",", 
         RowBox[{"tamanos", "[", 
          RowBox[{"[", 
           RowBox[{"5", ";;", "6"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<nodo4\>\"", ",", "1", ",", 
         RowBox[{"{", 
          RowBox[{"tamanos", "[", 
           RowBox[{"[", "7", "]"}], "]"}], "}"}]}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{4.0000547151829453`*^9, 4.000054716375059*^9}, {
  4.000059615440139*^9, 4.000059615730855*^9}, {4.000062083682863*^9, 
  4.000062111867709*^9}, {4.000062201493174*^9, 4.000062287776129*^9}, {
  4.0000623377678833`*^9, 4.000062338039393*^9}, {4.000062403424386*^9, 
  4.000062429032867*^9}, {4.000130426773656*^9, 4.0001304533317204`*^9}, {
  4.000130495697447*^9, 
  4.000130496182325*^9}},ExpressionUUID->"00b0e7df-0026-4c1b-8383-\
5c57e84705fe"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Enviar los cuatro trabajos", "Section",ExpressionUUID->"2ba0bfe3-ec7f-49e9-abf0-3f438accf016"],

Cell["\<\
La celda termina cuando los nodos aceptan los trabajos. Despu\[EAcute]s \
puedes usar o cerrar la Mac. No vuelvas a ejecutar esta celda para consultar \
el avance: cada env\[IAcute]o crea un trabajo nuevo.\
\>", "Text",ExpressionUUID->"62ba4a0f-2011-44d8-856a-8627c3a51644"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"jobs", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"SubmitNodeJob", "[", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", "calcularPorTamano", ",", 
       RowBox[{"#", "[", 
        RowBox[{"[", "3", "]"}], "]"}], ",", "prepararQuantumWalks"}], "]"}], 
     "&"}], "/@", "trabajos"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.000062115277989*^9, 4.0000621156951447`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"8ecf7f2c-fe89-4fce-b555-0e6ecae18319"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Submitting independent job: \"\>", 
   "\[InvisibleSpace]", "\<\"nodo1-498c76c8-988c-4c2a-8535-ca7087875b72\"\>"}],
