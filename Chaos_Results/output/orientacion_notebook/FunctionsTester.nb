Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"IPRdat", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"ComputeSpatialIPR", "[", 
       RowBox[{"#", ",", "4"}], "]"}], "&"}], "/@", "eigenvecs"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"indicesBorde", "=", 
   RowBox[{"borde", "[", "\"\<CandidateIndices\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"indicesOtros", "=", 
    RowBox[{"Complement", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"Length", "[", "IPRdat", "]"}], "]"}], ",", "indicesBorde"}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"iprBorde", "=", 
   RowBox[{"IPRdat", "[", 
    RowBox[{"[", "indicesBorde", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"iprOtros", "=", 
    RowBox[{"IPRdat", "[", 
     RowBox[{"[", "indicesOtros", "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Los", " ", "mismos", " ", "intervalos", " ", "del", " ", "histograma", " ",
     "original"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"limites", "=", 
   RowBox[{"First", "[", 
    RowBox[{"HistogramList", "[", 
     RowBox[{"IPRdat", ",", "\"\<FreedmanDiaconis\>\""}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Histogram", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"iprOtros", ",", "iprBorde"}], "}"}], ",", 
