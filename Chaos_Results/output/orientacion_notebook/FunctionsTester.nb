                    RowBox[{"Message", "[", 
                    StyleBox[
                    RowBox[{"COECoinGenerator", "::", "log"}], "MessageName"],
                     "]"}], ";", 
                    RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
                    RowBox[{"QuantumWalks`QWMisc`Private`k", "=", 
                    RowBox[{"Re", "[", 
                    RowBox[{
                    FractionBox["1", "2"], " ", 
                    RowBox[{"(", 
                    RowBox[{"QuantumWalks`QWMisc`Private`raw", "+", 
                    
                    RowBox[{"Transpose", "[", 
                    "QuantumWalks`QWMisc`Private`raw", "]"}]}], ")"}]}], 
                    "]"}]}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Max", "[", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"Flatten", "[", 
                    
                    RowBox[{"QuantumWalks`QWMisc`Private`raw", "-", 
                    "QuantumWalks`QWMisc`Private`k"}], "]"}], "]"}], "]"}], 
                    ">", "QuantumWalks`QWMisc`Private`tolerance"}], "||", 
                    RowBox[{
                    RowBox[{"Max", "[", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{
                    RowBox[{"MatrixExp", "[", 
