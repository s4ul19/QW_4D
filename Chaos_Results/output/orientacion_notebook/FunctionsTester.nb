                       RowBox[{RowBox[{RowBox[{"U", "=", RowBox[{"N", "[", 
                          RowBox[{"QWEvolutionOperator", "[", RowBox[{"grid", 
                          ",", RowBox[{"SparseArray", "[", "coinMatrix", 
                          "]"}]}], "]"}], "]"}]}], ";"}], 
                         "\[IndentingNewLine]", "\[IndentingNewLine]", 
                         RowBox[{"(*", RowBox[{"Par\[AAcute]metros", " ", 
                          "ajustables"}], "*)"}]}], "\n", RowBox[
                        {RowBox[{"k", "=", "10"}], ";"}], "\n", RowBox[
                        {RowBox[{"columns", "=", "3"}], ";"}], "\n", 
                       RowBox[{RowBox[{RowBox[{"epsilon0", "=", "0.4"}], 
                          ";"}], "\[IndentingNewLine]"}], "\n", RowBox[
                        {RowBox[{RowBox[{"sigma", "=", RowBox[{"1.001", " ", 
                          RowBox[{"Exp", "[", RowBox[{RowBox[{"-", "I"}], 
                          " ", "epsilon0"}], "]"}]}]}], ";"}], 
                         "\[IndentingNewLine]", "\[IndentingNewLine]", 
                         RowBox[{"(*", RowBox[{"Ajustar", " ", "la", " ", 
                          "base", " ", "de", " ", "Arnoldi", " ", "al", " ", 
                          "n\[UAcute]mero", " ", "solicitado"}], "*)"}]}], 
                       "\n", RowBox[{RowBox[{RowBox[{"basisSize", "=", 
                          RowBox[{"Min", "[", RowBox[{RowBox[{"Length", "[", 
                          "U", "]"}], ",", RowBox[{"Max", "[", RowBox[{"60", 
                          ",", RowBox[{RowBox[{"2", " ", "k"}], "+", 
                          "10"}]}], "]"}]}], "]"}]}], ";"}], 
                         "\[IndentingNewLine]"}], "\n", RowBox[{RowBox[
                          {RowBox[{RowBox[{"{", RowBox[{"eigenvalues", ",", 
                          "eigenvectors"}], "}"}], "=", RowBox[
                          {"Eigensystem", "[", RowBox[{"U", ",", RowBox[
                          {"-", "k"}], ",", RowBox[{"Method", "->", RowBox[
                          {"{", RowBox[{"\"Arnoldi\"", ",", RowBox[
                          {"\"Shift\"", "->", "sigma"}], ",", RowBox[
                          {"\"BasisSize\"", "->", "basisSize"}], ",", RowBox[
                          {"\"MaxIterations\"", "->", "5000"}], ",", RowBox[
                          {"\"Tolerance\"", "->", RowBox[{"10", "^", RowBox[
                          {"-", "10"}]}]}]}], "}"}]}]}], "]"}]}], ";"}], 
                         "\[IndentingNewLine]"}], "\n", RowBox[{RowBox[
                          {"eigenvectors", "=", RowBox[{"Normalize", "/@", 
