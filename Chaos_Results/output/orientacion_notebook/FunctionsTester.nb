                          "iprValues", "[", RowBox[{"[", "j", "]"}], "]"}], 
                          ",", "3"}], "]"}]}], "}"}], "]"}], ",", "11"}], 
                          "]"}], ",", RowBox[{"Style", "[", RowBox[{RowBox[
