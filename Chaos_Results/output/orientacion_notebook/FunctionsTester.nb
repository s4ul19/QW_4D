Cell[BoxData[{RowBox[{RowBox[{"u", "=", 
                          RowBox[{"UnfoldCircular", "[", "eigenphases", 
                          "]"}]}], ";"}], "\n", RowBox[{RowBox[{"orden", "=", 
                          RowBox[{"Ordering", "[", RowBox[{"Mod", "[", RowBox[
                          {RowBox[{RowBox[{"N", "[", "eigenphases", "]"}], 
                          "+", "Pi"}], ",", RowBox[{"2", " ", "Pi"}]}], 
                          "]"}], "]"}]}], ";"}], "\n", RowBox[{RowBox[
                          {"niveles", "=", RowBox[{RowBox[{"N", "[", RowBox[
                          {"u", "[", "\"UnfoldedLevels\"", "]"}], "]"}], "[", 
                          RowBox[{"[", "orden", "]"}], "]"}]}], ";"}], "\n", 
                       RowBox[{RowBox[{RowBox[{"sPs", "=", RowBox[
                          {"Differences", "[", RowBox[{"Append", "[", RowBox[
                          {"niveles", ",", RowBox[{RowBox[{"First", "[", 
                          "niveles", "]"}], "+", RowBox[{"Length", "[", 
                          "niveles", "]"}]}]}], "]"}], "]"}]}], ";"}], 
                         "\n"}], "\[IndentingNewLine]", RowBox[{RowBox[
                          {"angulos", "=", RowBox[{"Sort", "[", RowBox[
                          {"Mod", "[", RowBox[{RowBox[{RowBox[{"N", "[", 
                          "eigenphases", "]"}], "+", "Pi"}], ",", RowBox[
                          {"2", " ", "Pi"}]}], "]"}], "]"}]}], ";"}], "\n", 
                       RowBox[{RowBox[{RowBox[{"sPr", "=", RowBox[
                          {"Differences", "[", RowBox[{"Append", "[", RowBox[
                          {"angulos", ",", RowBox[{RowBox[{"First", "[", 
                          "angulos", "]"}], "+", RowBox[{"2", " ", 
                          "Pi"}]}]}], "]"}], "]"}]}], ";"}], "\n"}], 
                       "\[IndentingNewLine]", RowBox[{"<|", RowBox[
                          {RowBox[{"\"Espaciamientos P(s) no positivos\"", 
                          "->", RowBox[{"Count", "[", RowBox[{"sPs", ",", 
                          RowBox[{"x_", "/;", RowBox[{"x", "<=", "0"}]}]}], 
                          "]"}]}], ",", RowBox[{
                          "\"Espaciamientos P(r) no positivos\"", "->", 
                          RowBox[{"Count", "[", RowBox[{"sPr", ",", RowBox[
                          {"x_", "/;", RowBox[{"x", "<=", "0"}]}]}], "]"}]}], 
                          ",", RowBox[{"\"Espaciamientos P(r) casi nulos\"", 
                          "->", RowBox[{"Count", "[", RowBox[{"sPr", ",", 
                          RowBox[{"x_", "/;", RowBox[{"x", "<=", RowBox[
                          {"10", "^", RowBox[{"-", "12"}]}]}]}]}], "]"}]}]}], 
                         "|>"}]}], "Input", CellChangeTimes -> 
                      {{3.999601214550427*^9, 3.999601214550488*^9}}, 
                     ExpressionUUID -> 
                      "1629b064-3e37-4985-9fe5-5595bcc8585f"]
}, Closed]]
