                    RowBox[{"!", 
                    RowBox[{"MatrixQ", "[", 
                    
                    RowBox[{"QuantumWalks`QWMisc`Private`raw", ",", 
                    "QuantumWalks`QWMisc`Private`qwFiniteNumberQ"}], 
                    "]"}]}]}], ",", 
