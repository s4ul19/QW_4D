Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SeedRandom", "[", "23", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Malla", " ", "y", " ", "estado", " ", "inicial"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lx", "=", "140"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Ly", "=", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grid", "=", 
   RowBox[{"GenerateSinaiBasis", "[", 
    RowBox[{"Lx", ",", "Ly"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pos", "=", 
    RowBox[{"{", 
     RowBox[{"115", ",", "45"}], "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coin", "=", 
   RowBox[{"N", "[", 
    RowBox[{"Normalize", "[", 
     RowBox[{"HaarRandomState", "[", "4", "]"}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{"BuildShiftOperators", "[", 
    RowBox[{"grid", ",", 
     RowBox[{"CoinDimension", "->", "4"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"initialState", "=", 
    RowBox[{"LocalizedState", "[", 
     RowBox[{"grid", ",", "pos", ",", "coin"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Tmax", "=", "2000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nSites", "=", 
   RowBox[{"grid", "[", "\"\<Dimension\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"names", "=", 
    RowBox[{"RandomMatrixNames", "[", "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Evoluci\[OAcute]n", " ", "de", " ", "la", " ", "IPR", " ", "para", " ", 
    "cada", " ", "tipo", " ", "de", " ", "moneda"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"iprDat", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"c", "=", 
           RowBox[{"N", "[", 
            RowBox[{"RandomMatrix", "[", "#", "]"}], "]"}]}], ",", 
          "evolutionOp"}], "}"}], ",", 
        RowBox[{
         RowBox[{"evolutionOp", "=", 
          RowBox[{"QWEvolutionOperator", "[", 
           RowBox[{"grid", ",", 
            RowBox[{"SparseArray", "[", "c", "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"ComputeSpatialIPREvolution", "[", 
          RowBox[{"evolutionOp", ",", "initialState", ",", "Tmax", ",", 
           RowBox[{"CoinDimension", "->", "4"}]}], "]"}]}]}], "]"}], "&"}], "/@",
      "names"}]}], ";"}], "\[IndentingNewLine]"}], "\n"}], "Input",
 CellChangeTimes->{{3.999522440888349*^9, 3.999522456596498*^9}, {
