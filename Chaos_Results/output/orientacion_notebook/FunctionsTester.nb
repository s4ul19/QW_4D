Cell[BoxData[RowBox[{RowBox[{"(*", RowBox[
                          {"Entrop\[IAcute]a", " ", "de", " ", RowBox[
                          {"entrelazamiento", ":", RowBox[{"vista", " ", 
                          "completa", " ", "y", " ", "detalle", " ", "por", 
                          " ", "grupo"}]}]}], "*)"}], RowBox[{RowBox[
                          {RowBox[{"cut", "=", RowBox[{"First", "@", RowBox[
                          {"FirstPosition", "[", RowBox[{"names", ",", 
                          "\"gpg\""}], "]"}]}]}], ";"}], "\n", RowBox[
                          {RowBox[{"sMax", "=", RowBox[{"Log", "[", "4", 
                          "]"}]}], ";"}], "                 ", RowBox[{"(*", 
                          RowBox[{"Cota", " ", "para", " ", "una", " ", 
                          "moneda", " ", "de", " ", "dimensi\[OAcute]n", " ", 
                          "4"}], "*)"}], "\n", RowBox[{RowBox[{"tZoom", "=", 
                          "20"}], ";"}], "                   ", RowBox[
                          {"(*", RowBox[{"Inicio", " ", "de", " ", "los", 
                          " ", "paneles", " ", "de", " ", "detalle"}], 
                          "*)"}], "\[IndentingNewLine]", "\n", RowBox[
                          {RowBox[{RowBox[{"palette", "[", RowBox[
                          {"endpoints_List", ",", "n_Integer"}], "]"}], ":=", 
                          RowBox[{RowBox[{RowBox[{"Blend", "[", RowBox[
                          {"endpoints", ",", "#"}], "]"}], "&"}], "/@", 
                          RowBox[{"If", "[", RowBox[{RowBox[{"n", "==", 
                          "1"}], ",", RowBox[{"{", "0.5", "}"}], ",", RowBox[
                          {"Subdivide", "[", RowBox[{"0", ",", "1", ",", 
                          RowBox[{"n", "-", "1"}]}], "]"}]}], "]"}]}]}], 
                          ";"}], "\[IndentingNewLine]", "\n", RowBox[
                          {RowBox[{"regularColors", "=", RowBox[{"palette", 
                          "[", RowBox[{RowBox[{"{", RowBox[{RowBox[
                          {"RGBColor", "[", RowBox[{"0.22", ",", "0.67", ",", 
                          "0.83"}], "]"}], ",", RowBox[{"RGBColor", "[", 
                          RowBox[{"0.06", ",", "0.22", ",", "0.53"}], 
                          "]"}]}], "}"}], ",", "cut"}], "]"}]}], ";"}], 
                          "\[IndentingNewLine]", "\n", RowBox[{RowBox[
                          {"chaoticColors", "=", RowBox[{"palette", "[", 
                          RowBox[{RowBox[{"{", RowBox[{RowBox[{"RGBColor", 
                          "[", RowBox[{"0.96", ",", "0.57", ",", "0.13"}], 
                          "]"}], ",", RowBox[{"RGBColor", "[", RowBox[
                          {"0.68", ",", "0.12", ",", "0.13"}], "]"}]}], 
                          "}"}], ",", RowBox[{RowBox[{"Length", "[", "names", 
                          "]"}], "-", "cut"}]}], "]"}]}], ";"}], 
                          "\[IndentingNewLine]", "\n", RowBox[{RowBox[
                          {"regularStyles", "=", RowBox[{RowBox[{RowBox[
                          {"Directive", "[", RowBox[{"#", ",", RowBox[
                          {"AbsoluteThickness", "[", "2", "]"}]}], "]"}], 
                          "&"}], "/@", "regularColors"}]}], ";"}], 
                          "\[IndentingNewLine]", "\n", RowBox[{RowBox[
                          {"chaoticStyles", "=", RowBox[{RowBox[{RowBox[
                          {"Directive", "[", RowBox[{"#", ",", RowBox[
                          {"AbsoluteThickness", "[", "2", "]"}], ",", 
                          "Dashed"}], "]"}], "&"}], "/@", 
                          "chaoticColors"}]}], ";"}], "\[IndentingNewLine]", 
                          "\n", RowBox[{RowBox[{"styles", "=", RowBox[
                          {"Join", "[", RowBox[{"regularStyles", ",", 
                          "chaoticStyles"}], "]"}]}], ";"}], 
                          "\[IndentingNewLine]", "\n", RowBox[{RowBox[
                          {"labels", "=", RowBox[{"Join", "[", RowBox[
                          {RowBox[{RowBox[{"(", RowBox[{RowBox[{"#", "<>", 
                          "\" \[CenterDot] integrable\""}], "&"}], ")"}], 
                          "/@", RowBox[{"Take", "[", RowBox[{"names", ",", 
                          "cut"}], "]"}]}], ",", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"#", "<>", 
                          "\" \[CenterDot] ca\[OAcute]tica\""}], "&"}], 
                          ")"}], "/@", RowBox[{"Drop", "[", RowBox[{"names", 
                          ",", "cut"}], "]"}]}]}], "]"}]}], ";"}], 
                          "\[IndentingNewLine]", "\n", RowBox[{"(*", RowBox[
                          {"Rango", " ", "vertical", " ", "com\[UAcute]n", 
                          " ", "para", " ", "ambos", " ", "acercamientos"}], 
                          "*)"}], "\[IndentingNewLine]", RowBox[{RowBox[
                          {"lateValues", "=", RowBox[{"Flatten", "[", RowBox[
                          {"entropyDat", "[", RowBox[{"[", RowBox[{"All", 
                          ",", RowBox[{RowBox[{"tZoom", "+", "1"}], ";;"}], 
                          ",", "2"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
                          RowBox[{RowBox[{RowBox[{"{", RowBox[{"yMin", ",", 
                          "yMax"}], "}"}], "=", RowBox[{"MinMax", "[", 
                          "lateValues", "]"}]}], ";"}], "\n", RowBox[
