     "\[IndentingNewLine]", 
     RowBox[{"curves", "=", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "/", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", "r"}], ")"}], "^", "2"}]}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"27", "/", "4"}], ")"}], " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"r", "+", 
              RowBox[{"r", "^", "2"}]}], ")"}], "/", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "+", "r", "+", 
               RowBox[{"r", "^", "2"}]}], ")"}], "^", 
             RowBox[{"(", 
              RowBox[{"5", "/", "2"}], ")"}]}]}]}], ",", 
