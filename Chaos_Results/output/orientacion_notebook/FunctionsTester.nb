Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"totalPs", "=", 
    RowBox[{"Flatten", "[", "psDat", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"Borde", " ", "derecho", " ", "del", " ", "primer", " ", "bin"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"corte", "=", 
    RowBox[{
     RowBox[{"HistogramList", "[", 
      RowBox[{
      "totalPs", ",", "\"\<FreedmanDiaconis\>\"", ",", "\"\<PDF\>\""}], "]"}],
      "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sFiltrado", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"totalPs", ",", 
     RowBox[{
      RowBox[{"#", ">=", "corte"}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fraccionExcluida", "=", 
    RowBox[{"N", "[", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"Length", "[", "sFiltrado", "]"}], "/", 
       RowBox[{"Length", "[", "totalPs", "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Nueva", " ", 
    RowBox[{"escala", ":", 
     RowBox[{
     "media", " ", "de", " ", "los", " ", "datos", " ", "retenidos", " ", 
      "igual", " ", "a", " ", "1"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sVis", "=", 
    RowBox[{"sFiltrado", "/", 
     RowBox[{"Mean", "[", "sFiltrado", "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"histograma", "=", 
    RowBox[{"Histogram", "[", 
     RowBox[{"sVis", ",", "\"\<FreedmanDiaconis\>\"", ",", "\"\<PDF\>\"", ",", 
      RowBox[{"ChartStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Orange", ",", 
         RowBox[{"Opacity", "[", "0.65", "]"}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"curvas", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"-", "s"}], "]"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Pi", "/", "2"}], ")"}], " ", "s", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "Pi"}], " ", 
           RowBox[{
            RowBox[{"s", "^", "2"}], "/", "4"}]}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"32", "/", 
           RowBox[{"Pi", "^", "2"}]}], ")"}], " ", 
         RowBox[{"s", "^", "2"}], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "4"}], " ", 
           RowBox[{
            RowBox[{"s", "^", "2"}], "/", "Pi"}]}], "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "0", ",", "4"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{"Black", ",", "Dashed"}], "]"}], ",", "Red", ",", "Blue"}], 
        "}"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Img", "=", 
  RowBox[{"Show", "[", 
   RowBox[{"histograma", ",", "curvas", ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"Axes", "->", "False"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<s+ (media 1)\>\"", ",", "\"\<P(s+), datos filtrados\>\""}],
       "}"}]}], ",", 
    RowBox[{"PlotLabel", "->", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<Primer bin excluido: \>\"", ",", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"100", " ", "fraccionExcluida"}], ",", 
          RowBox[{"{", 
           RowBox[{"5", ",", "2"}], "}"}]}], "]"}], ",", "\"\<%\>\""}], "}"}],
       "]"}]}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "4"}], "}"}], ",", "All"}], "}"}]}], ",", 
    RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}]}], "Input",
