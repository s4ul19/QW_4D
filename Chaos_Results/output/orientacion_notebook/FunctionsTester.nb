Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Img", "=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "raw", ",", "tau", ",", "kMean", ",", "meanData", ",", "smoothData", ",",
       "rmt", ",", "windowSize", ",", "window", ",", "series", ",", "styles", 
      ",", "labels"}], "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"1", " ", "desactiva", " ", "el", " ", "suavizado"}], ";", 
      RowBox[{
      "prueba", " ", "tambi\[EAcute]n", " ", "5", " ", "o", " ", "10"}]}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"windowSize", "=", "150"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "SFFDat", "]"}], "==", "0"}], "||", 
        RowBox[{"!", 
         RowBox[{"AllTrue", "[", 
          RowBox[{"SFFDat", ",", "AssociationQ"}], "]"}]}]}], ",", 
       RowBox[{
        RowBox[{
        "Print", 
         "[", "\"\<Revisa SFFDat: faltan datos o alguna realizaci\[OAcute]n \
fall\[OAcute].\>\"", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"raw", "=", 
      RowBox[{"Lookup", "[", 
       RowBox[{"SFFDat", ",", "\"\<Raw\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tau", "=", 
      RowBox[{"raw", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "All", ",", "1"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"AllTrue", "[", 
         RowBox[{"raw", ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "1"}], "]"}], "]"}], "===", "tau"}], ")"}],
            "&"}]}], "]"}]}], ",", 
       RowBox[{
        RowBox[{
        "Print", 
         "[", "\"\<Las realizaciones tienen distintas mallas de tiempos.\>\"",
          "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Promedio", " ", "entre", " ", "realizaciones", " ", "para", " ", 
       "cada", " ", "tau"}], "*)"}], 
     RowBox[{"kMean", "=", 
      RowBox[{"Mean", "[", 
       RowBox[{"raw", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"meanData", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"tau", ",", "kMean"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Misma", " ", "referencia", " ", "te\[OAcute]rica", " ", "que", " ", 
       "QWSFF"}], "*)"}], 
     RowBox[{"rmt", "=", 
      RowBox[{
       RowBox[{"SFFDat", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<RMT\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"series", "=", 
      RowBox[{"{", "meanData", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"styles", "=", 
      RowBox[{"{", 
       RowBox[{"Directive", "[", 
        RowBox[{"Blue", ",", "Thick"}], "]"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"labels", "=", 
      RowBox[{"{", "\"\<Promedio entre realizaciones\>\"", "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"windowSize", ">", "1"}], ",", 
       RowBox[{
        RowBox[{"window", "=", 
         RowBox[{"Min", "[", 
          RowBox[{"windowSize", ",", 
           RowBox[{"Length", "[", "tau", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"smoothData", "=", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"MovingAverage", "[", 
             RowBox[{"tau", ",", "window"}], "]"}], ",", 
            RowBox[{"MovingAverage", "[", 
             RowBox[{"kMean", ",", "window"}], "]"}]}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"styles", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Directive", "[", 
            RowBox[{
             RowBox[{"GrayLevel", "[", "0.6", "]"}], ",", "Thin"}], "]"}], ",", 
           RowBox[{"Directive", "[", 
            RowBox[{"Blue", ",", "Thick"}], "]"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"series", ",", "smoothData"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"labels", ",", 
          RowBox[{"\"\<Promedio + ventana (\>\"", "<>", 
           RowBox[{"ToString", "[", "window", "]"}], 
           "<>", "\"\< puntos)\>\""}]}], "]"}], ";"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"series", ",", "rmt"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"styles", ",", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "Dashed", ",", "Thick"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"labels", ",", "\"\<COE (RMT)\>\""}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{"series", ",", 
       RowBox[{"PlotStyle", "->", "styles"}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{"labels", ",", "Right"}], "]"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"Axes", "->", "False"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Tau] = t/N\>\"", ",", "\"\<K(\[Tau])\>\""}], "}"}]}], 
       ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"Last", "[", "tau", "]"}]}], "}"}], ",", "Automatic"}], 
         "}"}]}], ",", 
       RowBox[{"ImageSize", "->", "Large"}], ",", 
       RowBox[{"LabelStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Bold", ",", " ", "17"}], "]"}]}]}], "]"}]}]}], 
   "]"}]}]], "Input",
