Notebook[{

Cell[CellGroupData[{
Cell[
      "Pruebas de caminatas cu\[AAcute]nticas con una moneda de 4 \
dimensiones.", "Title", CellChangeTimes -> {{3.999691308166793*^9, 
         3.999691316947851*^9}}, ExpressionUUID -> 
       "5065071f-e547-4316-9c0e-e7c0ca33c584"],

Cell[
      "DiscreteProbabilityPlot: estados, probabilidades y escalas de color", 
      "Subtitle", ExpressionUUID -> "4a147baf-e7e1-44da-8159-728df69f02cc"],

Cell["Eval\[UAcute]a las celdas en orden. Se carga QWMisc.wl desde la \
carpeta de este notebook y JA_libs desde el proyecto. VisualizeWalkerState \
permanece como interfaz de compatibilidad. Las probabilidades se representan \
sin renormalizarlas. La paleta predeterminada va de blanco (m\[IAcute]nimo) a \
negro (m\[AAcute]ximo); ColorFunction permite elegir otra paleta.", "Text", 
      ExpressionUUID -> "09a70ef6-a39f-4248-a87f-7083bed2d154"],

