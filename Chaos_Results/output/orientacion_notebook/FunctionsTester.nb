Cell[CellGroupData[{

Cell["Una vez chequeado, \
remuevo los candidatos de la lista original de eigenfases", "Subsubsection", 
                  CellChangeTimes -> {{3.999867295722954*^9, 
                     3.9998673179883432*^9}}, ExpressionUUID -> 
                   "f7d0878c-3878-4bc7-8aa9-258633d3f0ce"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eigenenergies", "=", 
   RowBox[{"-", 
    RowBox[{"Arg", "[", "eigenvals", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"candidatos", "=", 
   RowBox[{"borde", "[", "\"\<CandidateEnergies\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tol", "=", 
   RowBox[{"10", "^", 
    RowBox[{"-", "8"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"restantes", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"eigenenergies", ",", 
     RowBox[{"Function", "[", 
      RowBox[{"e", ",", 
       RowBox[{"AllTrue", "[", 
        RowBox[{"candidatos", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"e", "-", "#"}], "]"}], ">", "tol"}], "&"}]}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.999867348943825*^9, 3.999867350113881*^9}, {
