Cell[CellGroupData[{

Cell["Ejemplos de funciones, testeos y cosas similares.", "Chapter", 
         CellChangeTimes -> {{3.999517612468606*^9, 3.9995176335177917*^9}}, 
         ExpressionUUID -> "ac609092-6f26-4cc0-9f7f-db2ad2255e2f"],

Cell[CellGroupData[{

Cell["IPR espacial y densidad local I_n(x,y) ", 
            "Section", CellChangeTimes -> {{3.999517599151081*^9, 
               3.999517601072571*^9}}, ExpressionUUID -> 
             "ca1e3cc4-5127-494d-b87a-c036276846eb"],

Cell["Se suma sobre la \
moneda antes de elevar al cuadrado. La densidad local I_n es una magnitud en \
posici\[OAcute]n, distinta de la distribuci\[OAcute]n de Husimi en espacio de \
fases.", "Text", CellChangeTimes -> {{3.9995173212786713*^9, 
               3.9995173243364964*^9}, 3.999517390542028*^9}, 
            ExpressionUUID -> "980da68a-775d-482e-92d8-6aa3e0680d3e"],

Cell["ComputeSpatialIPR[psi, d] devuelve un escalar; \
\nComputeSpatialIPRDensity[psi, d] devuelve un valor por sitio, en el orden \
de grid[\"Coords\"]. Ambas normalizan internamente y usan d = 4 por defecto. \
Los bloques consecutivos de d amplitudes corresponden a un sitio. La densidad \
se pasa a DiscreteProbabilityPlot como Probabilities, con escala Linear: \
Squared volver\[IAcute]a a elevar I_n al cuadrado.", "Text", 
            CellChangeTimes -> {3.999517402785591*^9}, ExpressionUUID -> 
             "ffd486ff-ba78-4052-99b3-6553a78a369b"],

Cell[CellGroupData[{

Cell["1. Estados localizado, uniforme y gaussiano", 
               "Subsection", ExpressionUUID -> 
                "c9c5e50a-b1a2-4fcd-ad46-42a6dfeb96e1"],

Cell[BoxData[RowBox[{RowBox[{"iprGrid", "=", RowBox[
                        {"GenerateRectangleBasis", "[", RowBox[{"8", ",", 
                          "5"}], "]"}]}], ";", RowBox[{"iprCoin", "=", 
                       RowBox[{"Normalize", "[", RowBox[{"{", RowBox[{"1", 
                          ",", "\[ImaginaryI]", ",", RowBox[{"-", "1"}], ",", 
                          "0"}], "}"}], "]"}]}], ";", RowBox[{"iprN", "=", 
                       RowBox[{"iprGrid", "[", "\"Dimension\"", "]"}]}], ";", 
                     RowBox[{"iprLocalized", "=", RowBox[{"LocalizedState", 
                         "[", RowBox[{"iprGrid", ",", RowBox[{"{", RowBox[
                          {"2", ",", "3"}], "}"}], ",", "iprCoin"}], "]"}]}], 
                     ";", RowBox[{"iprUniform", "=", RowBox[{"Flatten", "[", 
                         RowBox[{"KroneckerProduct", "[", RowBox[{RowBox[
                          {"ConstantArray", "[", RowBox[{FractionBox["1", 
                          SqrtBox["iprN"]], ",", "iprN"}], "]"}], ",", 
                          "iprCoin"}], "]"}], "]"}]}], ";", RowBox[
                      {"iprGaussian", "=", RowBox[{"GaussianState", "[", 
                         RowBox[{"iprGrid", ",", RowBox[{"{", RowBox[{"2", 
                          ",", "3"}], "}"}], ",", "iprCoin", ",", "1.2`"}], 
                         "]"}]}], ";", RowBox[{"iprStates", "=", RowBox[
                        {"{", RowBox[{"iprLocalized", ",", "iprUniform", ",", 
                          "iprGaussian"}], "}"}]}], ";", RowBox[{"iprNames", 
                       "=", RowBox[{"{", RowBox[{"\"Localizado\"", ",", 
                          "\"Uniforme\"", ",", "\"Gaussiano\""}], "}"}]}], 
                     ";", RowBox[{"iprProbabilities", "=", RowBox[
                        {RowBox[{"(", RowBox[{RowBox[{"Total", "[", RowBox[
                          {RowBox[{"Partition", "[", RowBox[{SuperscriptBox[
                          RowBox[{"Abs", "[", FractionBox[RowBox[{"Normal", 
                          "[", "#1", "]"}], TemplateBox[{"#1"}, "Norm"]], 
                          "]"}], "2"], ",", "4"}], "]"}], ",", RowBox[{"{", 
                          "2", "}"}]}], "]"}], "&"}], ")"}], "/@", 
                         "iprStates"}]}], ";", RowBox[{"iprDensities", "=", 
                       RowBox[{"ComputeSpatialIPRDensity", "/@", 
                         "iprStates"}]}], ";", RowBox[{"iprTotals", "=", 
                       RowBox[{"ComputeSpatialIPR", "/@", "iprStates"}]}], 
                     ";", RowBox[{"Grid", "[", RowBox[{RowBox[{"Prepend", 
                          "[", RowBox[{RowBox[{"MapThread", "[", RowBox[
                          {RowBox[{RowBox[{"{", RowBox[{"#1", ",", "#2", ",", 
                          RowBox[{"Total", "[", "#3", "]"}]}], "}"}], "&"}], 
                          ",", RowBox[{"{", RowBox[{"iprNames", ",", 
                          "iprTotals", ",", "iprDensities"}], "}"}]}], "]"}], 
                          ",", RowBox[{"{", RowBox[{"\"Estado\"", ",", 
                          "\"IPR espacial\"", ",", "\"Suma de I_n\""}], 
                          "}"}]}], "]"}], ",", RowBox[{"Frame", "\[Rule]", 
                          "All"}]}], "]"}]}]], "Input", ExpressionUUID -> 
                   "4c327987-b8b7-4892-9dbd-4119d253bc6c"],

Cell["El localizado tiene IPR = 1; el uniforme tiene IPR = 1/N \
y densidad 1/N^2 por sitio. El rect\[AAcute]ngulo incluye x = 0,...,8 e y = \
0,...,5: N = 54. Cada mapa usa su propio rango de color para mostrar su \
estructura.", "Text", ExpressionUUID -> 
                "dbfc7a08-e768-4f62-acb2-682132350fb2"],

Cell[BoxData[RowBox[{"GraphicsGrid", "[", RowBox[
                      {RowBox[{"Table", "[", RowBox[{RowBox[{"{", RowBox[
                          {RowBox[{"DiscreteProbabilityPlot", "[", RowBox[
                          {"iprGrid", ",", RowBox[{"iprProbabilities", 
                          "\[LeftDoubleBracket]", "j", 
                          "\[RightDoubleBracket]"}], ",", RowBox[
                          {"PlotLabel", "\[Rule]", TemplateBox[{RowBox[
                          {"iprNames", "\[LeftDoubleBracket]", "j", 
                          "\[RightDoubleBracket]"}], "\" : P_n(x,y)\""}, 
                          "RowDefault"]}], ",", RowBox[{"ImageSize", 
                          "\[Rule]", "420"}]}], "]"}], ",", RowBox[
                          {"DiscreteProbabilityPlot", "[", RowBox[{"iprGrid", 
                          ",", RowBox[{"iprDensities", 
                          "\[LeftDoubleBracket]", "j", 
                          "\[RightDoubleBracket]"}], ",", RowBox[
                          {"InputType", "\[Rule]", "\"Probabilities\""}], 
                          ",", RowBox[{"ProbabilityScale", "\[Rule]", 
                          "\"Linear\""}], ",", RowBox[{"PlotLabel", 
                          "\[Rule]", TemplateBox[{RowBox[{"iprNames", 
                          "\[LeftDoubleBracket]", "j", 
                          "\[RightDoubleBracket]"}], 
                          "\" : I_n(x,y) = P_n(x,y)^2; IPR = \"", RowBox[
                          {"N", "[", RowBox[{"iprTotals", 
                          "\[LeftDoubleBracket]", "j", 
                          "\[RightDoubleBracket]"}], "]"}]}, "RowDefault"]}], 
                          ",", RowBox[{"PlotLegends", "\[Rule]", RowBox[
                          {"Placed", "[", RowBox[{RowBox[{"BarLegend", "[", 
                          RowBox[{RowBox[{"{", RowBox[{RowBox[{RowBox[
                          {"GrayLevel", "[", RowBox[{"1", "-", "#1"}], "]"}], 
                          "&"}], ",", RowBox[{"{", RowBox[{"0", ",", RowBox[
                          {"Max", "[", RowBox[{"iprDensities", 
                          "\[LeftDoubleBracket]", "j", 
                          "\[RightDoubleBracket]"}], "]"}]}], "}"}]}], "}"}], 
                          ",", RowBox[{"LegendLabel", "\[Rule]", 
                          "\"I_n = P_n^2\""}]}], "]"}], ",", "Right"}], 
                          "]"}]}], ",", RowBox[{"ImageSize", "\[Rule]", 
                          "420"}]}], "]"}]}], "}"}], ",", RowBox[{"{", 
                          RowBox[{"j", ",", RowBox[{"Length", "[", 
                          "iprStates", "]"}]}], "}"}]}], "]"}], ",", 
                       RowBox[{"ImageSize", "\[Rule]", "1100"}]}], "]"}]], 
                  "Input", ExpressionUUID -> 
                   "4890c243-8101-4b33-aeb2-aca3ad800443"]
}, Closed]],

Cell[CellGroupData[{

Cell["2. Ejemplo con un \
eigenvector del operador de evoluci\[OAcute]n", "Subsection", 
               ExpressionUUID -> "8129c456-364f-45d6-9f08-a3e1aa5ce4db"],

Cell[BoxData[RowBox[{RowBox[{"iprEigenGrid", "=", RowBox[
                     {"GenerateRectangleBasis", "[", RowBox[{"4", ",", "3"}], 
                      "]"}]}], ";", RowBox[{"iprEigenCoin", "=", RowBox[
                     {"N", "[", RowBox[{"FourierMatrix", "[", "4", "]"}], 
                      "]"}]}], ";", RowBox[{"iprEvolution", "=", RowBox[
                     {"QWEvolutionOperator", "[", RowBox[{"iprEigenGrid", 
                        ",", "iprEigenCoin"}], "]"}]}], ";", RowBox[
                   {RowBox[{"{", RowBox[{"iprEigenvalues", ",", 
                        "iprEigenvectors"}], "}"}], "=", RowBox[
                     {"Eigensystem", "[", RowBox[{"N", "[", RowBox[{"Normal", 
                          "[", "iprEvolution", "]"}], "]"}], "]"}]}], ";", 
                  RowBox[{"iprEigenOrder", "=", RowBox[{"Ordering", "[", 
                      RowBox[{"-", RowBox[{"Arg", "[", "iprEigenvalues", 
                          "]"}]}], "]"}]}], ";", RowBox[{"iprEigenIndex", 
                    "=", RowBox[{"iprEigenOrder", "\[LeftDoubleBracket]", 
                      RowBox[{"Ceiling", "[", FractionBox[RowBox[{"Length", 
                          "[", "iprEigenOrder", "]"}], "2"], "]"}], 
                      "\[RightDoubleBracket]"}]}], ";", RowBox[
                   {"iprEigenstate", "=", RowBox[{"Normalize", "[", 
                      RowBox[{"iprEigenvectors", "\[LeftDoubleBracket]", 
                        "iprEigenIndex", "\[RightDoubleBracket]"}], "]"}]}], 
                  ";", RowBox[{"iprEigenP", "=", RowBox[{"Total", "[", 
                      RowBox[{RowBox[{"Partition", "[", RowBox[
                          {SuperscriptBox[RowBox[{"Abs", "[", 
                          "iprEigenstate", "]"}], "2"], ",", "4"}], "]"}], 
                        ",", RowBox[{"{", "2", "}"}]}], "]"}]}], ";", 
                  RowBox[{"iprEigenDensity", "=", RowBox[
                     {"ComputeSpatialIPRDensity", "[", "iprEigenstate", 
                      "]"}]}], ";", RowBox[{"iprEigenTotal", "=", RowBox[
                     {"ComputeSpatialIPR", "[", "iprEigenstate", "]"}]}], 
                  ";", RowBox[{"{", RowBox[{RowBox[
                       {"\"Eigenfase epsilon = -Arg(lambda)\"", "\[Rule]", 
                        RowBox[{"-", RowBox[{"Arg", "[", RowBox[
                          {"iprEigenvalues", "\[LeftDoubleBracket]", 
                          "iprEigenIndex", "\[RightDoubleBracket]"}], 
                          "]"}]}]}], ",", RowBox[{"\"IPR espacial\"", 
                        "\[Rule]", "iprEigenTotal"}], ",", RowBox[
                       {"\"Suma de I_n\"", "\[Rule]", RowBox[{"Total", "[", 
                          "iprEigenDensity", "]"}]}], ",", RowBox[
                       {"\"Residuo del eigenvector\"", "\[Rule]", TemplateBox[
                         {RowBox[{RowBox[{"iprEvolution", ".", 
                          "iprEigenstate"}], "-", RowBox[{RowBox[
                          {"iprEigenvalues", "\[LeftDoubleBracket]", 
                          "iprEigenIndex", "\[RightDoubleBracket]"}], " ", 
                          "iprEigenstate"}]}]}, "Norm"]}]}], "}"}]}]], 
               "Input", ExpressionUUID -> 
                "c8dd4584-7a42-4f49-bfd2-7aa46bef8bc8"],

Cell[BoxData[
                RowBox[{"GraphicsRow", "[", RowBox[{RowBox[{"{", RowBox[
                       {RowBox[{"DiscreteProbabilityPlot", "[", RowBox[
                          {"iprEigenGrid", ",", "iprEigenP", ",", RowBox[
                          {"PlotLabel", "\[Rule]", 
                          "\"P_n(x,y) del eigenvector\""}], ",", RowBox[
                          {"ImageSize", "\[Rule]", "420"}]}], "]"}], ",", 
                        RowBox[{"DiscreteProbabilityPlot", "[", RowBox[
                          {"iprEigenGrid", ",", "iprEigenDensity", ",", 
                          RowBox[{"ProbabilityScale", "\[Rule]", 
                          "\"Linear\""}], ",", RowBox[{"PlotLabel", 
                          "\[Rule]", "\"Densidad local I_n(x,y)\""}], ",", 
                          RowBox[{"PlotLegends", "\[Rule]", RowBox[{"Placed", 
                          "[", RowBox[{RowBox[{"BarLegend", "[", RowBox[
                          {RowBox[{"{", RowBox[{RowBox[{RowBox[{"GrayLevel", 
                          "[", RowBox[{"1", "-", "#1"}], "]"}], "&"}], ",", 
                          RowBox[{"{", RowBox[{"0", ",", RowBox[{"Max", "[", 
                          "iprEigenDensity", "]"}]}], "}"}]}], "}"}], ",", 
                          RowBox[{"LegendLabel", "\[Rule]", 
                          "\"I_n = P_n^2\""}]}], "]"}], ",", "Right"}], 
                          "]"}]}], ",", RowBox[{"ImageSize", "\[Rule]", 
                          "420"}]}], "]"}]}], "}"}], ",", RowBox[
                     {"ImageSize", "\[Rule]", "1100"}]}], "]"}]], "Input", 
               ExpressionUUID -> "c109db17-490b-4194-8400-5f58b5a12252"]
}, Closed]],

