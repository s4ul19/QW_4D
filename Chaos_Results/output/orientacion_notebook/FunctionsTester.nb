                          {RowBox[{"0.02", " ", "sMax"}], ",", RowBox[
                          {"0.12", " ", RowBox[{"(", RowBox[{"yMax", "-", 
                          "yMin"}], ")"}]}]}], "]"}]}], ";"}], "\n", RowBox[
