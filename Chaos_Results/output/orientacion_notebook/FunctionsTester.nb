Cell[BoxData[{
 RowBox[{
  RowBox[{"L1", "=", "140"}], ";", 
  RowBox[{"R1", "=", "100"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GridDataSinai", "=", 
   RowBox[{"GenerateSinaiBasis", "[", 
    RowBox[{"L1", ",", "R1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dim", "=", 
   RowBox[{"GridDataSinai", "[", "\"\<Dimension\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aurea", "=", 
   RowBox[{"GoldenRatio", "//", "N"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ly", "=", 
   RowBox[{"Floor", "[", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"dim", "/", "aurea"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lx", "=", 
   RowBox[{"Floor", "[", 
    RowBox[{"Ly", "*", "aurea"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Las dimensiones del rectangulo ser\[IAcute]an:\>\"", 
   ",", "\"\<Lx= \>\"", ",", "Lx", ",", "\"\<, Ly= \>\"", ",", "Ly"}], 
