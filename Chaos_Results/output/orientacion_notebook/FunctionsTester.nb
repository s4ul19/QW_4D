                "8e6f3590-0779-4d08-970a-a8532ca36b0a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "23", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lx", "=", "30"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Ly", "=", "25"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grid", "=", 
   RowBox[{"GenerateRectangleBasis", "[", 
    RowBox[{"Lx", ",", "Ly"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{"BuildShiftOperators", "[", 
    RowBox[{"grid", ",", 
     RowBox[{"CoinDimension", "->", "4"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nSites", "=", 
   RowBox[{"grid", "[", "\"\<Dimension\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"c", "=", 
   RowBox[{"N", "[", 
    RowBox[{"RandomMatrix", "[", "\"\<o\>\"", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"evolutionOp", "=", 
    RowBox[{"QWEvolutionOperator", "[", 
     RowBox[{"grid", ",", 
      RowBox[{"SparseArray", "[", "c", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Eigenvalores", " ", "y", " ", "eigenvectores"}], ",", 
    RowBox[{"en", " ", "el", " ", "mismo", " ", "orden"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"eigenvals", ",", "eigenvecs"}], "}"}], "=", 
   RowBox[{"Eigensystem", "[", 
    RowBox[{"Normal", "[", "evolutionOp", "]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.9998676422994347`*^9},
 CellLabel->"In[30]:=",ExpressionUUID->"60096630-0368-4df4-bdd8-b45349407692"],

