Cell[CellGroupData[{

Cell["4. Consultar el avance", "Section",ExpressionUUID->"dbaaf50a-3ad5-445c-bd25-6cb8150de26e"],

Cell["\<\
CompletedInputs cuenta las monedas cuyos resultados ya est\[AAcute]n \
guardados. ResultReady indica que el lote completo est\[AAcute] listo para \
descargar. Finished indica que adem\[AAcute]s termin\[OAcute] el cierre de \
los procesos. Failed o Cancelled requieren revisar el registro indicado en \
LogFile.\
\>", "Text",ExpressionUUID->"66888ef3-d0a3-4fa8-a26a-e9baff417c2e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"jobs", "=", 
   RowBox[{"Import", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], 
        ",", "\"\<NodeJobs-current-handles.wxf\>\""}], "}"}], "]"}], 
     ",", "\"\<WXF\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"estados", "=", 
   RowBox[{"NodeJobStatus", "/@", "jobs"}]}], ";", 
  RowBox[{"Dataset", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"KeyTake", "[", 
       RowBox[{"#1", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<Node\>\"", ",", "\"\<JobID\>\"", ",", "\"\<Status\>\"", 
          ",", "\"\<Stage\>\"", ",", "\"\<CompletedInputs\>\"", 
          ",", "\"\<InputCount\>\"", ",", "\"\<ResultReady\>\""}], "}"}]}], 
       "]"}], "&"}], ")"}], "/@", 
    RowBox[{"Select", "[", 
     RowBox[{"estados", ",", "AssociationQ"}], "]"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{4.000052947182703*^9, 4.000052948512126*^9}, {
  4.000135468982554*^9, 4.0001354698760033`*^9}},
 CellLabel->"In[86]:=",ExpressionUUID->"7d306d7a-5bc2-4c7c-ab0e-c511380fb7ed"],

