Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"candidatos", "=", 
     RowBox[{"borde", "[", "\"\<CandidateEnergies\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "result", "}"}], ",", 
       RowBox[{
        RowBox[{"result", "=", 
         RowBox[{"EigenstateAtEnergy", "[", 
          RowBox[{
           RowBox[{"candidatos", "[", 
            RowBox[{"[", "#", "]"}], "]"}], ",", "eigenvals", ",", 
           "eigenvecs"}], "]"}]}], ";", "\n", 
        RowBox[{"DiscreteProbabilityPlot", "[", 
         RowBox[{"grid", ",", 
          RowBox[{"result", "[", "\"\<State\>\"", "]"}], ",", 
          RowBox[{"InputType", "\[Rule]", "\"\<State\>\""}], ",", 
          RowBox[{"PlotLabel", "\[Rule]", "\"\<Desde amplitudes\>\""}], ",", 
          RowBox[{"ImageSize", "\[Rule]", "200"}]}], "]"}]}]}], "]"}], "&"}], 
    "/@", 
    RowBox[{"Range", "[", 
     RowBox[{"1", ",", 
      RowBox[{"candidatos", "//", "Length"}]}], "]"}]}]}]}]], "Input",
