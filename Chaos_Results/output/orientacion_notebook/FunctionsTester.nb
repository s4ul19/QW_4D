Cell["P(s)", "Subsection",
 CellChangeTimes->{{3.9997791664814157`*^9, 
  3.999779169386763*^9}},ExpressionUUID->"8a541f2e-57f8-444f-a1a0-\
bf2a038f6288"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"phasesDat", "=", 
   RowBox[{"phasesDat", "=", 
    RowBox[{"Arg", "/@", "espectros"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"psDat", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"QWPs", "[", 
       RowBox[{"#", ",", 
        RowBox[{"ReturnData", "->", "True"}]}], "]"}], "[", "\"\<Spacings\>\"",
       "]"}], "&"}], "/@", "phasesDat"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.99977917932071*^9, 3.9997792500130043`*^9}, {
