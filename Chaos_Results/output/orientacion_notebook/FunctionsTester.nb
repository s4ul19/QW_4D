Cell[BoxData[{
 RowBox[{
  RowBox[{"totalPs", "=", 
   RowBox[{"psDat", "//", "Flatten"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Img", "=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "dataStyle", ",", "styles", ",", "histogram", ",", "curves", ",", "s"}], 
     "}"}], ",", 
    RowBox[{
     RowBox[{"dataStyle", "=", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"RGBColor", "[", 
         RowBox[{"0.93", ",", "0.63", ",", "0.19"}], "]"}], ",", 
        RowBox[{"Opacity", "[", "0.85", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"styles", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", "Dashed", ",", "Thick"}], "]"}], ",", 
        RowBox[{"Directive", "[", 
         RowBox[{"Red", ",", "Thick"}], "]"}], ",", 
        RowBox[{"Directive", "[", 
         RowBox[{"Blue", ",", "Thick"}], "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"histogram", "=", 
      RowBox[{"Histogram", "[", 
       RowBox[{
       "totalPs", ",", "\"\<FreedmanDiaconis\>\"", ",", "\"\<PDF\>\"", ",", 
        RowBox[{"ChartStyle", "->", "dataStyle"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"curves", "=", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"-", "s"}], "]"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Pi", "/", "2"}], ")"}], " ", "s", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "Pi"}], " ", 
             RowBox[{
              RowBox[{"s", "^", "2"}], "/", "4"}]}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"32", "/", 
             RowBox[{"Pi", "^", "2"}]}], ")"}], " ", 
           RowBox[{"s", "^", "2"}], " ", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "4"}], " ", 
             RowBox[{
              RowBox[{"s", "^", "2"}], "/", "Pi"}]}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "0", ",", "4"}], "}"}], ",", 
        RowBox[{"PlotStyle", "->", "styles"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Legended", "[", 
