  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "COECoinGenerator[coin] returns a real symmetric generator K with coin = \
MatrixExp[-I K], using the principal matrix logarithm. Supply a finite \
symmetric unitary 4 x 4 coin in {U,D,R,L} order; RandomMatrix[\"o\"] \
generates one. The logarithm branch is fixed for this coin.", "Documentation" -> 
    None, "OwnValues" -> None, "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, QuantumWalks`QWMisc`COECoinGenerator, {
      QuantumWalks`QWMisc`COECoinGenerator[
         Pattern[QuantumWalks`QWMisc`Private`coin, 
          Blank[]]] :> 
       Module[{QuantumWalks`QWMisc`Private`c, QuantumWalks`QWMisc`Private`raw,
           QuantumWalks`QWMisc`Private`k, 
          QuantumWalks`QWMisc`Private`tolerance = 10^(-10)}, If[
           Or[
            Not[
             MatrixQ[
             QuantumWalks`QWMisc`Private`coin, 
              QuantumWalks`QWMisc`Private`qwFiniteNumberQ]], 
            Dimensions[QuantumWalks`QWMisc`Private`coin] =!= {4, 4}], 
           Message[
             MessageName[QuantumWalks`QWMisc`COECoinGenerator, "coin"]]; 
           Return[$Failed]]; QuantumWalks`QWMisc`Private`c = N[
            Normal[QuantumWalks`QWMisc`Private`coin]]; If[
           Or[Max[
              Abs[
               Flatten[
               QuantumWalks`QWMisc`Private`c - Transpose[
                QuantumWalks`QWMisc`Private`c]]]] > 
            QuantumWalks`QWMisc`Private`tolerance, Max[
              Abs[
               Flatten[Dot[QuantumWalks`QWMisc`Private`c, 
                  ConjugateTranspose[QuantumWalks`QWMisc`Private`c]] - 
                IdentityMatrix[4]]]] > QuantumWalks`QWMisc`Private`tolerance],
            Message[
             MessageName[QuantumWalks`QWMisc`COECoinGenerator, "coin"]]; 
           Return[$Failed]]; QuantumWalks`QWMisc`Private`raw = Quiet[
            Check[I MatrixLog[QuantumWalks`QWMisc`Private`c], $Failed]]; If[
           Or[QuantumWalks`QWMisc`Private`raw === $Failed, 
            Not[
             MatrixQ[
             QuantumWalks`QWMisc`Private`raw, 
              QuantumWalks`QWMisc`Private`qwFiniteNumberQ]]], Message[
             MessageName[QuantumWalks`QWMisc`COECoinGenerator, "log"]]; 
           Return[$Failed]]; 
         QuantumWalks`QWMisc`Private`k = 
          Re[(QuantumWalks`QWMisc`Private`raw + 
             Transpose[QuantumWalks`QWMisc`Private`raw])/2]; If[
           Or[Max[
              Abs[
               Flatten[
               QuantumWalks`QWMisc`Private`raw - 
                QuantumWalks`QWMisc`Private`k]]] > 
            QuantumWalks`QWMisc`Private`tolerance, Max[
              Abs[
               Flatten[
               MatrixExp[(-I) QuantumWalks`QWMisc`Private`k] - 
                QuantumWalks`QWMisc`Private`c]]] > 
            QuantumWalks`QWMisc`Private`tolerance], Message[
             MessageName[QuantumWalks`QWMisc`COECoinGenerator, "log"]]; 
           Return[$Failed]]; QuantumWalks`QWMisc`Private`k]}], "SubValues" -> 
    None, "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> None, "Attributes" -> {}, "FullName" -> 
    "QuantumWalks`QWMisc`COECoinGenerator"|>, False]]], "Output",
