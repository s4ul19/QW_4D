                    "ComputeTotalIPR", "[", 
                    "QuantumWalks`QWMisc`Private`state_", "]"}], ":=", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{"QuantumWalks`QWMisc`Private`amplitudes", ",", 
                    "QuantumWalks`QWMisc`Private`scale", ",", 
                    "QuantumWalks`QWMisc`Private`probabilities"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"!", 
                    RowBox[{"VectorQ", "[", 
                    
                    RowBox[{"QuantumWalks`QWMisc`Private`state", ",", 
                    "QuantumWalks`QWMisc`Private`qwFiniteNumberQ"}], "]"}]}], 
                    "||", 
                    RowBox[{
                    
                    RowBox[{"Length", "[", 
                    "QuantumWalks`QWMisc`Private`state", "]"}], "\[Equal]", 
                    "0"}]}], ",", 
                    RowBox[{
                    RowBox[{"Message", "[", 
                    StyleBox[
                    RowBox[{"ComputeTotalIPR", "::", "state"}], 
                    "MessageName"], "]"}], ";", 
                    RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
                    RowBox[{"QuantumWalks`QWMisc`Private`amplitudes", "=", 
                    
                    RowBox[{"Normal", "[", 
                    "QuantumWalks`QWMisc`Private`state", "]"}]}], ";", 
                    RowBox[{"QuantumWalks`QWMisc`Private`scale", "=", 
                    RowBox[{"Max", "[", 
                    
                    RowBox[{"Abs", "[", 
                    "QuantumWalks`QWMisc`Private`amplitudes", "]"}], "]"}]}], 
                    ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"TrueQ", "[", 
                    RowBox[{"QuantumWalks`QWMisc`Private`scale", "\[Equal]", 
                    "0"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"Message", "[", 
                    StyleBox[
                    RowBox[{"ComputeTotalIPR", "::", "zero"}], "MessageName"],
                     "]"}], ";", 
                    RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
                    
                    RowBox[{"QuantumWalks`QWMisc`Private`probabilities", "=", 
                    
                    SuperscriptBox[
                    RowBox[{"Abs", "[", 
                    FractionBox[
                    "QuantumWalks`QWMisc`Private`amplitudes", 
                    "QuantumWalks`QWMisc`Private`scale"], "]"}], "2"]}], ";", 
                    
                    RowBox[{"Total", "[", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    FractionBox["QuantumWalks`QWMisc`Private`probabilities", 
                    
                    RowBox[{"Total", "[", 
                    "QuantumWalks`QWMisc`Private`probabilities", "]"}]], 
                    ")"}], "2"], "]"}]}]}], "]"}]}]}, {" "}}, 
