                StripOnInput->False]},
              {
               TemplateBox[{"\"\[ThinSpace]\"", 
                 GridBox[{{
                    RowBox[{
                    
                    RowBox[{
                    "COECoinGenerator", "[", 
                    "QuantumWalks`QWMisc`Private`coin_", "]"}], ":=", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{"QuantumWalks`QWMisc`Private`c", ",", 
                    "QuantumWalks`QWMisc`Private`raw", ",", 
                    "QuantumWalks`QWMisc`Private`k", ",", 
                    RowBox[{"QuantumWalks`QWMisc`Private`tolerance", "=", 
                    FractionBox["1", 
                    SuperscriptBox["10", "10"]]}]}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"!", 
                    RowBox[{"MatrixQ", "[", 
                    
                    RowBox[{"QuantumWalks`QWMisc`Private`coin", ",", 
                    "QuantumWalks`QWMisc`Private`qwFiniteNumberQ"}], "]"}]}], 
                    "||", 
                    RowBox[{
                    
                    RowBox[{"Dimensions", "[", 
                    "QuantumWalks`QWMisc`Private`coin", "]"}], "=!=", 
                    RowBox[{"{", 
                    RowBox[{"4", ",", "4"}], "}"}]}]}], ",", 
                    RowBox[{
                    RowBox[{"Message", "[", 
                    StyleBox[
                    RowBox[{"COECoinGenerator", "::", "coin"}], 
                    "MessageName"], "]"}], ";", 
                    RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
                    RowBox[{"QuantumWalks`QWMisc`Private`c", "=", 
                    RowBox[{"N", "[", 
                    
                    RowBox[{"Normal", "[", "QuantumWalks`QWMisc`Private`coin",
                     "]"}], "]"}]}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Max", "[", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"QuantumWalks`QWMisc`Private`c", "-", 
                    
                    RowBox[{"Transpose", "[", "QuantumWalks`QWMisc`Private`c",
                     "]"}]}], "]"}], "]"}], "]"}], ">", 
                    "QuantumWalks`QWMisc`Private`tolerance"}], "||", 
                    RowBox[{
                    RowBox[{"Max", "[", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{
                    RowBox[{"QuantumWalks`QWMisc`Private`c", ".", 
                    
                    RowBox[{"ConjugateTranspose", "[", 
                    "QuantumWalks`QWMisc`Private`c", "]"}]}], "-", 
                    RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}], "]"}],
                     "]"}], ">", "QuantumWalks`QWMisc`Private`tolerance"}]}], 
                    ",", 
                    RowBox[{
                    RowBox[{"Message", "[", 
                    StyleBox[
                    RowBox[{"COECoinGenerator", "::", "coin"}], 
                    "MessageName"], "]"}], ";", 
                    RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
                    RowBox[{"QuantumWalks`QWMisc`Private`raw", "=", 
                    RowBox[{"Quiet", "[", 
                    RowBox[{"Check", "[", 
                    RowBox[{
                    RowBox[{"\[ImaginaryI]", " ", 
                    
                    RowBox[{"MatrixLog", "[", "QuantumWalks`QWMisc`Private`c",
                     "]"}]}], ",", "$Failed"}], "]"}], "]"}]}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    
                    RowBox[{"QuantumWalks`QWMisc`Private`raw", "===", 
                    "$Failed"}], "||", 
                    RowBox[{"!", 
                    RowBox[{"MatrixQ", "[", 
                    
                    RowBox[{"QuantumWalks`QWMisc`Private`raw", ",", 
                    "QuantumWalks`QWMisc`Private`qwFiniteNumberQ"}], 
                    "]"}]}]}], ",", 
