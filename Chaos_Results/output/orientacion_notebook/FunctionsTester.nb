  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "ComputeTotalIPR[StateVector] returns the IPR in the full computational \
(position-coin) basis, Sum[Abs[psi_b]^4, b], for the internally normalized \
state. Each coin amplitude contributes separately. Dense and sparse numeric \
vectors are accepted; no coin dimension is needed.", "Documentation" -> None, 
    "OwnValues" -> None, "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, QuantumWalks`QWMisc`ComputeTotalIPR, {
      QuantumWalks`QWMisc`ComputeTotalIPR[
         Pattern[QuantumWalks`QWMisc`Private`state, 
          Blank[]]] :> 
       Module[{QuantumWalks`QWMisc`Private`amplitudes, 
          QuantumWalks`QWMisc`Private`scale, 
          QuantumWalks`QWMisc`Private`probabilities}, If[
           Or[
            Not[
             VectorQ[
             QuantumWalks`QWMisc`Private`state, 
              QuantumWalks`QWMisc`Private`qwFiniteNumberQ]], 
            Length[QuantumWalks`QWMisc`Private`state] == 0], Message[
             MessageName[QuantumWalks`QWMisc`ComputeTotalIPR, "state"]]; 
           Return[$Failed]]; 
         QuantumWalks`QWMisc`Private`amplitudes = 
          Normal[QuantumWalks`QWMisc`Private`state]; 
         QuantumWalks`QWMisc`Private`scale = Max[
            Abs[QuantumWalks`QWMisc`Private`amplitudes]]; If[
           TrueQ[QuantumWalks`QWMisc`Private`scale == 0], Message[
             MessageName[QuantumWalks`QWMisc`ComputeTotalIPR, "zero"]]; 
           Return[$Failed]]; 
         QuantumWalks`QWMisc`Private`probabilities = 
          Abs[QuantumWalks`QWMisc`Private`amplitudes/
             QuantumWalks`QWMisc`Private`scale]^2; 
         Total[(QuantumWalks`QWMisc`Private`probabilities/Total[
            QuantumWalks`QWMisc`Private`probabilities])^2]]}], "SubValues" -> 
    None, "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> None, "Attributes" -> {}, "FullName" -> 
    "QuantumWalks`QWMisc`ComputeTotalIPR"|>, False]]], "Output",
 CellChangeTimes->{4.000157678844767*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"cc21b72b-4c49-45e6-b856-8be6625bd4dc"]
