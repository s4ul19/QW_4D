                    RowBox[{"COECoinGenerator", "::", "log"}], "MessageName"],
                     "]"}], ";", 
                    RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
                    "QuantumWalks`QWMisc`Private`k"}]}], "]"}]}]}, {" "}}, 
