                          {"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
                       RowBox[{RowBox[{"eigenvectors", "=", RowBox[
                          {"eigenData", "[", RowBox[{"[", RowBox[{"All", ",", 
                          "2"}], "]"}], "]"}]}], ";"}], "\n", RowBox[
