                          RowBox[{"-", RowBox[{"Arg", "[", "eigenvals", 
                          "]"}]}]}], ";", "\[IndentingNewLine]", RowBox[
                          {"spacings", "=", RowBox[{"QWPs", "[", RowBox[
                          {"eigenphases", ",", RowBox[{"ReturnData", "->", 
                          "True"}]}], "]"}]}]}]}], "]"}]}], ";"}]], "Input", 
