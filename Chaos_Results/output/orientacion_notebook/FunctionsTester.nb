Cell[BoxData[{RowBox[{RowBox[{"Lx", "=", 
                          "80"}], ";"}], "\n", RowBox[{RowBox[{"Ly", "=", 
                          "60"}], ";"}], "\n", RowBox[{RowBox[{RowBox[
                          {"grid", "=", RowBox[{"GenerateRectangleBasis", 
