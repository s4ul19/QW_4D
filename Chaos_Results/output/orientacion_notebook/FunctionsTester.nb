                          "j", "]"}], "]"}], ",", "3"}], "]"}]}], "}"}], ",", 
                          RowBox[{"{", RowBox[{"j", ",", "k"}], "}"}]}], 
                          "]"}], ",", RowBox[{"{", RowBox[{"\"Intervalo\"", 
