Cell["\<\
Env\[IAcute]a un lote a cada nodo, consulta el estado y descarga los \
resultados cuando est\[EAcute]n listos. La Mac no mantiene una \
conexi\[OAcute]n durante el c\[AAcute]lculo. Ejecuta las secciones por \
separado.\
\>", "Text",ExpressionUUID->"8fee879e-75bb-468a-ae16-3c75d6ffaf36"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Cancelar un trabajo, si lo necesitas", "Section",ExpressionUUID->"c711fb9d-5f05-4470-aa9c-8a421917c160"],

Cell["\<\
Abortar una celda de la Mac no detiene un trabajo independiente. Para \
solicitar cancelar \[UAcute]nicamente el cuarto trabajo, eval\[UAcute]a \
CancelNodeJob[jobs[[4]]] en una celda nueva y consulta despu\[EAcute]s su \
estado. Los archivos que ya se guardaron se conservan.\
\>", "Text",ExpressionUUID->"a74fc61f-9cff-4f94-b9f1-d733f2fcd949"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sinai", "Chapter",
 CellChangeTimes->{{4.000113907459635*^9, 
  4.0001139342496643`*^9}},ExpressionUUID->"39f854d0-2a0f-4b58-b50f-\
d17868ffb314"],

Cell[CellGroupData[{

Cell[" Preparar los datos y la funci\[OAcute]n", "Section",
 CellChangeTimes->{{4.0000524848677397`*^9, 
  4.000052485791286*^9}},ExpressionUUID->"f736dc0d-6b08-4d7f-8b9f-\
8c72b79eac2f"],

Cell["\<\
Estos tama\[NTilde]os y cantidades son un ejemplo para 235 monedas. Puedes \
conservar los valores y funciones que ya definiste en FunctionsTester.nb. \
PrepararQuantumWalks carga las dependencias en cada trabajador remoto.\
\>", "Text",ExpressionUUID->"0c4e403e-c1ea-4e35-bfb8-a64fc453cf36"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"n1", "=", "60"}], ";", 
   RowBox[{"n2", "=", "60"}], ";", 
   RowBox[{"n3", "=", "80"}], ";", 
   RowBox[{"n4", "=", "35"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L1", "=", "49"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R1", "=", "37"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ensamble", "=", "\"\<p\>\""}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "115", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"monedas", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"N", "[", 
       RowBox[{"RandomMatrix", "[", "ensamble", "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"n1", "+", "n2", "+", "n3", "+", "n4"}], "}"}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"calcularEspectro", "=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"L", "=", "L1"}], ",", 
        RowBox[{"R", "=", "R1"}]}], "}"}], ",", 
      RowBox[{"Function", "[", 
       RowBox[{"moneda", ",", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"grid", ",", "dim", ",", "s", ",", "u"}], "}"}], ",", 
          RowBox[{
           RowBox[{"grid", "=", 
            RowBox[{"GenerateSinaiBasis", "[", 
             RowBox[{"L", ",", "R"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"dim", "=", 
            RowBox[{"grid", "[", "\"\<Dimension\>\"", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"s", "=", 
            RowBox[{"BuildShiftOperators", "[", 
             RowBox[{"grid", ",", 
              RowBox[{"CoinDimension", "->", "4"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"u", "=", 
            RowBox[{"s", ".", 
             RowBox[{"KroneckerProduct", "[", 
              RowBox[{
               RowBox[{"IdentityMatrix", "[", 
                RowBox[{"dim", ",", "SparseArray"}], "]"}], ",", 
               RowBox[{"SparseArray", "[", "moneda", "]"}]}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Eigenvalues", "[", 
            RowBox[{"Normal", "[", "u", "]"}], "]"}]}]}], "]"}]}], "]"}]}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"prepararQuantumWalks", "=", 
    RowBox[{"Function", "[", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "path", "}"}], ",", 
       RowBox[{
        RowBox[{"path", "=", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Replace", "[", 
             RowBox[{
              RowBox[{"Environment", "[", "\"\<QW_PROJECT_ROOT\>\"", "]"}], ",", 
              RowBox[{
               RowBox[{"Except", "[", "_String", "]"}], ":>", 
               RowBox[{"FileNameJoin", "[", 
                RowBox[{"{", 
                 RowBox[{"$HomeDirectory", ",", "\"\<QW\>\""}], "}"}], 
                "]"}]}]}], "]"}], ",", "\"\<JA_libs\>\"", 
            ",", "\"\<QuantumWalks\>\""}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"PacletDirectoryLoad", "[", "path", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Needs", "[", "\"\<ForScience`\>\"", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Block", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ForScience`PacletUtils`FormatUsage", "=", "Identity"}], 
           "}"}], ",", 
          RowBox[{"Needs", "[", "\"\<QuantumWalks`\>\"", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{
          "DownValues", "[", "QuantumWalks`Billiards`GenerateSinaiBasis", 
           "]"}], "]"}], ">", "0"}]}]}], "]"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trabajos", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<nodo1\>\"", ",", "15", ",", 
       RowBox[{"monedas", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "n1"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<nodo2\>\"", ",", "10", ",", 
       RowBox[{"monedas", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"n1", "+", "1"}], ";;", 
          RowBox[{"n1", "+", "n2"}]}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<nodo3\>\"", ",", "12", ",", 
       RowBox[{"monedas", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"n1", "+", "n2", "+", "1"}], ";;", 
          RowBox[{"n1", "+", "n2", "+", "n3"}]}], "]"}], "]"}]}], "}"}], ",", 
     
     RowBox[{"{", 
      RowBox[{"\"\<nodo4\>\"", ",", "6", ",", 
       RowBox[{"monedas", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"n1", "+", "n2", "+", "n3", "+", "1"}], ";;", 
          RowBox[{"n1", "+", "n2", "+", "n3", "+", "n4"}]}], "]"}], "]"}]}], 
      "}"}]}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.0000547151829453`*^9, 4.000054716375059*^9}, {
  4.000059615440139*^9, 4.000059615730855*^9}, {4.0001139674051437`*^9, 
  4.0001139680438433`*^9}, {4.0001140081657124`*^9, 4.0001140088244677`*^9}, {
  4.00011581250458*^9, 4.000115814007861*^9}, {4.000116328388335*^9, 
  4.000116339496716*^9}, {4.000117220255513*^9, 4.000117220785039*^9}, {
  4.000118445833807*^9, 4.000118448590436*^9}, {4.000119354759548*^9, 
  4.00011937107344*^9}, {4.000120559159113*^9, 4.0001205593054543`*^9}, {
  4.000127747956848*^9, 4.000127748277837*^9}, {4.000148892111767*^9, 
  4.000148893332369*^9}},
 CellLabel->
  "In[128]:=",ExpressionUUID->"567df8ee-6539-4eba-978b-b27982eb0503"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Enviar los cuatro trabajos", "Section",ExpressionUUID->"8008a81f-14e9-4f26-982a-0bd92f2b20c9"],

Cell["\<\
La celda termina cuando los nodos aceptan los trabajos. Despu\[EAcute]s \
puedes usar o cerrar la Mac. No vuelvas a ejecutar esta celda para consultar \
el avance: cada env\[IAcute]o crea un trabajo nuevo.\
\>", "Text",ExpressionUUID->"8b7ab69b-54b8-4119-a1fd-4581b48df7b7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"jobs", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"SubmitNodeJob", "[", 
      RowBox[{
       RowBox[{"#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
       RowBox[{"#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",",
        "calcularEspectro", ",", 
       RowBox[{"#1", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], ",",
        "prepararQuantumWalks"}], "]"}], "&"}], ")"}], "/@", 
   "trabajos"}]}]], "Input",
 CellLabel->"In[62]:=",ExpressionUUID->"09475a26-fb3d-46a1-af9e-4b266c69986c"],

