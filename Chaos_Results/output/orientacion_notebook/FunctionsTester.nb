Cell[CellGroupData[{

Cell["Rectangulo", "Chapter",
 CellChangeTimes->{{4.000113907459635*^9, 
  4.0001139088276663`*^9}},ExpressionUUID->"a608a4c4-ab9f-44c7-91b1-\
6ed4f7343506"],

Cell[CellGroupData[{

Cell[" Preparar los datos y la funci\[OAcute]n", "Section",
 CellChangeTimes->{{4.0000524848677397`*^9, 
  4.000052485791286*^9}},ExpressionUUID->"5948c7da-5b55-40e6-9be7-\
8f671638c372"],

Cell["\<\
Estos tama\[NTilde]os y cantidades son un ejemplo para 235 monedas. Puedes \
conservar los valores y funciones que ya definiste en FunctionsTester.nb. \
PrepararQuantumWalks carga las dependencias en cada trabajador remoto.\
\>", "Text",ExpressionUUID->"0c5b5d15-716d-4920-a37a-47a00d68fbdb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"n1", "=", "50"}], ";", 
  RowBox[{"n2", "=", "50"}], ";", 
  RowBox[{"n3", "=", "75"}], ";", 
  RowBox[{"n4", "=", "60"}], ";", 
  RowBox[{"SeedRandom", "[", "115", "]"}], ";", 
  RowBox[{"monedas", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{"RandomMatrix", "[", "\"\<p\>\"", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n1", "+", "n2", "+", "n3", "+", "n4"}], "}"}]}], "]"}]}], ";", 
  
  RowBox[{"calcularEspectro", "=", 
   RowBox[{"Function", "[", 
    RowBox[{"moneda", ",", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"grid", ",", "dim", ",", "s", ",", "u"}], "}"}], ",", 
       RowBox[{
        RowBox[{"grid", "=", 
         RowBox[{"GenerateRectangleBasis", "[", 
          RowBox[{"35", ",", "25"}], "]"}]}], ";", 
        RowBox[{"dim", "=", 
         RowBox[{"grid", "[", "\"\<Dimension\>\"", "]"}]}], ";", 
        RowBox[{"s", "=", 
         RowBox[{"BuildShiftOperators", "[", 
          RowBox[{"grid", ",", 
           RowBox[{"CoinDimension", "\[Rule]", "4"}]}], "]"}]}], ";", 
        RowBox[{"u", "=", 
         RowBox[{"s", ".", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{"IdentityMatrix", "[", 
             RowBox[{"dim", ",", "SparseArray"}], "]"}], ",", 
            RowBox[{"SparseArray", "[", "moneda", "]"}]}], "]"}]}]}], ";", 
        RowBox[{"Eigenvalues", "[", 
         RowBox[{"Normal", "[", "u", "]"}], "]"}]}]}], "]"}]}], "]"}]}], ";", 
  
  RowBox[{"prepararQuantumWalks", "=", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"path", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Replace", "[", 
            RowBox[{
             RowBox[{"Environment", "[", "\"\<QW_PROJECT_ROOT\>\"", "]"}], ",", 
             RowBox[{
              RowBox[{"Except", "[", "_String", "]"}], "\[RuleDelayed]", 
              RowBox[{"FileNameJoin", "[", 
               RowBox[{"{", 
                RowBox[{"$HomeDirectory", ",", "\"\<QW\>\""}], "}"}], 
               "]"}]}]}], "]"}], ",", "\"\<JA_libs\>\"", 
           ",", "\"\<QuantumWalks\>\""}], "}"}], "]"}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"PacletDirectoryLoad", "[", "path", "]"}], ";", 
       RowBox[{"Needs", "[", "\"\<ForScience`\>\"", "]"}], ";", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"FormatUsage", "=", "Identity"}], "}"}], ",", 
         RowBox[{"Needs", "[", "\"\<QuantumWalks`\>\"", "]"}]}], "]"}], ";", 
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"DownValues", "[", "GenerateRectangleBasis", "]"}], "]"}], ">",
