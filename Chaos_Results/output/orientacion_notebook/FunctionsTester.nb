Cell["Flujo general:", "Subsection",
 CellChangeTimes->{{4.000055345161224*^9, 
  4.0000553509513807`*^9}},ExpressionUUID->"8f4e6dad-fe75-4e22-9ecb-\
6a9fa0a297a1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "23", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Lx", "=", "30"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Ly", "=", "25"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"grid", "=", 
     RowBox[{"GenerateRectangleBasis", "[", 
      RowBox[{"Lx", ",", "Ly"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"S", "=", 
     RowBox[{"BuildShiftOperators", "[", 
      RowBox[{"grid", ",", 
       RowBox[{"CoinDimension", "->", "4"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nSites", "=", 
     RowBox[{"grid", "[", "\"\<Dimension\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"c", "=", 
     RowBox[{"N", "[", 
      RowBox[{"RandomMatrix", "[", "\"\<o\>\"", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"evolutionOp", "=", 
     RowBox[{"QWEvolutionOperator", "[", 
      RowBox[{"grid", ",", 
       RowBox[{"SparseArray", "[", "c", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Eigenvalores", " ", "y", " ", "eigenvectores"}], ",", 
     RowBox[{"en", " ", "el", " ", "mismo", " ", "orden"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eigenvals", ",", "eigenvecs"}], "}"}], "=", 
     RowBox[{"Eigensystem", "[", 
      RowBox[{"Normal", "[", "evolutionOp", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eigenenergies", "=", 
     RowBox[{"-", 
      RowBox[{"Arg", "[", "eigenvals", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"borde", "=", 
     RowBox[{"AnalyzeBoundaryEigenstates", "[", 
      RowBox[{"grid", ",", "eigenvals", ",", "eigenvecs", ",", 
       RowBox[{"BoundaryWidth", "->", "2"}], ",", 
       RowBox[{"BoundaryThreshold", "->", "0.4"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"candidatos", "=", 
     RowBox[{"borde", "[", "\"\<CandidateEnergies\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tol", "=", 
     RowBox[{"10", "^", 
      RowBox[{"-", "8"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"restantes", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"eigenenergies", ",", 
       RowBox[{"Function", "[", 
        RowBox[{"e", ",", 
         RowBox[{"AllTrue", "[", 
          RowBox[{"candidatos", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"e", "-", "#"}], "]"}], ">", "tol"}], "&"}]}], "]"}]}], 
        "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{4.000055366338149*^9, 4.000055410267198*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"54ce73b5-041e-4321-857a-6aba4b0c8cc0"],

