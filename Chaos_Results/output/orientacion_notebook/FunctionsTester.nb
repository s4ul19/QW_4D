Cell["\<\
Estos tama\[NTilde]os y cantidades son un ejemplo para 235 monedas. Puedes \
conservar los valores y funciones que ya definiste en FunctionsTester.nb. \
PrepararQuantumWalks carga las dependencias en cada trabajador remoto.\
\>", "Text",ExpressionUUID->"5bbdbdc8-22ee-4b51-a13f-f486bcff4954"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Lx", " ", "=", " ", "30"}], ";", " ", 
  RowBox[{"Ly", " ", "=", " ", "25"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"n1", " ", "=", " ", "50"}], ";", " ", 
  RowBox[{"n2", " ", "=", " ", "50"}], ";", " ", 
  RowBox[{"n3", " ", "=", " ", "75"}], ";", " ", 
  RowBox[{"n4", " ", "=", " ", "60"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"valoresT", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{"Subdivide", "[", 
     RowBox[{"0", ",", " ", "1", ",", " ", 
      RowBox[{
      "n1", " ", "+", " ", "n2", " ", "+", " ", "n3", " ", "+", " ", "n4", 
       " ", "-", " ", "1"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"coinCOE", " ", "=", " ", 
    RowBox[{"N", "[", 
     RowBox[{"RandomMatrix", "[", 
      RowBox[{"\"\<o\>\"", ",", " ", 
       RowBox[{"RandomSeed", " ", "->", " ", "23"}]}], "]"}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"calcularRPorT", " ", "=", " ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"base", " ", "=", " ", "coinCOE"}], ",", " ", 
        RowBox[{"lx", " ", "=", " ", "Lx"}], ",", " ", 
        RowBox[{"ly", " ", "=", " ", "Ly"}]}], "}"}], ",", "\n", " ", 
      RowBox[{"Function", "[", 
       RowBox[{"valorT", ",", "\n", "  ", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "grid", ",", " ", "coin", ",", " ", "phases", ",", " ", "data", ",",
             " ", "ratios"}], "}"}], ",", "\n", "   ", 
          RowBox[{
           RowBox[{"grid", " ", "=", " ", 
            RowBox[{"GenerateRectangleBasis", "[", 
             RowBox[{"lx", ",", " ", "ly"}], "]"}]}], ";", "\n", "   ", 
           RowBox[{"coin", " ", "=", " ", 
            RowBox[{"N", "[", 
             RowBox[{"COECoinInterpolation", "[", 
              RowBox[{"base", ",", " ", "valorT"}], "]"}], "]"}]}], ";", "\n",
            "   ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"coin", " ", "===", " ", "$Failed"}], ",", " ", 
             RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", "\n", 
           "   ", 
           RowBox[{"phases", " ", "=", " ", 
            RowBox[{"QWEigenphases", "[", 
             RowBox[{"grid", ",", " ", "coin"}], "]"}]}], ";", "\n", "   ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"ListQ", "[", "phases", "]"}]}], ",", " ", 
             RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", "\n", 
           "   ", 
           RowBox[{"data", " ", "=", " ", 
            RowBox[{"QWPr", "[", 
             RowBox[{"phases", ",", " ", 
              RowBox[{"\"\<AllowDegeneracies\>\"", " ", "->", " ", "True"}], ",",
               " ", 
              RowBox[{"ReturnData", " ", "->", " ", "True"}]}], "]"}]}], ";", 
           "\n", "   ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"AssociationQ", "[", "data", "]"}]}], ",", " ", 
             RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", "\n", 
           "   ", 
           RowBox[{"ratios", " ", "=", " ", 
            RowBox[{"Lookup", "[", 
             RowBox[{"data", ",", " ", "\"\<Ratios\>\"", ",", " ", 
              RowBox[{"{", "}"}]}], "]"}]}], ";", "\n", "   ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"!", 
               RowBox[{"VectorQ", "[", 
                RowBox[{"ratios", ",", " ", "NumberQ"}], "]"}]}], " ", "||", 
              " ", 
              RowBox[{"ratios", " ", "===", " ", 
               RowBox[{"{", "}"}]}]}], ",", " ", 
             RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", "\n", 
           "   ", 
           RowBox[{"{", 
            RowBox[{"valorT", ",", " ", 
             RowBox[{"Mean", "[", "ratios", "]"}]}], "}"}]}]}], "\n", "  ", 
         "]"}]}], "\n", " ", "]"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"prepararBarridoCOE", " ", "=", " ", 
    RowBox[{"With", "[", "\n", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "version", " ", "=", 
        " ", "\"\<COEInterpolation-20261004-db57cafe-56fe-4e01-a8d0-\
0d7e94e5ed13\>\""}], "}"}], ",", "\n", " ", 
      RowBox[{"Function", "[", "\n", "  ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"root", ",", " ", "loader"}], "}"}], ",", "\n", "   ", 
         RowBox[{
          RowBox[{"root", " ", "=", " ", 
           RowBox[{"Replace", "[", 
            RowBox[{
             RowBox[{"Environment", "[", "\"\<QW_PROJECT_ROOT\>\"", "]"}], ",",
              " ", 
             RowBox[{
              RowBox[{"Except", "[", "_String", "]"}], " ", ":>", "\n", 
              "     ", 
              RowBox[{"FileNameJoin", "[", 
               RowBox[{"{", 
                RowBox[{"$HomeDirectory", ",", " ", "\"\<QW\>\""}], "}"}], 
               "]"}]}]}], "]"}]}], ";", "\n", "   ", 
          RowBox[{"loader", " ", "=", " ", 
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{
             "root", ",", " ", "\"\<worker-bundles\>\"", ",", " ", "version", 
              ",", " ", "\"\<scripts\>\"", ",", 
              " ", "\"\<load_project.wl\>\""}], "}"}], "]"}]}], ";", "\n", 
          "   ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"FileExistsQ", "[", "loader", "]"}]}], ",", " ", 
            RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", "\n", "   ", 
          
          RowBox[{"Get", "[", "loader", "]"}], ";", "\n", "   ", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{
             "DownValues", "[", 
              "QuantumWalks`Billiards`GenerateRectangleBasis", "]"}], "]"}], 
            " ", ">", " ", "0"}], " ", "&&", "\n", "    ", 
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{
             "DownValues", "[", "QuantumWalks`QWMisc`COECoinInterpolation", 
              "]"}], "]"}], " ", ">", " ", "0"}], " ", "&&", "\n", "    ", 
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{
             "DownValues", "[", "QuantumWalks`QWMisc`QWEigenphases", "]"}], 
             "]"}], " ", ">", " ", "0"}], " ", "&&", "\n", "    ", 
           RowBox[{"MemberQ", "[", 
            RowBox[{
             RowBox[{"Options", "[", "QuantumWalks`QWMisc`QWPr", "]"}], ",", 
             " ", 
             RowBox[{"\"\<AllowDegeneracies\>\"", " ", "->", " ", "False"}]}],
             "]"}]}]}]}], "\n", "  ", "]"}], "\n", " ", "]"}]}], "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"trabajos", " ", "=", " ", 
   RowBox[{"{", "\n", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<nodo1\>\"", ",", " ", "15", ",", " ", 
       RowBox[{"valoresT", "[", 
        RowBox[{"[", 
         RowBox[{"1", " ", ";;", " ", "n1"}], "]"}], "]"}]}], "}"}], ",", 
     "\n", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<nodo2\>\"", ",", " ", "10", ",", " ", 
       RowBox[{"valoresT", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"n1", " ", "+", " ", "1"}], " ", ";;", " ", 
          RowBox[{"n1", " ", "+", " ", "n2"}]}], "]"}], "]"}]}], "}"}], ",", 
     "\n", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<nodo3\>\"", ",", " ", "12", ",", " ", 
       RowBox[{"valoresT", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"n1", " ", "+", " ", "n2", " ", "+", " ", "1"}], " ", ";;", 
          " ", 
          RowBox[{"n1", " ", "+", " ", "n2", " ", "+", " ", "n3"}]}], "]"}], 
        "]"}]}], "}"}], ",", "\n", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<nodo4\>\"", ",", " ", "6", ",", " ", 
       RowBox[{"valoresT", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{
          "n1", " ", "+", " ", "n2", " ", "+", " ", "n3", " ", "+", " ", 
           "1"}], " ", ";;", " ", 
          RowBox[{
          "n1", " ", "+", " ", "n2", " ", "+", " ", "n3", " ", "+", " ", 
           "n4"}]}], "]"}], "]"}]}], "}"}]}], "\n", "}"}]}], ";"}]}], "Input",\

 CellChangeTimes->{{4.0000547151829453`*^9, 4.000054716375059*^9}, {
  4.000059615440139*^9, 4.000059615730855*^9}, {4.000135358850217*^9, 
