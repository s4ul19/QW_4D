Cell[CellGroupData[{

Cell[
            "4. Evoluci\[OAcute]n con escala autom\[AAcute]tica por estado", 
            "Section", ExpressionUUID -> 
             "2920b9c8-64e8-4670-9829-60d79f9637af"],

Cell["Cada cuadro \
ajusta la escala de color a su propia probabilidad m\[AAcute]xima. Esto \
permite distinguir las variaciones espaciales aunque las probabilidades sean \
peque\[NTilde]as. Un mismo color puede corresponder a probabilidades \
distintas entre cuadros; consulta la leyenda de cada uno.", "Text", 
            ExpressionUUID -> "30184000-e293-409d-9edb-7fce46999968"],

Cell[BoxData[{RowBox[{RowBox[{"SeedRandom", "[", "23", "]"}], 
                ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{"Lx", "=", 
                  "20"}], ";", " ", RowBox[{"Ly", "=", "20"}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"grid", "=", 
                  RowBox[{"GenerateRectangleBasis", "[", RowBox[{"Lx", ",", 
                      "Ly"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"pos", "=", RowBox[{"{", RowBox[{"6", ",", 
                      "6"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"coin", "=", RowBox[{"N", "[", RowBox[
                     {RowBox[{"HaarRandomState", "[", "4", "]"}], "//", 
                      "Normalize"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"S", "=", RowBox[{"BuildShiftOperators", "[", 
                    RowBox[{"grid", ",", RowBox[{"CoinDimension", "\[Rule]", 
                        "4"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"steps", "=", "10"}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"stride", "=", "1"}], 
                ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{"coinSep", "=", 
                  RowBox[{"N", "[", RowBox[{"KroneckerProduct", "[", 
                      RowBox[{RowBox[{"RandomVariate", "[", RowBox[
                          {"CircularOrthogonalMatrixDistribution", "[", "2", 
                          "]"}], "]"}], ",", RowBox[{"RandomVariate", "[", 
                          RowBox[{"CircularOrthogonalMatrixDistribution", 
                          "[", "2", "]"}], "]"}]}], "]"}], "]"}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"evolutionSep", "=", 
                  RowBox[{"QWEvolutionOperator", "[", RowBox[{"grid", ",", 
                      RowBox[{"SparseArray", "[", RowBox[{"coinSep", "//", 
                          "N"}], "]"}]}], "]"}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"initialState", "=", 
                  RowBox[{"LocalizedState", "[", RowBox[{"grid", ",", "pos", 
                      ",", "coin"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{"QWAnimation", "[", RowBox[{"grid", ",", 
                  "evolutionSep", ",", "initialState", ",", "steps", ",", 
                  RowBox[{"\"FrameStride\"", "->", "stride"}], ",", 
                  RowBox[{"PlotLabel", "->", "\"Separable\""}], ",", 
                  RowBox[{"ImageSize", "->", "500"}], ",", RowBox[
                   {"LabelStyle", "->", RowBox[{"Directive", "[", RowBox[
                       {"Bold", ",", "17"}], "]"}]}], ",", RowBox[
                   {"AnimationRunning", "->", "True"}]}], "]"}]}], "Input", 
            CellChangeTimes -> {{3.999477995783309*^9, 
               3.9994782091465187*^9}, {3.9994782413775463*^9, 
