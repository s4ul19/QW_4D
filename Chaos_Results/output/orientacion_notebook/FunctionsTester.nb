Cell["Tomando eigenestados en \
puntos distintos del espectro de energ\[IAcute]as", "Subsubsection", 
                  CellChangeTimes -> {{3.999524388886799*^9, 
                     3.99952441710392*^9}}, ExpressionUUID -> 
                   "7aa5b6d6-4d30-4f4b-a68b-5491a9b7d0c4"],

Cell[BoxData[RowBox[{RowBox[{"(*", RowBox[
                          {"Malla", " ", "y", " ", "operador", " ", "de", 
                          " ", "evoluci\[OAcute]n"}], "*)"}], 
                        "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"Lx", 
                          "=", "100"}], ";"}], "\n", RowBox[{RowBox[{"Ly", 
                          "=", "75"}], ";"}], "\n", RowBox[{RowBox[{"grid", 
                          "=", RowBox[{"GenerateSinaiBasis", "[", RowBox[
                          {"Lx", ",", "Ly"}], "]"}]}], ";"}], "\n", 
                          "\[IndentingNewLine]", RowBox[{RowBox[
                          {"coinMatrix", "=", RowBox[{"N", "[", RowBox[
                          {"RandomMatrix", "[", "\"oo\"", "]"}], "]"}]}], 
                          ";"}], "\n", RowBox[{RowBox[{"S", "=", RowBox[
                          {"BuildShiftOperators", "[", RowBox[{"grid", ",", 
                          RowBox[{"CoinDimension", "->", "4"}]}], "]"}]}], 
                          ";"}], "\[IndentingNewLine]", "\n", RowBox[
                          {RowBox[{"U", "=", RowBox[{"N", "[", RowBox[
                          {"QWEvolutionOperator", "[", RowBox[{"grid", ",", 
                          RowBox[{"SparseArray", "[", "coinMatrix", "]"}]}], 
                          "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
                          RowBox[{"(*", RowBox[{"Seis", " ", "intervalos", 
                          " ", "y", " ", "sus", " ", "centros"}], "*)"}], 
                          "\[IndentingNewLine]", RowBox[{RowBox[{"k", "=", 
                          "10"}], ";"}], "\n", RowBox[{RowBox[{"edges", "=", 
                          RowBox[{"Subdivide", "[", RowBox[{RowBox[{"-", 
                          "Pi"}], ",", "Pi", ",", "k"}], "]"}]}], ";"}], 
                          "\n", RowBox[{RowBox[{"intervals", "=", RowBox[
                          {"Partition", "[", RowBox[{"edges", ",", "2", ",", 
                          "1"}], "]"}]}], ";"}], "\n", RowBox[{RowBox[
                          {"targets", "=", RowBox[{"Mean", "/@", 
                          "intervals"}]}], ";"}], "\n", 
                          "\[IndentingNewLine]", RowBox[{"(*", RowBox[{"Un", 
                          " ", "eigenestado", " ", "pr\[OAcute]ximo", " ", 
                          "al", " ", "centro", " ", "de", " ", "cada", " ", 
                          "intervalo"}], "*)"}], "\[IndentingNewLine]", 
                          RowBox[{RowBox[{"eigenData", "=", RowBox[{"Table", 
                          "[", RowBox[{RowBox[{"Module", "[", RowBox[{RowBox[
                          {"{", RowBox[{"sigma", ",", "vals", ",", "vecs", 
                          ",", "psi", ",", "phase", ",", "residual"}], "}"}], 
                          ",", RowBox[{RowBox[{"sigma", "=", RowBox[{"1.001", 
                          " ", RowBox[{"Exp", "[", RowBox[{RowBox[{"-", 
                          "I"}], " ", RowBox[{"targets", "[", RowBox[{"[", 
                          "j", "]"}], "]"}]}], "]"}]}]}], ";", 
                          "\[IndentingNewLine]", RowBox[{RowBox[{"{", RowBox[
                          {"vals", ",", "vecs"}], "}"}], "=", RowBox[
                          {"Check", "[", RowBox[{RowBox[{"Eigensystem", "[", 
                          RowBox[{"U", ",", RowBox[{"-", "1"}], ",", RowBox[
                          {"Method", "->", RowBox[{"{", RowBox[{
                          "\"Arnoldi\"", ",", RowBox[{"\"Shift\"", "->", 
                          "sigma"}], ",", RowBox[{"\"BasisSize\"", "->", 
                          "60"}], ",", RowBox[{"\"MaxIterations\"", "->", 
                          "5000"}], ",", RowBox[{"\"Tolerance\"", "->", 
                          RowBox[{"10", "^", RowBox[{"-", "10"}]}]}]}], 
                          "}"}]}]}], "]"}], ",", RowBox[{RowBox[{"Print", 
                          "[", RowBox[{"\"No convergi\[OAcute] la \
b\[UAcute]squeda del intervalo \"", ",", "j"}], "]"}], ";", 
                          "\[IndentingNewLine]", RowBox[{"Abort", "[", 
                          "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
                          RowBox[{"psi", "=", RowBox[{"Normalize", "[", 
                          RowBox[{"First", "[", "vecs", "]"}], "]"}]}], ";", 
                          "\[IndentingNewLine]", RowBox[{"phase", "=", RowBox[
                          {"-", RowBox[{"Arg", "[", RowBox[{"First", "[", 
                          "vals", "]"}], "]"}]}]}], ";", 
                          "\[IndentingNewLine]", RowBox[{"residual", "=", 
                          RowBox[{"Norm", "[", RowBox[{RowBox[{"U", ".", 
                          "psi"}], "-", RowBox[{RowBox[{"First", "[", "vals", 
                          "]"}], " ", "psi"}]}], "]"}]}], ";", 
                          "\[IndentingNewLine]", RowBox[{"(*", RowBox[{"No", 
                          " ", "asignar", " ", "a", " ", "un", " ", 
                          "intervalo", " ", "un", " ", "estado", " ", "que", 
                          " ", "qued\[OAcute]", " ", "fuera"}], "*)"}], 
                          RowBox[{"If", "[", RowBox[{RowBox[{"!", RowBox[
                          {"TrueQ", "[", RowBox[{RowBox[{"intervals", "[", 
                          RowBox[{"[", RowBox[{"j", ",", "1"}], "]"}], "]"}], 
                          "<=", "phase", "<=", RowBox[{"intervals", "[", 
                          RowBox[{"[", RowBox[{"j", ",", "2"}], "]"}], 
                          "]"}]}], "]"}]}], ",", RowBox[{RowBox[{"Print", 
                          "[", RowBox[{
                          "\"El eigenestado encontrado para el intervalo \"", 
                          ",", "j", ",", 
                          "\" qued\[OAcute] fuera: \[CurlyEpsilon] = \"", 
                          ",", "phase", ",", "\". Revisa la b\[UAcute]squeda \
o si hay espectro en ese intervalo.\""}], "]"}], ";", "\[IndentingNewLine]", 
                          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
                          "\[IndentingNewLine]", RowBox[{"If", "[", RowBox[
