                          {"LabelStyle", "->", "16"}]}], "]"}], ",", RowBox[
                          {"{", RowBox[{"0.8", ",", "0.75"}], "}"}]}], 
                          "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
                       RowBox[{"  ", RowBox[{RowBox[{"EmpiricalHistogram", 
                          "=", RowBox[{"Histogram", "[", RowBox[{"spacings", 
                          ",", " ", "Automatic", ",", " ", "\"PDF\"", ",", 
