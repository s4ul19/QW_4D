                          {"eigenphases", "[", RowBox[{"[", "order", "]"}], 
                          "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
                       RowBox[{RowBox[{RowBox[{"residuals", "=", RowBox[
                          {"MapThread", "[", RowBox[{RowBox[{RowBox[{"Norm", 
                          "[", RowBox[{RowBox[{"U", ".", "#2"}], "-", RowBox[
                          {"#1", " ", "#2"}]}], "]"}], "&"}], ",", RowBox[
