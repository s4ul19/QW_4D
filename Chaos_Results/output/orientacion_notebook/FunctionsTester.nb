Cell[CellGroupData[{

Cell["3. Escala de probabilidad", "Section", 
            CellChangeTimes -> {{3.999474864006109*^9, 
               3.9994748641139927*^9}, {3.999477419969658*^9, 
               3.9994774350559397*^9}}, ExpressionUUID -> 
             "f47befb4-e996-4c11-89e7-2d79c7cc9491"],

Cell["Cada leyenda \
indica la cantidad transformada. ProbabilityRange siempre recibe \
probabilidades originales. Squared se conserva por compatibilidad; Sqrt y \
CubeRoot resaltan regiones de baja probabilidad.", "Text", ExpressionUUID -> 
             "016bf952-145f-4b3c-80c4-3f24eed012cb"],

Cell[BoxData[{RowBox[{RowBox[{"grid", "=", 
                     RowBox[{"GenerateRectangleBasis", "[", RowBox[{"8", ",", 
                         "5"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
                 RowBox[{RowBox[{"coin", "=", RowBox[{"Normalize", "[", 
                       RowBox[{"{", RowBox[{"1", ",", "\[ImaginaryI]", ",", 
                          RowBox[{"-", "1"}], ",", "0"}], "}"}], "]"}]}], 
                   ";"}], "\[IndentingNewLine]", RowBox[{RowBox[
                    {RowBox[{"psi", "=", RowBox[{"GaussianState", "[", 
                         RowBox[{"grid", ",", RowBox[{"{", RowBox[{"2", ",", 
                          "3"}], "}"}], ",", "coin", ",", "1.2`"}], "]"}]}], 
                     ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
                 RowBox[{RowBox[{"scales", "=", RowBox[{"{", RowBox[
                        {"\"Linear\"", ",", "\"Sqrt\"", ",", "\"CubeRoot\"", 
                         ",", "\"Squared\"", ",", "\"Log\""}], "}"}]}], 
                   ";"}], "\[IndentingNewLine]", RowBox[{"{", RowBox[
                    {RowBox[{"DiscreteProbabilityPlot", "[", RowBox[{"grid", 
                         ",", "psi", ",", RowBox[{"InputType", "\[Rule]", 
                          "\"State\""}], ",", RowBox[{"PlotLabel", "\[Rule]", 
                          "\"Default\""}], ",", RowBox[{"ImageSize", 
                          "\[Rule]", "360"}]}], "]"}], ",", RowBox[
                      {"Flatten", "[", RowBox[{RowBox[{RowBox[
                          {"DiscreteProbabilityPlot", "[", RowBox[{"grid", 
                          ",", "psi", ",", RowBox[{"InputType", "\[Rule]", 
                          "\"State\""}], ",", RowBox[{"PlotLabel", "\[Rule]", 
                          "#"}], ",", RowBox[{"ProbabilityScale", "->", 
                          "#"}], ",", RowBox[{"ImageSize", "\[Rule]", 
                          "360"}]}], "]"}], "&"}], "/@", "scales"}], "]"}]}], 
                   "}"}]}], "Input", CellChangeTimes -> 
                {{3.999474638004678*^9, 3.999474651853632*^9}, 
                 {3.999476756961096*^9, 3.999476834307543*^9}, 
                 {3.999476922099757*^9, 3.999476923948555*^9}}, 
