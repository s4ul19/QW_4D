         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"COECoinGenerator[coin] returns a real symmetric \
generator K with coin = MatrixExp[-I K], using the principal matrix \
logarithm. Supply a finite symmetric unitary 4 x 4 coin in {U,D,R,L} order; \
RandomMatrix[\\\"o\\\"] generates one. The logarithm branch is fixed for this \
coin.\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
