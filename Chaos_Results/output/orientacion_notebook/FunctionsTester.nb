Cell[CellGroupData[{

Cell["Definir una diagonalizacion por cada rectangulo", 
               "Subsection", CellChangeTimes -> {{3.99977325228832*^9, 
                  3.999773259558394*^9}}, ExpressionUUID -> 
                "2c96056c-3b0e-4631-9002-58b404051124"],

Cell["Cada entrada \
{ancho, alto} cuenta posiciones, no indices maximos. \
GenerateRectangleBasis[ancho-1, alto-1] produce ancho x alto posiciones. Con \
cuatro estados de moneda, el operador U = S . (I KroneckerProduct C) tiene \
dimension 4 ancho alto. Se calculan todos los autovalores de la matriz densa; \
esta eleccion solo es razonable mientras quepa en la memoria del nodo.", 
               "Text", ExpressionUUID -> 
                "dc7b0c7b-a740-4446-acb5-b0154a70fc10"],

Cell[BoxData[
                RowBox[{RowBox[{"calcularEspectro", " ", "=", " ", 
                    RowBox[{"Function", "[", RowBox[{"par", ",", "\n", "  ", 
                        RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                          {"base", ",", " ", "dim", ",", " ", "s", ",", " ", 
                          "moneda", ",", " ", "u", ",", " ", "vals"}], "}"}], 
                          ",", "\n", "    ", RowBox[{RowBox[{"base", " ", 
                          "=", " ", RowBox[{
                          "QuantumWalks`Billiards`GenerateRectangleBasis", 
                          "[", RowBox[{RowBox[{RowBox[{"par", "[", RowBox[
                          {"[", "1", "]"}], "]"}], " ", "-", " ", "1"}], ",", 
                          " ", RowBox[{RowBox[{"par", "[", RowBox[{"[", "2", 
                          "]"}], "]"}], " ", "-", " ", "1"}]}], "]"}]}], ";", 
                          "\n", "    ", RowBox[{"dim", " ", "=", " ", RowBox[
                          {"base", "[", "\"Dimension\"", "]"}]}], ";", "\n", 
                          "    ", RowBox[{"s", " ", "=", " ", RowBox[
                          {"QuantumWalks`Billiards`BuildShiftOperators", "[", 
                          RowBox[{"base", ",", "\n", "      ", RowBox[
                          {"QuantumWalks`Billiards`CoinDimension", " ", "->", 
                          " ", "4"}]}], "]"}]}], ";", "\n", "    ", RowBox[
                          {"moneda", " ", "=", " ", RowBox[
                          {"QuantumWalks`Billiards`GeneralizedGroverCoin", 
                          "[", RowBox[{"Pi", "/", "4."}], "]"}]}], ";", "\n", 
                          "    ", RowBox[{"u", " ", "=", " ", RowBox[{"s", 
                          " ", ".", " ", RowBox[{"KroneckerProduct", "[", 
                          RowBox[{RowBox[{"IdentityMatrix", "[", RowBox[
                          {"dim", ",", " ", "SparseArray"}], "]"}], ",", " ", 
                          RowBox[{"SparseArray", "[", "moneda", "]"}]}], 
                          "]"}]}]}], ";", "\n", "    ", RowBox[{"vals", " ", 
                          "=", " ", RowBox[{"Eigenvalues", "[", RowBox[
                          {"Normal", "[", "u", "]"}], "]"}]}], ";", "\n", 
                          "    ", RowBox[{"<|", RowBox[{RowBox[{"\"Nodo\"", 
                          " ", "->", " ", "$MachineName"}], ",", " ", RowBox[
                          {"\"Proceso\"", " ", "->", " ", "$ProcessID"}], 
                          ",", "\n", "      ", RowBox[{"\"Tamano\"", " ", 
                          "->", " ", "par"}], ",", " ", RowBox[
                          {"\"DimensionU\"", " ", "->", " ", RowBox[
                          {"Dimensions", "[", "u", "]"}]}], ",", "\n", 
                          "      ", RowBox[{"\"Autovalores\"", " ", "->", 
                          " ", "vals"}], ",", " ", RowBox[{"\"ErrorModulo\"", 
                          " ", "->", " ", RowBox[{"Max", "[", RowBox[{"Abs", 
                          "[", RowBox[{RowBox[{"Abs", "[", "vals", "]"}], 
                          " ", "-", " ", "1"}], "]"}], "]"}]}]}], "|>"}]}]}], 
                          "\n", "  ", "]"}]}], "\n", "]"}]}], ";"}]], 
               "Input", ExpressionUUID -> 
                "4e2ac9ca-5c22-48a0-bed3-3ea5f47cad2d"],

Cell[BoxData[""], 
               "Input", CellChangeTimes -> {{3.999773735965343*^9, 
                  3.9997739089438334*^9}, 3.999774056403637*^9}, 
               ExpressionUUID -> "98f7ddf2-0e2c-4e2a-96b8-8e5ce6e41ed0"]
}, Open  ]],

Cell[CellGroupData[{

Cell[" Ejecutar cuatro trabajos en dos kernels", "Subsection", 
               CellChangeTimes -> {{3.9997732875120697*^9, 
                  3.9997732876339083*^9}}, ExpressionUUID -> 
                "ffb4cc3c-e3df-4b41-b9bc-6249cee4c4c4"],

Cell[BoxData[RowBox[{RowBox[{"resultados", " ", "=", " ", 
                       RowBox[{"EjecutarEnNodo", "[", RowBox[{"\"nodo1\"", 
                          ",", " ", "2", ",", " ", "calcularEspectro", ",", 
                          "\n", "  ", RowBox[{"{", RowBox[{RowBox[{"{", 
                          RowBox[{"3", ",", " ", "2"}], "}"}], ",", " ", 
                          RowBox[{"{", RowBox[{"4", ",", " ", "2"}], "}"}], 
                          ",", " ", RowBox[{"{", RowBox[{"5", ",", " ", 
                          "2"}], "}"}], ",", " ", RowBox[{"{", RowBox[{"6", 
                          ",", " ", "2"}], "}"}]}], "}"}], ",", " ", 
                          "prepararQuantumWalks"}], "]"}]}], ";"}]], "Input", 
                  ExpressionUUID -> "6fcbd325-cd32-4c93-b48e-3b3715ff3f04"],

Cell["Cada entrada \
se calcula completa en un kernel. Los resultados regresan en el mismo orden \
de la lista de entradas. Los identificadores de proceso permiten comprobar \
que participaron dos kernels. ErrorModulo mide cuanto se aleja el modulo de \
cada autovalor de 1.", "Text", ExpressionUUID -> 
                "a8bc2561-bdd9-4f30-a45f-04511d5b4b2b"],

Cell[BoxData[RowBox[{"If", "[", RowBox[{RowBox[{"ListQ", 
                         "[", "resultados", "]"}], ",", "\n", "  ", RowBox[
                        {"resultados", "[", RowBox[{"[", RowBox[{"All", ",", 
                          " ", RowBox[{"{", RowBox[{"\"Tamano\"", ",", " ", 
                          "\"Nodo\"", ",", " ", "\"Proceso\"", ",", " ", 
                          "\"DimensionU\"", ",", " ", "\"ErrorModulo\""}], 
                          "}"}]}], "]"}], "]"}], ",", "\n", "  ", 
                       "resultados"}], "\n", "]"}]], "Input", 
                  ExpressionUUID -> "e0da8eeb-11e1-44bd-8488-23b10a4d954a"],

Cell[BoxData[RowBox[{"If", "[", 
                     RowBox[{RowBox[{"ListQ", "[", "resultados", "]"}], ",", 
                       "\n", "  ", RowBox[{"{", RowBox[{RowBox[
                          {"DeleteDuplicates", "[", RowBox[{"resultados", 
                          "[", RowBox[{"[", RowBox[{"All", ",", " ", 
                          "\"Proceso\""}], "]"}], "]"}], "]"}], ",", "\n", 
                          "   ", RowBox[{"Length", " ", "/@", " ", RowBox[
                          {"resultados", "[", RowBox[{"[", RowBox[{"All", 
                          ",", " ", "\"Autovalores\""}], "]"}], "]"}]}]}], 
                         "}"}], ",", "\n", "  ", "resultados"}], "\n", 
                     "]"}]], "Input", ExpressionUUID -> 
                   "31be690b-4df7-4e21-9c71-b3725a4c0e91"]
}, Open  ]]
}, Closed]],

