Cell[CellGroupData[{

Cell["3. Enviar los cuatro trabajos", "Section",ExpressionUUID->"5a22e07d-2fc3-4751-9648-a5abb8a97cb7"],

Cell["\<\
La celda termina cuando los nodos aceptan los trabajos. Despu\[EAcute]s \
puedes usar o cerrar la Mac. No vuelvas a ejecutar esta celda para consultar \
el avance: cada env\[IAcute]o crea un trabajo nuevo.\
\>", "Text",ExpressionUUID->"4e78d485-8ee1-454e-b2b4-51c2ef331ae7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"jobs", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"SubmitNodeJob", "[", 
      RowBox[{
       RowBox[{"#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
       RowBox[{"#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",",
        "calcularEspectro", ",", 
       RowBox[{"#1", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], ",",
        "prepararQuantumWalks"}], "]"}], "&"}], ")"}], "/@", 
   "trabajos"}]}]], "Input",
 CellLabel->
  "In[138]:=",ExpressionUUID->"14943fbf-a28f-41ac-af6b-3db1e666a75a"],

