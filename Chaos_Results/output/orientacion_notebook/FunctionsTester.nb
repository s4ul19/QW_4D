Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Malla", " ", "y", " ", "operador"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Lx", "=", "30"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Ly", "=", "30"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"grid", "=", 
     RowBox[{"GenerateRectangleBasis", "[", 
      RowBox[{"Lx", ",", "Ly"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"coinMatrix", "=", 
     RowBox[{"N", "[", 
      RowBox[{"RandomMatrix", "[", "\"\<o\>\"", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"S", "=", 
     RowBox[{"BuildShiftOperators", "[", 
      RowBox[{"grid", ",", 
       RowBox[{"CoinDimension", "->", "4"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"U", "=", 
     RowBox[{"N", "[", 
      RowBox[{"QWEvolutionOperator", "[", 
       RowBox[{"grid", ",", 
        RowBox[{"SparseArray", "[", "coinMatrix", "]"}]}], "]"}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Espectro", " ", 
     RowBox[{"completo", ":", 
      RowBox[{
      "eigenvalores", " ", "y", " ", "vectores", " ", 
       "correspondientes"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eigenvalues", ",", "eigenvectors"}], "}"}], "=", 
     RowBox[{"Eigensystem", "[", 
      RowBox[{"Normal", "[", "U", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eigenvectors", "=", 
     RowBox[{"Normalize", "/@", "eigenvectors"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eigenphases", "=", 
     RowBox[{"-", 
      RowBox[{"Arg", "[", "eigenvalues", "]"}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9995251243067913`*^9, 3.999525137649678*^9}, {
   3.999525223740789*^9, 3.999525224230199*^9}, {3.999525283460822*^9, 
   3.999525346636983*^9}, 3.999549281487048*^9, {3.999971051626944*^9, 
   3.999971051688476*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"14899309-9c66-48d7-bd29-05ca74a61859"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Dividir", " ", "las", " ", "eigenfases", " ", "en", " ", 
    "subintervalos"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"nIntervals", "=", "15"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"columns", "=", "3"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"edges", "=", 
     RowBox[{"N", "[", 
      RowBox[{"Subdivide", "[", 
       RowBox[{
        RowBox[{"-", "Pi"}], ",", "Pi", ",", "nIntervals"}], "]"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"intervals", "=", 
     RowBox[{"Partition", "[", 
      RowBox[{"edges", ",", "2", ",", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"centers", "=", 
     RowBox[{"Mean", "/@", "intervals"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Seleccionar", " ", "un", " ", "eigenestado", " ", "cercano", " ", "al", " ",
      "centro", " ", "de", " ", "cada", " ", "intervalo"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"selectedIndices", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "candidates", "}"}], ",", 
         RowBox[{
          RowBox[{"candidates", "=", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"Length", "[", "eigenphases", "]"}], "]"}], ",", 
             RowBox[{"Function", "[", 
              RowBox[{"index", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"intervals", "[", 
                  RowBox[{"[", 
                   RowBox[{"j", ",", "1"}], "]"}], "]"}], "<=", 
                 RowBox[{"eigenphases", "[", 
                  RowBox[{"[", "index", "]"}], "]"}]}], "&&", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"j", "==", "nIntervals"}], ",", 
                  RowBox[{
                   RowBox[{"eigenphases", "[", 
                    RowBox[{"[", "index", "]"}], "]"}], "<=", 
                   RowBox[{"intervals", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "2"}], "]"}], "]"}]}], ",", 
                  RowBox[{
                   RowBox[{"eigenphases", "[", 
                    RowBox[{"[", "index", "]"}], "]"}], "<", 
                   RowBox[{"intervals", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "2"}], "]"}], "]"}]}]}], "]"}]}]}], 
              "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"candidates", "===", 
             RowBox[{"{", "}"}]}], ",", 
            RowBox[{"Missing", "[", "\"\<EmptyInterval\>\"", "]"}], ",", 
            RowBox[{"First", "[", 
             RowBox[{"MinimalBy", "[", 
              RowBox[{"candidates", ",", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{"eigenphases", "[", 
                   RowBox[{"[", "#", "]"}], "]"}], "-", 
                  RowBox[{"centers", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "&"}]}], "]"}], 
             "]"}]}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "nIntervals"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Construir", " ", "cada", " ", "panel"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plots", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "index", ",", "density", ",", "residual", ",", "header", ",", 
           "graphic", ",", "dmax"}], "}"}], ",", 
         RowBox[{
          RowBox[{"index", "=", 
           RowBox[{"selectedIndices", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"header", "=", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<Intervalo \>\"", ",", "j", ",", "\"\<: \>\"", ",", 
              RowBox[{"NumberForm", "[", 
               RowBox[{
                RowBox[{"intervals", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", ",", "1"}], "]"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"4", ",", "2"}], "}"}]}], "]"}], ",", "\"\< a \>\"", 
              ",", 
              RowBox[{"NumberForm", "[", 
               RowBox[{
                RowBox[{"intervals", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", ",", "2"}], "]"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"4", ",", "2"}], "}"}]}], "]"}]}], "}"}], "]"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"MissingQ", "[", "index", "]"}], ",", 
            RowBox[{"Column", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{"header", ",", "12", ",", "Bold"}], "]"}], 
                ",", "\"\<Sin eigenestados\>\""}], "}"}], ",", 
              RowBox[{"Alignment", "->", "Center"}]}], "]"}], ",", 
            RowBox[{
             RowBox[{"density", "=", 
              RowBox[{"ComputeSpatialIPRDensity", "[", 
               RowBox[{
                RowBox[{"eigenvectors", "[", 
                 RowBox[{"[", "index", "]"}], "]"}], ",", "4"}], "]"}]}], ";",
              "\[IndentingNewLine]", 
             RowBox[{"dmax", "=", 
              RowBox[{"Max", "[", "density", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"residual", "=", 
              RowBox[{"Norm", "[", 
               RowBox[{
                RowBox[{"U", ".", 
                 RowBox[{"eigenvectors", "[", 
                  RowBox[{"[", "index", "]"}], "]"}]}], "-", 
                RowBox[{
                 RowBox[{"eigenvalues", "[", 
                  RowBox[{"[", "index", "]"}], "]"}], " ", 
                 RowBox[{"eigenvectors", "[", 
                  RowBox[{"[", "index", "]"}], "]"}]}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"graphic", "=", 
              RowBox[{"DiscreteProbabilityPlot", "[", 
               RowBox[{"grid", ",", "density", ",", 
                RowBox[{"ProbabilityScale", "->", "\"\<Linear\>\""}], ",", 
                RowBox[{"ProbabilityRange", "->", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", "dmax"}], "}"}]}], ",", 
                RowBox[{"ColorFunction", "->", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"GrayLevel", "[", 
                    RowBox[{"1", "-", "#"}], "]"}], "&"}], ")"}]}], ",", 
                RowBox[{"PlotLabel", "->", "None"}], ",", 
                RowBox[{"FrameLabel", "->", 
                 RowBox[{"{", 
                  RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
                RowBox[{"LabelStyle", "->", 
                 RowBox[{"Directive", "[", 
                  RowBox[{"Black", ",", "11"}], "]"}]}], ",", 
                RowBox[{"ImagePadding", "->", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"45", ",", "15"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"45", ",", "15"}], "}"}]}], "}"}]}], ",", 
                RowBox[{"ImageSize", "->", "320"}], ",", 
                RowBox[{"(*", 
                 RowBox[{"Leyenda", ":", 
                  RowBox[{
                  "normalizar", " ", "la", " ", "densidad", " ", "para", " ", 
                   "asignar", " ", "el", " ", "color"}]}], "*)"}], 
                RowBox[{"PlotLegends", "->", 
                 RowBox[{"With", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"upper", "=", "dmax"}], "}"}], ",", 
                   RowBox[{"Placed", "[", 
                    RowBox[{
                    RowBox[{"BarLegend", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{"value", ",", 
                    RowBox[{"GrayLevel", "[", 
                    RowBox[{"1", "-", 
                    RowBox[{"Clip", "[", 
                    RowBox[{
                    RowBox[{"value", "/", "upper"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], "]"}]}], "]"}],
                     ",", 
                    RowBox[{"{", 
                    RowBox[{"0", ",", "upper"}], "}"}]}], "}"}], ",", 
                    RowBox[{"LegendLabel", "->", "\"\<I\:2099\>\""}], ",", 
                    RowBox[{"LegendMarkerSize", "->", 
                    RowBox[{"{", 
                    RowBox[{"18", ",", "180"}], "}"}]}], ",", 
                    RowBox[{"LabelStyle", "->", 
                    RowBox[{"Directive", "[", 
                    RowBox[{"Black", ",", "10"}], "]"}]}]}], "]"}], ",", 
                    "Right"}], "]"}]}], "]"}]}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Column", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"header", ",", "12", ",", "Bold"}], "]"}], ",", 
                 RowBox[{"Style", "[", 
                  RowBox[{
                   RowBox[{"Row", "[", 
                    RowBox[{"{", 
                    RowBox[{"\"\<\[CurlyEpsilon] = \>\"", ",", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{
                    RowBox[{"eigenphases", "[", 
                    RowBox[{"[", "index", "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"6", ",", "4"}], "}"}]}], "]"}], 
                    ",", "\"\<   IPR = \>\"", ",", 
                    RowBox[{"ScientificForm", "[", 
                    RowBox[{
                    RowBox[{"Total", "[", "density", "]"}], ",", "3"}], 
                    "]"}]}], "}"}], "]"}], ",", "11"}], "]"}], ",", 
                 RowBox[{"Style", "[", 
                  RowBox[{
                   RowBox[{"Row", "[", 
                    RowBox[{"{", 
                    RowBox[{"\"\<Residuo = \>\"", ",", 
                    RowBox[{"ScientificForm", "[", 
                    RowBox[{"residual", ",", "2"}], "]"}]}], "}"}], "]"}], ",",
                    "10", ",", 
                   RowBox[{"GrayLevel", "[", "0.35", "]"}]}], "]"}], ",", 
                 "graphic"}], "}"}], ",", 
               RowBox[{"Alignment", "->", "Center"}], ",", 
               RowBox[{"Spacings", "->", "0.4"}]}], "]"}]}]}], "]"}]}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "nIntervals"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Organizar", " ", "los", " ", "paneles"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"panel", "=", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Partition", "[", 
        RowBox[{
         RowBox[{"PadRight", "[", 
          RowBox[{"plots", ",", 
           RowBox[{"columns", " ", 
            RowBox[{"Ceiling", "[", 
             RowBox[{"nIntervals", "/", "columns"}], "]"}]}], 
           ",", "\"\<\>\""}], "]"}], ",", "columns"}], "]"}], ",", 
       RowBox[{"Alignment", "->", 
        RowBox[{"{", 
         RowBox[{"Center", ",", "Top"}], "}"}]}], ",", 
       RowBox[{"Spacings", "->", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Convertir", " ", "el", " ", "conjunto", " ", "en", " ", "una", " ", 
     "\[UAcute]nica", " ", "imagen"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"imagen", "=", 
     RowBox[{"Rasterize", "[", 
      RowBox[{"panel", ",", "\"\<Image\>\"", ",", 
       RowBox[{"ImageResolution", "->", "200"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "imagen"}]}]], "Input",
