Cell[CellGroupData[{

Cell["5. Descargar y analizar", "Section",ExpressionUUID->"bb754202-e65b-4035-97cd-795cdae8ddbd"],

Cell["\<\
Ejecuta cuando todos los ResultReady sean True. Los resultados vuelven por \
SCP; si falla la descarga, puedes repetirla sin recalcular. Los originales \
permanecen en el disco de Mazinger.\
\>", "Text",ExpressionUUID->"5ff6e89c-87f6-4e4c-8234-def52a30dfc5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"estados", "=", 
   RowBox[{"NodeJobStatus", "/@", "jobs"}]}], ";", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"AllTrue", "[", 
     RowBox[{"estados", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"AssociationQ", "[", "#1", "]"}], "&&", 
        RowBox[{"TrueQ", "[", 
         RowBox[{"#1", "[", "\"\<ResultReady\>\"", "]"}], "]"}]}], "&"}]}], 
     "]"}], ",", 
    RowBox[{
     RowBox[{"resultadosPorNodo", "=", 
      RowBox[{"FetchNodeJobResults", "/@", "jobs"}]}], ";", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{"resultadosPorNodo", ",", "ListQ"}], "]"}], ",", 
       RowBox[{
        RowBox[{"espectros", "=", 
         RowBox[{"Join", "@@", "resultadosPorNodo"}]}], ";", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Espectros recuperados: \>\"", ",", 
          RowBox[{"Length", "[", "espectros", "]"}]}], "]"}]}], ",", 
       RowBox[{
       "Print", 
        "[", "\"\<Una descarga fall\[OAcute]. Revisa resultadosPorNodo y \
repite esta celda.\>\"", "]"}]}], "]"}]}], ",", 
    RowBox[{
    "Print", "[", "\"\<A\[UAcute]n no est\[AAcute]n listos todos los lotes. \
Revisa estados.\>\"", "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[72]:=",ExpressionUUID->"c5b3f1c6-0470-423d-8096-10988f44be7d"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Espectros recuperados: \"\>", "\[InvisibleSpace]", "235"}],
  SequenceForm["Espectros recuperados: ", 235],
  Editable->False]], "Print",
