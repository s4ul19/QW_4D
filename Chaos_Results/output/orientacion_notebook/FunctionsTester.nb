                          "labels", ",", RowBox[{"LegendLabel", "->", 
                          "\"Moneda\""}]}], "]"}], ",", "Right"}], "]"}]}], 
                          ",", RowBox[{"ScalingFunctions", "->", "None"}], 
                          ",", RowBox[{"Frame", "->", "True"}], ",", RowBox[
                          {"Axes", "->", "False"}], ",", RowBox[
                          {"FrameLabel", "->", RowBox[{"{", RowBox[
