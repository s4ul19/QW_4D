Cell[CellGroupData[{

Cell["Preparar QuantumWalks en cada kernel", 
               "Subsection", CellChangeTimes -> {{3.999773249756649*^9, 
                  3.9997732506433773*^9}}, ExpressionUUID -> 
                "8f20b323-ea66-41eb-96d3-cd8d45753c16"],

Cell["La ruta \
corresponde a la copia de QuantumWalks que ya existe en tu cuenta del \
cluster. PacletDirectoryLoad solo la hace visible durante la sesion temporal. \
Se carga ForScience y luego QuantumWalks en cada kernel del nodo. El bloque \
de FormatUsage evita un problema de formato de ayudas cuando no hay interfaz \
grafica en el nodo.", "Text", ExpressionUUID -> 
                "43df68e2-d9f8-44d5-afa2-060729a77c9a"],

Cell[BoxData[
                RowBox[{RowBox[{"prepararQuantumWalks", " ", "=", " ", 
                    RowBox[{"Function", "[", "\n", "  ", RowBox[{"Module", 
                        "[", RowBox[{RowBox[{"{", RowBox[{"ruta", " ", "=", 
                          " ", RowBox[{"FileNameJoin", "[", RowBox[{"{", 
                          RowBox[{RowBox[{"Replace", "[", RowBox[{RowBox[
                          {"Environment", "[", "\"QW_PROJECT_ROOT\"", "]"}], 
                          ",", RowBox[{RowBox[{"Except", "[", "_String", 
                          "]"}], "\[RuleDelayed]", RowBox[{"FileNameJoin", 
                          "[", RowBox[{"{", RowBox[{"$HomeDirectory", ",", 
                          "\"QW\""}], "}"}], "]"}]}]}], "]"}], ",", 
                          "\"JA_libs\"", ",", "\"QuantumWalks\""}], "}"}], 
                          "]"}]}], "}"}], ",", "\n", "    ", RowBox[{"If", 
                          "[", RowBox[{RowBox[{"DirectoryQ", "[", "ruta", 
                          "]"}], ",", "\n", "      ", RowBox[{RowBox[
                          {"PacletDirectoryLoad", "[", "ruta", "]"}], ";", 
                          "\n", "      ", RowBox[{"Needs", "[", 
                          "\"ForScience`\"", "]"}], ";", "\n", "      ", 
                          RowBox[{"Block", "[", RowBox[{RowBox[{"{", RowBox[
                          {"ForScience`PacletUtils`FormatUsage", " ", "=", 
                          " ", "Identity"}], "}"}], ",", " ", RowBox[
                          {"Needs", "[", "\"QuantumWalks`\"", "]"}]}], "]"}], 
                          ";", "\n", "      ", RowBox[{RowBox[{"MemberQ", 
                          "[", RowBox[{"$Packages", ",", " ", 
                          "\"ForScience`\""}], "]"}], " ", "&&", "\n", 
                          "        ", RowBox[{RowBox[{"Length", "[", RowBox[
                          {"DownValues", "[", 
                          "QuantumWalks`Billiards`GenerateRectangleBasis", 
                          "]"}], "]"}], " ", ">", " ", "0"}]}]}], ",", "\n", 
                          "      ", "False"}], "\n", "    ", "]"}]}], "\n", 
                        "  ", "]"}], "\n", "]"}]}], ";"}]], "Input", 
