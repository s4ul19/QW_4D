Cell[CellGroupData[{

Cell["Cancelar un trabajo, si lo necesitas", "Section",ExpressionUUID->"5a71e8d5-e32a-48ef-882e-38b641edf300"],

Cell["\<\
Abortar una celda de la Mac no detiene un trabajo independiente. Para \
solicitar cancelar \[UAcute]nicamente el cuarto trabajo, eval\[UAcute]a \
CancelNodeJob[jobs[[4]]] en una celda nueva y consulta despu\[EAcute]s su \
estado. Los archivos que ya se guardaron se conservan.\
\>", "Text",ExpressionUUID->"c4ecb30a-1a9b-44b5-ac87-a0ac8f0ff057"]
}, Open  ]]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["CoinsInterpolation", "Title",
 CellChangeTimes->{{4.0001353069167624`*^9, 4.000135310369718*^9}, {
  4.000137643444056*^9, 
  4.0001376508594418`*^9}},ExpressionUUID->"0178a25a-cbad-4ec2-8c96-\
d6835f33e16f"],

Cell[CellGroupData[{

Cell["Rectangulo", "Chapter",
 CellChangeTimes->{{4.000113907459635*^9, 
  4.0001139088276663`*^9}},ExpressionUUID->"e2384af4-9e33-4693-a226-\
9230fd7074ef"],

Cell[CellGroupData[{

Cell[" Preparar los datos y la funci\[OAcute]n", "Section",
 CellChangeTimes->{{4.0000524848677397`*^9, 
  4.000052485791286*^9}},ExpressionUUID->"5c0d0362-75db-4322-b903-\
379cc8974b91"],

Cell["\<\
Estos tama\[NTilde]os y cantidades son un ejemplo para 235 monedas. Puedes \
conservar los valores y funciones que ya definiste en FunctionsTester.nb. \
PrepararQuantumWalks carga las dependencias en cada trabajador remoto.\
\>", "Text",ExpressionUUID->"abc0324c-bd45-4a88-9bd1-377cb744885c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Lx", "=", "30"}], ";", 
  RowBox[{"Ly", "=", "25"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"n1", "=", "50"}], ";", 
   RowBox[{"n2", "=", "50"}], ";", 
   RowBox[{"n3", "=", "75"}], ";", 
   RowBox[{"n4", "=", "60"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"valoresT", "=", 
    RowBox[{"N", "[", 
     RowBox[{"Subdivide", "[", 
      RowBox[{"0", ",", "1", ",", 
       RowBox[{"n1", "+", "n2", "+", "n3", "+", "n4", "-", "1"}]}], "]"}], 
     "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Monedas", " ", "fijas", " ", "de", " ", "los", " ", "dos", " ", 
    "extremos"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coinOO", "=", 
   RowBox[{"N", "[", 
    RowBox[{"RandomMatrix", "[", 
     RowBox[{"\"\<oo\>\"", ",", 
      RowBox[{"RandomSeed", "->", "23"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"coinO", "=", 
    RowBox[{"N", "[", 
     RowBox[{"RandomMatrix", "[", 
      RowBox[{"\"\<o\>\"", ",", 
       RowBox[{"RandomSeed", "->", "23"}]}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"kOO", "=", 
   RowBox[{"COECoinGenerator", "[", "coinOO", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kO", "=", 
    RowBox[{"COECoinGenerator", "[", "coinO", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"calcularRPorT", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", "=", "kOO"}], ",", 
       RowBox[{"b", "=", "kO"}], ",", 
       RowBox[{"lx", "=", "Lx"}], ",", 
       RowBox[{"ly", "=", "Ly"}]}], "}"}], ",", 
     RowBox[{"Function", "[", 
      RowBox[{"valorT", ",", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "grid", ",", "coin", ",", "phases", ",", "data", ",", "ratios"}], 
          "}"}], ",", 
         RowBox[{
          RowBox[{"grid", "=", 
           RowBox[{"GenerateRectangleBasis", "[", 
            RowBox[{"lx", ",", "ly"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"t", "=", 
             RowBox[{"0", ":", "coinOO"}]}], ";", 
            RowBox[{"t", "=", 
             RowBox[{"1", ":", "coinO"}]}]}], "*)"}], 
          RowBox[{"coin", "=", 
           RowBox[{"N", "[", 
            RowBox[{"MatrixExp", "[", 
             RowBox[{
              RowBox[{"-", "I"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "-", "valorT"}], ")"}], " ", "a"}], "+", 
                RowBox[{"valorT", " ", "b"}]}], ")"}]}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"MatrixQ", "[", 
              RowBox[{"coin", ",", "NumberQ"}], "]"}]}], ",", 
            RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"phases", "=", 
           RowBox[{"QWEigenphases", "[", 
            RowBox[{"grid", ",", "coin"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"ListQ", "[", "phases", "]"}]}], ",", 
            RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"data", "=", 
           RowBox[{"QWPr", "[", 
            RowBox[{"phases", ",", 
             RowBox[{"\"\<AllowDegeneracies\>\"", "->", "True"}], ",", 
             RowBox[{"ReturnData", "->", "True"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"AssociationQ", "[", "data", "]"}]}], ",", 
            RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"ratios", "=", 
           RowBox[{"Lookup", "[", 
            RowBox[{"data", ",", "\"\<Ratios\>\"", ",", 
             RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"!", 
              RowBox[{"VectorQ", "[", 
               RowBox[{"ratios", ",", "NumberQ"}], "]"}]}], "||", 
             RowBox[{"ratios", "===", 
              RowBox[{"{", "}"}]}]}], ",", 
            RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"valorT", ",", 
            RowBox[{"Mean", "[", "ratios", "]"}]}], "}"}]}]}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.0000547151829453`*^9, 4.000054716375059*^9}, {
  4.000059615440139*^9, 4.000059615730855*^9}, {4.000135358850217*^9, 
  4.000135378805781*^9}, {4.0001377489298773`*^9, 4.000137749147143*^9}},
 CellLabel->"In[68]:=",ExpressionUUID->"4b198186-ffdf-4a4c-95c4-604ce5e975a6"]
}, Closed]],

Cell[CellGroupData[{

Cell["3. Enviar los cuatro trabajos", "Section",ExpressionUUID->"6fb95556-bfb9-42b5-b755-c8a269e813b2"],

Cell["\<\
La celda termina cuando los nodos aceptan los trabajos. Despu\[EAcute]s \
puedes usar o cerrar la Mac. No vuelvas a ejecutar esta celda para consultar \
el avance: cada env\[IAcute]o crea un trabajo nuevo.\
\>", "Text",ExpressionUUID->"72926d3a-63b4-489c-946b-86731fe29567"],

Cell[BoxData[
 RowBox[{
  RowBox[{"trabajos", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<nodo1\>\"", ",", "15", ",", 
       RowBox[{"valoresT", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "n1"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<nodo2\>\"", ",", "10", ",", 
       RowBox[{"valoresT", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"n1", "+", "1"}], ";;", 
          RowBox[{"n1", "+", "n2"}]}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<nodo3\>\"", ",", "12", ",", 
       RowBox[{"valoresT", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"n1", "+", "n2", "+", "1"}], ";;", 
          RowBox[{"n1", "+", "n2", "+", "n3"}]}], "]"}], "]"}]}], "}"}], ",", 
     
     RowBox[{"{", 
      RowBox[{"\"\<nodo4\>\"", ",", "6", ",", 
       RowBox[{"valoresT", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"n1", "+", "n2", "+", "n3", "+", "1"}], ";;", 
          RowBox[{"n1", "+", "n2", "+", "n3", "+", "n4"}]}], "]"}], "]"}]}], 
      "}"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.000135441271924*^9, 4.000135450240316*^9}, {
  4.000137765883184*^9, 4.00013779221364*^9}},
 CellLabel->"In[77]:=",ExpressionUUID->"bc7b914e-28fe-4c51-ba87-0a1263f8805d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"jobs", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"SubmitNodeJob", "[", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", "calcularRPorT", ",", 
       RowBox[{"#", "[", 
        RowBox[{"[", "3", "]"}], "]"}], ",", "prepararBarridoCOE"}], "]"}], 
     "&"}], "/@", "trabajos"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.000137809103475*^9, 4.000137809103541*^9}},
 CellLabel->"In[78]:=",ExpressionUUID->"1aee9a3e-0b1b-42f0-baee-e7954772fc0e"],

