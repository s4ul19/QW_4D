Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "13", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lx", "=", "80"}], ";", " ", 
  RowBox[{"Ly", "=", "80"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"grid", "=", 
   RowBox[{"GenerateRectangleBasis", "[", 
    RowBox[{"Lx", ",", "Ly"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pos", "=", 
   RowBox[{"{", 
    RowBox[{"35", ",", "60"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coin", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"HaarRandomState", "[", "4", "]"}], "//", "Normalize"}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{"BuildShiftOperators", "[", 
    RowBox[{"grid", ",", 
     RowBox[{"CoinDimension", "\[Rule]", "4"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "=", 
   RowBox[{"RandomMatrix", "[", "\"\<oo\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"evolutionOp", "=", 
    RowBox[{"QWEvolutionOperator", "[", 
     RowBox[{"grid", ",", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"c", "//", "N"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Tmax", "=", "9000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"initialState", "=", 
   RowBox[{"LocalizedState", "[", 
    RowBox[{"grid", ",", "pos", ",", "coin"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"distribution", "=", 
   RowBox[{"LimitDistribution", "[", 
    RowBox[{"grid", ",", "evolutionOp", ",", "initialState", ",", "Tmax"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"DiscreteProbabilityPlot", "[", 
  RowBox[{"grid", ",", "distribution"}], "]"}]}], "Input",
 CellChangeTimes->{{3.999481880726267*^9, 3.999482141580366*^9}, 
   3.999482411893633*^9, {3.9999491909812307`*^9, 3.999949245548671*^9}, {
