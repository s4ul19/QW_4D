       RowBox[{
        RowBox[{"result", "=", 
         RowBox[{"EigenstateAtEnergy", "[", 
          RowBox[{
           RowBox[{"candidatos", "[", 
            RowBox[{"[", "#", "]"}], "]"}], ",", "eigenvals", ",", 
           "eigenvecs"}], "]"}]}], ";", "\n", 
        RowBox[{"DiscreteProbabilityPlot", "[", 
