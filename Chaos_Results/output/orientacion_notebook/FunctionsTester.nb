Cell[CellGroupData[{

Cell["Cancelar un trabajo, si lo necesitas", "Section",ExpressionUUID->"940bc1eb-dd38-410e-898a-8997bb15d95e"],

Cell["\<\
Abortar una celda de la Mac no detiene un trabajo independiente. Para \
solicitar cancelar \[UAcute]nicamente el cuarto trabajo, eval\[UAcute]a \
CancelNodeJob[jobs[[4]]] en una celda nueva y consulta despu\[EAcute]s su \
estado. Los archivos que ya se guardaron se conservan.\
\>", "Text",ExpressionUUID->"514ae0f4-3896-425b-95df-ebf3ae650ed0"]
}, Open  ]]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Misma moneda, diferente tama\[NTilde]o", "Title",
 CellChangeTimes->{{4.000062033200767*^9, 
  4.000062040960843*^9}},ExpressionUUID->"a2306d5a-729f-4e14-9c67-\
1bd712f26e5e"],

Cell[CellGroupData[{

Cell["Rectangulo", "Chapter",
 CellChangeTimes->{{4.0001300051486683`*^9, 
  4.000130007950721*^9}},ExpressionUUID->"eca79400-b972-46fa-9eb2-\
2252e2a24730"],

Cell[CellGroupData[{

Cell[" Preparar los datos y la funci\[OAcute]n", "Section",
 CellChangeTimes->{{4.0000524848677397`*^9, 
  4.000052485791286*^9}},ExpressionUUID->"7c75a29a-d129-48eb-acb0-\
c6bcacb8443e"],

Cell["\<\
Estos tama\[NTilde]os y cantidades son un ejemplo para 235 monedas. Puedes \
conservar los valores y funciones que ya definiste en FunctionsTester.nb. \
PrepararQuantumWalks carga las dependencias en cada trabajador remoto.\
\>", "Text",ExpressionUUID->"addd8e64-3e01-44ed-8b0d-54b688ffab3e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Una", " ", "\[UAcute]nica", " ", "moneda", " ", "para", " ", "todos", " ",
     "los", " ", "tama\[NTilde]os"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "115", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"monedaFija", "=", 
     RowBox[{"N", "[", 
      RowBox[{"RandomMatrix", "[", "\"\<b\>\"", "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tamanos", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"35", ",", "25"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"34", ",", "25"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"34", ",", "24"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"36", ",", "25"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"36", ",", "26"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"35", ",", "24"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"35", ",", "26"}], "}"}]}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"crearGeometria", "=", 
     RowBox[{"Function", "[", 
      RowBox[{"tamano", ",", 
       RowBox[{"GenerateRectangleBasis", "@@", "tamano"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"prepararQuantumWalks", "=", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"path", "=", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Replace", "[", 
              RowBox[{
               RowBox[{"Environment", "[", "\"\<QW_PROJECT_ROOT\>\"", "]"}], ",", 
               RowBox[{
                RowBox[{"Except", "[", "_String", "]"}], "\[RuleDelayed]", 
                RowBox[{"FileNameJoin", "[", 
                 RowBox[{"{", 
                  RowBox[{"$HomeDirectory", ",", "\"\<QW\>\""}], "}"}], 
                 "]"}]}]}], "]"}], ",", "\"\<JA_libs\>\"", 
             ",", "\"\<QuantumWalks\>\""}], "}"}], "]"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"PacletDirectoryLoad", "[", "path", "]"}], ";", 
         RowBox[{"Needs", "[", "\"\<ForScience`\>\"", "]"}], ";", 
         RowBox[{"Block", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"FormatUsage", "=", "Identity"}], "}"}], ",", 
           RowBox[{"Needs", "[", "\"\<QuantumWalks`\>\"", "]"}]}], "]"}], ";", 
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"DownValues", "[", "GenerateRectangleBasis", "]"}], "]"}], 
          ">", "0"}]}]}], "]"}], "&"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "With", " ", "incorpora", " ", "la", " ", "moneda", " ", "y", " ", "el", " ",
      "constructor", " ", "a", " ", "la", " ", "funci\[OAcute]n", " ", 
     "remota"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"calcularPorTamano", "=", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"moneda", "=", "monedaFija"}], ",", 
         RowBox[{"construir", "=", "crearGeometria"}]}], "}"}], ",", 
       RowBox[{"Function", "[", 
        RowBox[{"tamano", ",", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"grid", ",", "dim", ",", "s", ",", "u", ",", "valores"}], 
            "}"}], ",", 
           RowBox[{
            RowBox[{"grid", "=", 
             RowBox[{"construir", "[", "tamano", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"dim", "=", 
             RowBox[{"grid", "[", "\"\<Dimension\>\"", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"s", "=", 
             RowBox[{"BuildShiftOperators", "[", 
              RowBox[{"grid", ",", 
               RowBox[{"CoinDimension", "->", "4"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"u", "=", 
             RowBox[{"s", ".", 
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{
                RowBox[{"IdentityMatrix", "[", 
                 RowBox[{"dim", ",", "SparseArray"}], "]"}], ",", 
                RowBox[{"SparseArray", "[", "moneda", "]"}]}], "]"}]}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"valores", "=", 
             RowBox[{"Eigenvalues", "[", 
              RowBox[{"Normal", "[", "u", "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Tamano\>\"", "->", "tamano"}], ",", 
              RowBox[{"\"\<DimensionMatriz\>\"", "->", 
               RowBox[{"4", " ", "dim"}]}], ",", 
              RowBox[{"\"\<ValoresPropios\>\"", "->", "valores"}]}], 
             "|>"}]}]}], "]"}]}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trabajos", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<nodo1\>\"", ",", "1", ",", 
         RowBox[{"tamanos", "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", "2"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<nodo2\>\"", ",", "1", ",", 
         RowBox[{"tamanos", "[", 
          RowBox[{"[", 
           RowBox[{"3", ";;", "4"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<nodo3\>\"", ",", "1", ",", 
         RowBox[{"tamanos", "[", 
          RowBox[{"[", 
           RowBox[{"5", ";;", "6"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<nodo4\>\"", ",", "1", ",", 
         RowBox[{"{", 
          RowBox[{"tamanos", "[", 
           RowBox[{"[", "7", "]"}], "]"}], "}"}]}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\n"}]}]], "Input",
 CellChangeTimes->{{4.0000547151829453`*^9, 4.000054716375059*^9}, {
  4.000059615440139*^9, 4.000059615730855*^9}, {4.000062083682863*^9, 
  4.000062111867709*^9}, {4.000062201493174*^9, 4.000062287776129*^9}, {
  4.0000623377678833`*^9, 4.000062338039393*^9}, {4.000062403424386*^9, 
  4.000062429032867*^9}},
 CellLabel->
  "In[106]:=",ExpressionUUID->"81078340-88f6-43b3-8284-25d6dffa9815"]
}, Closed]],

Cell[CellGroupData[{

Cell["3. Enviar los cuatro trabajos", "Section",ExpressionUUID->"9e8107b3-9c92-4145-aa20-87dabc09e120"],

Cell["\<\
La celda termina cuando los nodos aceptan los trabajos. Despu\[EAcute]s \
puedes usar o cerrar la Mac. No vuelvas a ejecutar esta celda para consultar \
el avance: cada env\[IAcute]o crea un trabajo nuevo.\
\>", "Text",ExpressionUUID->"11efdeb7-3c51-4920-ba0e-852f35d53cf1"],

