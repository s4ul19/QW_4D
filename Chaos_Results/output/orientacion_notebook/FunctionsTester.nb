Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"totalPr", "=", 
    RowBox[{"Flatten", "[", "prDat", "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"corteR", "=", 
    RowBox[{
     RowBox[{"HistogramList", "[", 
      RowBox[{
      "totalPr", ",", "\"\<FreedmanDiaconis\>\"", ",", "\"\<PDF\>\""}], "]"}],
      "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rFiltrado", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"totalPr", ",", 
     RowBox[{
      RowBox[{"#", ">=", "corteR"}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fraccionExcluidaR", "=", 
    RowBox[{"N", "[", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"Length", "[", "rFiltrado", "]"}], "/", 
       RowBox[{"Length", "[", "totalPr", "]"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"ImgPrFiltrado", "=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "dataStyle", ",", "styles", ",", "histograma", ",", "curvas", ",", "r"}],
      "}"}], ",", 
    RowBox[{
     RowBox[{"dataStyle", "=", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"GrayLevel", "[", "0.7", "]"}], ",", 
        RowBox[{"Opacity", "[", "0.6", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"styles", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", "Dashed", ",", "Thick"}], "]"}], ",", 
        RowBox[{"Directive", "[", 
         RowBox[{"Blue", ",", "Thick"}], "]"}], ",", 
        RowBox[{"Directive", "[", 
         RowBox[{"Red", ",", "Thick"}], "]"}], ",", 
        RowBox[{"Directive", "[", 
         RowBox[{"Purple", ",", "Thick"}], "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"histograma", "=", 
      RowBox[{"Histogram", "[", 
       RowBox[{
       "rFiltrado", ",", "\"\<FreedmanDiaconis\>\"", ",", "\"\<PDF\>\"", ",", 
        
        RowBox[{"ChartStyle", "->", "dataStyle"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"curvas", "=", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "/", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", "r"}], ")"}], "^", "2"}]}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"27", "/", "4"}], ")"}], " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"r", "+", 
              RowBox[{"r", "^", "2"}]}], ")"}], "/", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "+", "r", "+", 
               RowBox[{"r", "^", "2"}]}], ")"}], "^", 
             RowBox[{"(", 
              RowBox[{"5", "/", "2"}], ")"}]}]}]}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"81", " ", 
             RowBox[{
              RowBox[{"Sqrt", "[", "3", "]"}], "/", 
              RowBox[{"(", 
               RowBox[{"2", " ", "Pi"}], ")"}]}]}], ")"}], " ", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"r", "+", 
               RowBox[{"r", "^", "2"}]}], ")"}], "^", "2"}], "/", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "+", "r", "+", 
               RowBox[{"r", "^", "2"}]}], ")"}], "^", "4"}]}]}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"729", " ", 
             RowBox[{
              RowBox[{"Sqrt", "[", "3", "]"}], "/", 
              RowBox[{"(", 
               RowBox[{"2", " ", "Pi"}], ")"}]}]}], ")"}], " ", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"r", "+", 
               RowBox[{"r", "^", "2"}]}], ")"}], "^", "4"}], "/", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "+", "r", "+", 
               RowBox[{"r", "^", "2"}]}], ")"}], "^", "7"}]}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"PlotStyle", "->", "styles"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Legended", "[", 
      RowBox[{
       RowBox[{"Show", "[", 
        RowBox[{"histograma", ",", "curvas", ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"Axes", "->", "False"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           
           RowBox[{"\"\<r restringido\>\"", 
            ",", "\"\<P(r | r >= corte)\>\""}], "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<Primer bin excluido: \>\"", ",", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"100", " ", "fraccionExcluidaR"}], ",", 
               RowBox[{"{", 
                RowBox[{"5", ",", "2"}], "}"}]}], "]"}], ",", "\"\<%\>\""}], 
            "}"}], "]"}]}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}], ",", "All"}], "}"}]}], ",", 
         RowBox[{"ImageSize", "->", "Large"}], ",", 
         RowBox[{"LabelStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"Bold", ",", "17"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"Column", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"SwatchLegend", "[", 
             RowBox[{
              RowBox[{"{", "dataStyle", "}"}], ",", 
              RowBox[{"{", "\"\<Datos filtrados\>\"", "}"}]}], "]"}], ",", 
            RowBox[{"LineLegend", "[", 
             RowBox[{"styles", ",", 
              RowBox[{"{", 
               
               RowBox[{"\"\<Poisson\>\"", ",", "\"\<GOE/COE\>\"", 
                ",", "\"\<GUE/CUE\>\"", ",", "\"\<GSE/CSE\>\""}], "}"}]}], 
             "]"}]}], "}"}], "]"}], ",", "Right"}], "]"}]}], "]"}]}]}], 
   "]"}]}]}], "Input",
