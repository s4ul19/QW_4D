Cell[BoxData[{
 RowBox[{
  RowBox[{"phasesDat", "=", 
   RowBox[{"phasesDat", "=", 
    RowBox[{"Arg", "/@", "espectros"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SFFDat", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"QWSFF", "[", 
      RowBox[{"#", ",", 
       RowBox[{"ReturnData", "->", "True"}]}], "]"}], "&"}], "/@", 
    "phasesDat"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.99977917932071*^9, 3.9997792500130043`*^9}, {
  3.999779333381106*^9, 3.99977939250109*^9}, {3.999779442614493*^9, 
