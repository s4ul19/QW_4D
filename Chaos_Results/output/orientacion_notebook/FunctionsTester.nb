 RowBox[{
  RowBox[{"SFFDat", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"QWSFF", "[", 
      RowBox[{"#", ",", 
       RowBox[{"ReturnData", "->", "True"}]}], "]"}], "&"}], "/@", 
