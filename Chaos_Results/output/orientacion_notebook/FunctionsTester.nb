Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"phasesDat", "=", 
    RowBox[{"Arg", "/@", "espectros"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tauMax", "=", "2."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nReferencia", "=", 
   RowBox[{"Min", "[", 
    RowBox[{"Length", "/@", "phasesDat"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tauComun", "=", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"Floor", "[", 
        RowBox[{"tauMax", " ", "nReferencia"}], "]"}], "]"}], "/", 
      "nReferencia"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SFFDat", "=", 
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{"fases", ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"desplegado", ",", "niveles", ",", "k"}], "}"}], ",", 
        RowBox[{
         RowBox[{"desplegado", "=", 
          RowBox[{"UnfoldCircular", "[", "fases", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"AssociationQ", "[", "desplegado", "]"}]}], ",", 
           RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"niveles", "=", 
          RowBox[{"N", "[", 
           RowBox[{"desplegado", "[", "\"\<UnfoldedLevels\>\"", "]"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"k", "=", 
          RowBox[{"CompileSFF", "[", 
           RowBox[{"niveles", ",", "tauComun"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Raw\>\"", "->", 
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"tauComun", ",", "k"}], "}"}], "]"}]}], ",", 
           RowBox[{"\"\<RMT\>\"", "->", 
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"tauComun", ",", 
               RowBox[{"SpectralFormFactorRMT", "[", 
                RowBox[{"tauComun", ",", "1"}], "]"}]}], "}"}], "]"}]}]}], 
          "|>"}]}]}], "]"}]}], "]"}], "/@", "phasesDat"}]}], ";"}]}], "Input",\

 CellChangeTimes->{{3.99977917932071*^9, 3.9997792500130043`*^9}, {
  3.999779333381106*^9, 3.99977939250109*^9}, {3.999779442614493*^9, 
